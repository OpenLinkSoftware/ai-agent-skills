# .gitattributes — enforce LF line endings and prevent GitHub CRLF normalization
# See: https://help.github.com/articles/dealing-with-line-endings/
# and: https://help.github.com/articles/configuring-git-to-handle-line-endings/

# Normalize all text files to LF in the repository
* text=auto eol=lf

# --- Normalize by file type ---
# Source / data / markup formats
*.ttl        text eol=lf
*.rdf        text eol=lf
*.jsonld     text eol=lf
*.json       text eol=lf
*.nt         text eol=lf
