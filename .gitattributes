LICENSE      text eol=lf
README*      text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# --- Vendored / third-party dependency trees ---
# GitHub only normalizes on commit; these vendored trees are not ours to
# reflow and may legitimately carry mixed EOLs. Keep them binary/verbatim.
rdf-infographic-skill/scripts/node_modules/** -text
**/node_modules/** -text

