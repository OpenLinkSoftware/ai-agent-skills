@prefix : <#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:CreativeWork ;
    schema:about :memoryShapes ;
    schema:name "Agent RDF Memory SHACL shapes"@en ;
    schema:description "SHACL shapes for the agent-rdf-memory store: session document entities, index list items, and HowTo steps. Checked by scripts/validate-memory-shapes.py using pyshacl."@en ;
    schema:dateCreated "2026-10-08T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-10-08T00:00:00Z"^^xsd:dateTime .

:memoryShapes a schema:DefinedTerm ;
    schema:name "Agent RDF Memory shapes"@en .

# Session files: the self-describing document entity (CreativeWork with schema:about,
# per AGENTS.md "Self-describing document entity") must carry dated metadata.
:SessionDocumentShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :shapePrefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?this a schema:CreativeWork ; schema:about ?primary .
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "schema:dateModified must not be earlier than schema:dateCreated"@en ;
        sh:prefixes :shapePrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this schema:dateCreated ?c ; schema:dateModified ?m .
                FILTER (?m < ?c)
            }
        """
    ] ;
    sh:property [
        sh:path schema:dateCreated ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Document entity needs exactly one xsd:dateTime schema:dateCreated"@en
    ] ,
    [
        sh:path schema:dateModified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Document entity needs exactly one xsd:dateTime schema:dateModified"@en
    ] .

:shapePrefixes sh:declare [ sh:prefix "schema" ; sh:namespace "http://schema.org/"^^xsd:anyURI ] .

# Index entries: every schema:ListItem needs an integer position and an item link.
:IndexListItemShape a sh:NodeShape ;
    sh:targetClass schema:ListItem ;
    sh:property [
        sh:path schema:position ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "ListItem needs one integer schema:position"@en
    ] ,
    [
        sh:path schema:item ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "ListItem needs a schema:item IRI"@en
    ] .

# HowTo steps: integer position, and language-tagged name and text.
:HowToStepShape a sh:NodeShape ;
    sh:targetClass schema:HowToStep ;
    sh:property [
        sh:path schema:position ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "HowToStep needs one integer schema:position"@en
    ] ,
    [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "HowToStep needs a language-tagged schema:name"@en
    ] ,
    [
        sh:path schema:text ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "HowToStep needs a language-tagged schema:text"@en
    ] .
