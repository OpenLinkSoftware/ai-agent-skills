# ── Step 215: remote removals try HTTP, then WebDAV, then iSQL, with the P12 credentials pattern ──

:step-remoteRemovalOrder a schema:HowToStep ;
    schema:position 215 ;
    schema:name "BLOCKING GATE — remote removals try HTTP DELETE first, then WebDAV, then iSQL; all three use the principal PKCS#12 file path and /tmp/uyi passphrase, never a TMPDIR PEM extract"@en ;
    schema:text "2026-08-18: after URIBurner daas uploads of grok-bot-fourth-moment-of-ai-grok_4_6-1.md and .jsonld, HTTP DELETE on :5443 with --cert-type P12 --cert {principal-p12} --pass $MTLS_PKCS12_PW returned 204; sql:DAV_DELETE and PEM-in-TMPDIR curl were the wrong first moves. Verify the user-named public URL, slash variants, :5443 GET, and the folder listing before claiming the remote object is gone. Full procedure in howto/remote-resource-removal.ttl."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/remote-resource-removal.ttl>,
        <howto/remote-webdav-upload.ttl>,
        <howto/no-unauthorized-deletion.ttl>,
        <howto/p12-passphrase-retrieval.ttl>,
        <howto/credential-location-session-start.ttl> .

:step-remoteUploadOrder a schema:HowToStep ;
    schema:position 216 ;
    schema:name "BLOCKING GATE — remote uploads try HTTP PUT first, then WebDAV, then iSQL; same principal PKCS#12 file path and /tmp/uyi passphrase as removals, never a TMPDIR PEM extract"@en ;
    schema:text "2026-08-18: user presumed the HTTP/WebDAV/iSQL order and credentials pattern also cover uploads. They do now. First attempt is HTTP PUT to https://linkeddata.uriburner.com:5443{dav-path} with --cert-type P12 --cert {principal-p12} --pass $MTLS_PKCS12_PW. Port 443 PUT returns 401 because that listener does not consume the client cert. Verify :5443 GET and the public 443 GET separately — a :5443 200 plus a 443 401 means the file is stored but not anonymously readable. Procedure: howto/remote-webdav-upload.ttl."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/remote-webdav-upload.ttl>,
        <howto/remote-resource-removal.ttl>,
        :step-remoteRemovalOrder,
        <howto/p12-passphrase-retrieval.ttl>,
        <howto/credential-location-session-start.ttl> .

:topicRemoteResourceRemoval a schema:Thing ;
    schema:name "Remote Resource Removal Order"@en ;
    schema:description "When the user names a remote DAV/HTTP object to remove, attempt HTTP DELETE, then WebDAV, then iSQL, using the principal PKCS#12 at the credentials-file location. Do not claim success from a single :5443 404."@en ;
    rdfs:seeAlso <howto/remote-resource-removal.ttl> .

