# ── Step 224: PKCS#12 passphrase resolves from macOS Keychain first, /tmp/uyi as fallback ──

:step-p12PassphraseKeychainFirst a schema:HowToStep ;
    schema:position 224 ;
    schema:name "Resolve the principal PKCS#12 passphrase from the macOS Keychain item uriburner-p12 FIRST, falling back to the /tmp/uyi first KEY=VALUE, then eliciting — and guard any keychain read the agent did not create with perl alarm, since `timeout` does not exist on stock macOS"@en ;
    schema:text "2026-08-18: agent observed /tmp/uyi is mode -rw-r--r-- — a live credential in world-readable plaintext in a shared directory — and verified via a throwaway probe item that a keychain entry created with -T /usr/bin/security reads back non-interactively; the user approved making keychain primary." ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerBehaviorGapIdentified ;
