        :step-webdavWeblogEngineGate .

# ── 8. Virtuoso & SPARQL ────────────────────────────────────────────────────

:howto-virtuoso-sparql a schema:HowTo ;
    schema:name "Virtuoso & SPARQL"@en ;
    schema:description "Virtuoso SPARQL URL format parameters by query type, workbench query deduplication via named graphs, and SPARQL absolute PREFIX IRI rules."@en ;
    rdfs:seeAlso <howto/virtuoso-sparql-formats.ttl>,
        <howto/virtuoso-workbench-query-dedup.ttl> ;
    schema:step :step-virtuosoSparqlFormats,
        :step-virtuosoWorkbenchQueryDedup .

# ── 9. Terminology & Conventions ────────────────────────────────────────────

:howto-terminology a schema:HowTo ;
    schema:name "Terminology & Conventions"@en ;
    schema:description "Mashup vs meshup terminology, acronym expansion on first use, and other terminological conventions."@en ;
    rdfs:seeAlso <howto/artifact-routing.ttl>,
        <howto/rdf-document-authoring.ttl>,
        <howto/acronym-expansion.ttl> ;
    schema:step :step-mashupVsMeshup,
        :step-expandFirstUse .

# ── 10. ActivityPub & Fediverse Protocol ────────────────────────────────────

:topic-activitypub a schema:Thing ;
    schema:name "ActivityPub & Fediverse Protocol"@en ;
    schema:description "ActivityPub protocol compliance rules for Fediverse CRUD operations: actor document endpoint sourcing, WebFinger resolution, content negotiation, and server-to-server delivery verification."@en .

:howto-activitypub a schema:HowTo ;
    schema:name "ActivityPub & Fediverse Protocol"@en ;
    schema:description "Protocol-level gates for ActivityPub and Fediverse operations: all endpoint URLs must be sourced from the actor document, never guessed by convention."@en ;
    rdfs:seeAlso <howto/activitypub-actor-document-gate.ttl> ;
    schema:step :step-activitypubActorDocumentGate .

# ── 11. Destructive Command Guard ──────────────────────────────────────────

:topic-destructive-command-guard a schema:Thing ;
    schema:name "Destructive Command Guard"@en ;
    schema:description "Blocking patterns for dangerous shell commands: force pushes, recursive deletes, fork bombs, disk wipes, pipe-to-shell, and other irreversible operations."@en .

:howto-destructive-command-guard a schema:HowTo ;
    schema:name "Destructive Command Guard"@en ;
    schema:description "Standing rule: never execute destructive shell commands. Covers git force operations, recursive deletion, filesystem wipes, fork bombs, and pipe-to-shell patterns."@en ;
    rdfs:seeAlso <howto/destructive-command-guard.ttl> ;
    schema:step :step-destructiveCommandGuard .

# ═══════════════════════════════════════════════════════════════════════════
# ── Step Definitions (referenced by sub-HowTos above) ────────────────────
# ═══════════════════════════════════════════════════════════════════════════

# ── Identity, WebID & Delegation ────────────────────────────────────────────

# ── Step 1: Seek Approval ────────────────────────────────────────────────────

:step-approval a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Seek approval before acting unless told otherwise"@en ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 2: Output Directory Routing ─────────────────────────────────────────

:step-outputDirs a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Route artifacts to model-specific output directories under the canonical LLM root"@en ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

:step-gpt5ChatCodexOutputDirs a schema:HowToStep ;
    schema:position 3 ;
    schema:name "GPT-5 Chat Codex writes generated collections to GPT5-Chat-Generated root folders"@en ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 2.2: Terminology — Mashup vs Meshup ─────────────────────────────────

:step-mashupVsMeshup a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Never use 'mashup' — always use 'meshup' for semantic content fusion, on input and output"@en ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 2.3: Model Identity Pre-Flight Gate ─────────────────────────────────

:step-modelIdentityPreflight a schema:HowToStep ;
    schema:position 5 ;
    schema:name "BLOCKING GATE — resolve output root from system prompt model ID before any file write"@en ;
    schema:text "No file write is permitted until the output root has been resolved from the system prompt model identifier at session initialization."@en ;
    onto:hasTrigger onto:triggerSessionStart, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

:topicModelIdentityPreflight a schema:Thing ;
    schema:name "Model Identity Pre-Flight Gate"@en ;
    schema:description "Session-initialization determination of the output root folder, using model identity as primary input. All artifacts use this consistent root — never re-derived mid-session."@en .

# ── Step 3: Skill Chain ──────────────────────────────────────────────────────

:step-skillChain a schema:HowToStep ;
    schema:position 6 ;
    schema:name "Use kg-generator → rdf-infographic-skill chain for RDF/MD/HTML collections"@en ;
    rdfs:seeAlso <howto/skill-invocation.ttl> .

# ── Step 3a: KG Query Mode ───────────────────────────────────────────────────

:step-kgQueryMode a schema:HowToStep ;
    schema:position 7 ;
    schema:name "Answer questions from skills/KG first — ask before falling back to model knowledge"@en ;
    rdfs:seeAlso <howto/skill-invocation.ttl> .

# ── Step 3b: SPARQL Endpoint Search Order Override ────────────────────────────

:step-sparqlEndpointSearchOrder a schema:HowToStep ;
    schema:position 131 ;
    schema:name "When user signals KG-only mode or names URIBurner, skip local search and query the SPARQL endpoint first"@en ;
    schema:text "The data-twingler skill defaults to local-first search (Step 0). When the user says 'KG-only mode', 'use URIBurner', 'query the endpoint', or otherwise signals they want live SPARQL results, skip the local vector search entirely and proceed directly to Graph IRI Discovery on the default endpoint. Also: when the first local search pass returns zero matches, pivot to the endpoint immediately — do not repeat local search with variant terms."@en ;
    onto:hasTrigger onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/skill-invocation.ttl> .

# ── Step 4: Entity Denotation ────────────────────────────────────────────────
# UNTOUCHED — already has rdfs:seeAlso to canonical-entity-iri-denotation.ttl

:step-entityDenotation a schema:HowToStep ;
    schema:position 8 ;
    schema:name "Assign canonical entity IRIs per denotation rulesets"@en ;
    schema:text "Assign canonical entity IRIs following the priority ladder in the referenced howto files."@en ;
    rdfs:seeAlso <howto/canonical-entity-iri-denotation.ttl>,
        <howto/entity-iri-denotation-mechanics.ttl>,
        <howto/canonical-iri-compliance-gate.ttl> .

# ── Step 5: Memory Protocol ──────────────────────────────────────────────────

:step-memoryProtocol a schema:HowToStep ;
    schema:position 9 ;
    schema:name "Read agent-rdf-memory/ before tasks, write immediately on trigger events"@en ;
    onto:hasTrigger
        onto:triggerPreferencesUpdate ,
        onto:triggerSkillInvocation ,
        onto:triggerNamedWorkflow ,
        onto:triggerBehaviorGapIdentified ,
        onto:triggerTopicChange ,
        onto:triggerSessionEnd ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 6: Git Workflow ─────────────────────────────────────────────────────

:step-gitWorkflow a schema:HowToStep ;
    schema:position 10 ;
    schema:name "Commit and push only when explicitly asked"@en ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 7: Footer Attribution ───────────────────────────────────────────────

:step-attribution a schema:HowToStep ;
    schema:position 11 ;
    schema:name "Use <p> prose format for footer attribution, never chip <div>"@en ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

# ── Step 8: ZIP Repackage ────────────────────────────────────────────────────

:step-zipRepackage a schema:HowToStep ;
    schema:position 12 ;
    schema:name "Delete ZIP before recreating — zip -r on existing archive does not remove deleted files"@en ;
    rdfs:seeAlso <howto/skill-invocation.ttl> .

# ── Step 9: Dark Mode CSS ────────────────────────────────────────────────────

:step-darkModeCSS a schema:HowToStep ;
    schema:position 13 ;
    schema:name "Dark mode: two-block CSS, link contrast, general a rule, bright accent"@en ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

# ── Step 10: KG Explorer Template Reuse ──────────────────────────────────────

:step-kgExplorerReuse a schema:HowToStep ;
    schema:position 14 ;
    schema:name "Reuse the validated template for KG Explorer — never regenerate from scratch"@en ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

# ── Step 10.05: Template Selection by Content Type ───────────────────────────

:step-templateSelection a schema:HowToStep ;
    schema:position 15 ;
    schema:name "Select the correct template from assets/templates/ based on content type"@en ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

# ── Step 10.1: KG Explorer — Nav placement ───────────────────────────────────

:step-kgNavPlacement a schema:HowToStep ;
    schema:position 16 ;
    schema:name "Float nav must be top-LEFT; KG Explorer Controls button is always top-RIGHT"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 10.2: KG Explorer — Float nav starts collapsed ──────────────────────

:step-kgNavCollapsed a schema:HowToStep ;
    schema:position 17 ;
    schema:name "Float nav must start COLLAPSED per rdf-infographic-skill contract"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 10.3: KG Explorer — Controls as master reset ────────────────────────

:step-kgControlsMasterClose a schema:HowToStep ;
    schema:position 18 ;
    schema:name "toggleToolbar() must be a master reset — close all child panels when collapsing the tray"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 10.4: KG Explorer — No orphan nodes ─────────────────────────────────

:step-kgNoOrphans a schema:HowToStep ;
    schema:position 19 ;
    schema:name "getFilteredData() must restrict nodes to those appearing in at least one active link"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 10.5: KG Explorer — Toolbar group labels ────────────────────────────

:step-kgToolbarGroups a schema:HowToStep ;
    schema:position 20 ;
    schema:name "Wrap toolbar controls in .tb-group + .tb-label for visual hierarchy"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 10.6: KG Explorer — Settings panel UX ───────────────────────────────

:step-kgSettingsPanel a schema:HowToStep ;
    schema:position 21 ;
    schema:name "Settings panel: slider cards with live value readouts, predicate grid, state-reflecting gear button"@en ;
    rdfs:seeAlso <howto/kg-explorer-ui-patterns.ttl> .

# ── Step 11: Harness Validator ID Conventions ────────────────────────────────

:step-harnessIds a schema:HowToStep ;
    schema:position 22 ;
    schema:name "Match exact HTML IDs and attributes expected by the harness validator"@en ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

# ── Step 12: Footer Attribution Label Casing ─────────────────────────────────

:step-footerLabels a schema:HowToStep ;
    schema:position 23 ;
    schema:name "Use exact lowercase label strings in footer attribution cards"@en ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

# ── Step 13: SPARQL Format Guidance Text ─────────────────────────────────────

:step-sparqlFormat a schema:HowToStep ;
    schema:position 24 ;
    schema:name "Include visible SPARQL result format guidance prose in HTML"@en ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

# ── Step 14: KG Compliance Script ERE Regex Bug ──────────────────────────────

:step-complianceBug a schema:HowToStep ;
    schema:position 25 ;
    schema:name "Work around macOS ERE regex bug in validate-kg-compliance.sh"@en ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

# ── Step 15: KG Explorer Simulation Lifecycle ────────────────────────────────

:step-simulationLifecycle a schema:HowToStep ;
    schema:position 26 ;
    schema:name "Create D3 forceSimulation once and reuse it across renders"@en ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

# ── Step 16: Click-Distance Guard ────────────────────────────────────────────

:step-clickGuard a schema:HowToStep ;
    schema:position 27 ;
    schema:name "Use a click-distance guard to distinguish drag from click"@en ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

# ── Step 17: kgData to IIFE Regex Constraint ─────────────────────────────────

:step-kgDataRegex a schema:HowToStep ;
    schema:position 28 ;
    schema:name "Place kgData immediately adjacent to the IIFE opening"@en ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

# ── Step 18: Document Entity Declaration ─────────────────────────────────────

:step-documentEntity a schema:HowToStep ;
    schema:position 29 ;
    schema:name "Declare the document entity in every TTL file using <>"@en ;
    rdfs:seeAlso <howto/rdf-document-authoring.ttl> .

# ── Step 19: Document Entity schema:about ────────────────────────────────────

:step-documentAbout a schema:HowToStep ;
    schema:position 30 ;
    schema:name "Use schema:about for the document entity"@en ;
    rdfs:seeAlso <howto/rdf-document-authoring.ttl> .

# ── Step 20: No Fabricated URLs ──────────────────────────────────────────────

:step-noFabricatedUrls a schema:HowToStep ;
    schema:position 31 ;
    schema:name "Never fabricate, guess, or hallucinate URLs"@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 21: Authenticated curl in Skill Workflows ───────────────────────────

:step-curlAuth a schema:HowToStep ;
    schema:position 32 ;
    schema:name "Read identity mode from session state to determine curl authentication — agent-only or delegation"@en ;
    schema:text """When constructing a curl command against a protected or identity-aware endpoint:

1. READ :session onto:identityMode from session TTL.
2. If :identityModeAgentOnly → use agent cert alone (no On-Behalf-Of header).
3. If :identityModeDelegation → use agent cert + On-Behalf-Of header with user's WebID.
4. If identity mode is unset → elicit from user which mode to use.

CRITICAL: Identity mode is established at session start via step-identityMode (position 143). Delegation corroboration does NOT automatically set delegation mode — it must be explicitly asserted by the user.

Certificate paths:
- Agent: {CREDENTIALS_ROOT}/Templates/YouID/link-in-bio-agent-credentials/cert.p12
- User (for delegation): {CREDENTIALS_ROOT}/Templates/YouID/link-in-bio-credentials-5/cert.p12"""@en ;
    rdfs:seeAlso <howto/session-governance.ttl>, <howto/identity-mode.ttl> .

# ── Step 22: Stripe Sandbox Card ─────────────────────────────────────────────

:step-stripeSandboxCard a schema:HowToStep ;
    schema:position 33 ;
    schema:name "Use Stripe sandbox card credentials for ACP test payments"@en ;
    rdfs:seeAlso <howto/agent-identity.ttl> .

# ── Step 23: Whoami Format ────────────────────────────────────────────────────

:step-whoamiFormat a schema:HowToStep ;
    schema:position 34 ;
    schema:name "Respond to identity queries: full two-section for 'whoami', agent-only section for 'who are you?'"@en ;
    schema:text "For 'whoami?' emit a full two-section User and Agent response; for 'who are you?' emit the Agent section only."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery ;
    rdfs:seeAlso <howto/agent-identity.ttl> .

# ── Step 23.1: WebID-TLS Verification ─────────────────────────────────────────

:step-webidTlsVerification a schema:HowToStep ;
    schema:position 35 ;
    schema:name "Verify WebID-TLS credentials — local first, remote fallback"@en ;
    schema:text "Verify WebID-TLS credentials by comparing RSA modulus from local cert against profile.ttl cert:modulus, falling back to ODS webid_verify.vsp only if local files are absent."@en ;
    rdfs:seeAlso <howto/agent-identity.ttl> .

# ── Step 24: Secret Redaction ────────────────────────────────────────────────

:step-secretRedaction a schema:HowToStep ;
    schema:position 36 ;
    schema:name "Redact passwords, API secrets, and credentials in all session memory, lessons, trace, and log documents"@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 25: Prompt Recording ─────────────────────────────────────────────────

:step-promptRecording a schema:HowToStep ;
    schema:position 37 ;
    schema:name "Record verbatim user prompts in session memory files for intent-to-outcome traceability"@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerNamedWorkflow, onto:triggerBehaviorGapIdentified, onto:triggerSessionEnd ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 26: Retrieval Tool Order ────────────────────────────────────────────

:step-retrievalToolOrder a schema:HowToStep ;
    schema:position 38 ;
    schema:name "Content retrieval tool order: Chrome MCP → Playwright → PinchTab → Sponger last resort"@en ;
    rdfs:seeAlso <howto/skill-invocation.ttl> .

# ── Step 27: Default Output Root ─────────────────────────────────────────────

:step-defaultOutputRoot a schema:HowToStep ;
    schema:position 39 ;
    schema:name "Default output root for HTML infographic artifacts — defer to model-specific routing"@en ;
    schema:text "There is no single default output root; always determine the output root from the active LLM identity per step-outputDirs — never hardcode a path."@en ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 27.1: Model Identity vs Agent Environment Tiebreaker ──────────────

:step-modelOverEnvironment a schema:HowToStep ;
    schema:position 40 ;
    schema:name "Model identity always wins over agent environment for output routing"@en ;
    schema:text "When model identity and agent environment differ, the system prompt model identifier determines the output path — never the agent environment name."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 27.2: No Prompt-Specified Model Override ───────────────────────────

:step-noPromptModelOverride a schema:HowToStep ;
    schema:position 41 ;
    schema:name "BLOCKING GATE — user-supplied filenames or roots cannot override active model identity"@en ;
    schema:text "A user-supplied model name in an output root, filename, or attribution label that conflicts with the active model identified by the system prompt must be treated as stale and normalized to the active model identity."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 27.3: Model Identity Resolution Chain ──────────────────────────────

:step-modelIdentityResolution a schema:HowToStep ;
    schema:position 42 ;
    schema:name "BLOCKING GATE — resolve model identity from three-source chain; never leave unresolved"@en ;
    schema:text "RESOLVE from (1) system prompt → (2) env vars (ANTHROPIC_MODEL, OPENAI_MODEL, etc.) → (3) elicit user. Never return 'unresolved' or guess from session context. Map to core.ttl output path once resolved."@en ;
    onto:hasTrigger onto:triggerSessionStart, onto:triggerWhoamiQuery, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/model-identity-resolution.ttl> .

# ── Topic Entities (schema:about targets for the container document) ─────────

:topicApprovalWorkflow a schema:Thing ;
    schema:name "Approval Workflow"@en ;
    schema:description "Process of seeking user approval before acting or modifying documents."@en .

:topicArtifactRouting a schema:Thing ;
    schema:name "Artifact Output Routing"@en ;
    schema:description "Rules for directing generated RDF, HTML, and Markdown artifacts to model-specific output directories."@en .

:topicSkillComposition a schema:Thing ;
    schema:name "Skill Chain Composition"@en ;
    schema:description "Patterns for invoking kg-generator, rdf-infographic-skill, and other skills in sequence with proper hand-off and gate compliance."@en .

:topicEntityResolution a schema:Thing ;
    schema:name "Entity IRI Resolution"@en ;
    schema:description "Priority rules for assigning IRIs to people, organizations, software, and countries using LinkedIn, DBpedia, Wikidata, and hash-based fallbacks."@en ;
    rdfs:seeAlso <howto/canonical-entity-iri-denotation.ttl>,
        <entities/people.ttl>, <entities/organizations.ttl>,
        <entities/tools.ttl>, <entities/concepts.ttl> .

:topicCanonicalEntityIriDenotation a schema:Thing ;
    schema:name "Canonical Entity IRI Denotation"@en ;
    schema:description "Expanded rules for canonical IRI assignment including the owl:sameAs vs schema:sameAs distinction (owl:sameAs connects entity IRIs with #this fragments; schema:sameAs connects an entity IRI to a document URL) and the prohibition on document-local IRIs when a canonical platform IRI is available."@en ;
    rdfs:seeAlso <howto/canonical-entity-iri-denotation.ttl> .

:topicEntityIriDenotationMechanics a schema:Thing ;
    schema:name "Entity IRI Denotation Mechanics"@en ;
    schema:description "Practical mechanical rules for entity IRI formation: fragment placement (append #this directly to canonical URI, never insert/remove trailing slash), LinkedIn www/non-www reconciliation via owl:sameAs, and owl:sameAs self-reference prohibition."@en ;
    rdfs:seeAlso <howto/entity-iri-denotation-mechanics.ttl> .

:topicMemoryManagement a schema:Thing ;
    schema:name "RDF Memory Management"@en ;
    schema:description "Protocol for reading and writing agent-rdf-memory files before and after tasks, including retrieval and storage rules."@en .

:topicVersionControl a schema:Thing ;
    schema:name "Git Workflow"@en ;
    schema:description "Rules for committing, pushing, amending, and repackaging skill ZIP bundles without side effects."@en .

:topicAttributionStyling a schema:Thing ;
    schema:name "Footer Attribution Styling"@en ;
    schema:description "HTML footer formatting rules, including <p> prose attribution, canonical homepage links, and exact label casing for validator compliance."@en .

:topicPackaging a schema:Thing ;
    schema:name "Skill Packaging"@en ;
    schema:description "ZIP bundle creation and repackaging rules, including deletion before recreation and .DS_Store exclusion."@en .

:topicThemeImplementation a schema:Thing ;
    schema:name "Theme Implementation"@en ;
    schema:description "Dark mode CSS requirements: separate blocks for explicit toggle and system preference (not comma-combined); general a { color: var(--accent) } rule so inline links don't fall through to browser-default blue; bright/saturated accent color for dark mode (e.g. #7dd3fc) — never muted indigo/blue that blends into dark backgrounds."@en .

:topicGraphVisualization a schema:Thing ;
    schema:name "Knowledge Graph Visualization"@en ;
    schema:description "KG Explorer patterns, including D3 simulation lifecycle, click-distance guard, zoom isolation, SVG resolver links, and template reuse."@en .

:topicContractValidation a schema:Thing ;
    schema:name "Harness Contract Validation"@en ;
    schema:description "Validator-specific requirements, including exact HTML IDs, footer label casing, SPARQL format guidance text, and macOS ERE regex workarounds."@en .

:topicNoFabricatedUrls a schema:Thing ;
    schema:name "No Fabricated URLs"@en ;
    schema:description "Absolute prohibition on fabricating, guessing, or hallucinating URLs of any kind. All URLs must be sourced verbatim, computed with tools, or constructed from validated patterns — otherwise omitted and the user asked."@en .

:topicCurlAuth a schema:Thing ;
    schema:name "Authenticated curl Usage"@en ;
    schema:description "Convention for optionally issuing curl commands with PKCS#12 or PEM client certificates and an On-Behalf-Of header — only after explicit user elicitation and confirmation that they apply — to assert a WebID principal."@en .

:topicStripeSandboxCard a schema:Thing ;
    schema:name "Stripe Sandbox Card"@en ;
    schema:description "Stripe test mode card credentials for ACP subscription payment validation."@en .

:topicWhoamiFormat a schema:Thing ;
    schema:name "Identity Query Response Format"@en ;
    schema:description "Two triggers: 'whoami?' → full two-section (User + Agent) with verified identity badges; 'who are you?' → agent-only section without badges. Agent section covers model, environment, artifact routing, memory store, and behavioral contract."@en .

:topicSecretRedaction a schema:Thing ;
    schema:name "Secret Redaction in Memory Documents"@en ;
    schema:description "Mandatory redaction of passwords and API secrets (to [REDACTED] form) in session memory .ttl, MD reports, traces, and logs for security."@en .

:topicPromptRecording a schema:Thing ;
    schema:name "Prompt Recording in Session Memory"@en ;
    schema:description "Mandatory recording of verbatim user prompts as onto:Prompt entities in session memory files, linked via prov:wasInformedBy, for intent-to-outcome traceability."@en .

:topicSemanticFidelity a schema:Thing ;
    schema:name "Semantic Fidelity Gate"@en ;
    schema:description "Five-step contract gate (in howto/semantic-fidelity-gates.ttl) preventing prior-task content contamination — ensures kgData payload and HTML body prose describe the same topic as the companion TTL."@en ;
    rdfs:seeAlso <howto/semantic-fidelity-gates.ttl> .

:topicOntologyDiscovery a schema:Thing ;
    schema:name "Shared Ontology Discovery via prefix.cc"@en ;
    schema:description "Four-step protocol (in howto/ontology-discovery.ttl) for discovering existing shared ontologies before inventing new RDF predicates: query prefix.cc, evaluate fitness, present suggestions for user acceptance/rejection, and apply accepted ontologies consistently. Promotes ontology reuse over ad-hoc vocabulary invention."@en ;
    rdfs:seeAlso <howto/ontology-discovery.ttl> .

:topicRetrievalToolOrder a schema:Thing ;
    schema:name "Content Retrieval Tool Order"@en ;
    schema:description "Mandatory retrieval tool priority: (1) Chrome MCP, (2) Playwright, (3) PinchTab, (4) Sponger only as absolute last resort after all others are tried and unavailable."@en .

:claudeCodeSettings a schema:PropertyValue ;
    schema:name "Claude Code Settings"@en ;
    schema:propertyID "contextThreshold" ;
    schema:value "500000"^^xsd:integer ;
    schema:description "Context threshold restored to 500k tokens on 2026-06-04 after prior session was compacted prematurely at a lower threshold."@en .

:topicKGExplorerReuseFirst a schema:Thing ;
    schema:name "KG Explorer Reuse-First Protocol"@en ;
    schema:description "Four-step protocol (in howto/kg-explorer-reuse-first.ttl) for constructing KG Explorer visualizations: search for the 3 most recent working implementations, validate candidates against contract, adapt the first passing shell to new kgData, and only build afresh as a last resort. Optimizes for token economy by reusing proven D3 patterns."@en ;
    rdfs:seeAlso <howto/kg-explorer-reuse-first.ttl> .

# ── Step 28: Virtuoso SPARQL URL Format Parameters ───────────────────────────

:step-virtuosoSparqlFormats a schema:HowToStep ;
    schema:position 42 ;
    schema:name "Use correct &format= parameter for each SPARQL query type on Virtuoso endpoints"@en ;
    schema:text "Use percent-encoded format=text%2Fx-html%2Btr for SELECT and format=text%2Fx-html-nice-turtle for CONSTRUCT/DESCRIBE — never swap the two."@en ;
    rdfs:seeAlso <howto/virtuoso-sparql-formats.ttl> .

:topicEntityTypeGate a schema:Thing ;
    schema:name "Entity, Property, and Type IRI Gate"@en ;
    schema:description "Every RDF entity must have the correct rdf:type for its semantic role. Every property and type IRI used must be a real term in its declared vocabulary — never fabricated or guessed. schema:HowToStep for HowTo steps, schema:Question for FAQ questions, schema:DefinedTerm for glossary terms, but also: never use schema:ceo (not a real schema.org property) or schema:ArticleSection (not a real schema.org type). Content-match alone is insufficient; the term must exist in the namespace. This applies during KG generation (entity creation), hyperlinking (linking HTML to entities), and property/type IRI authoring (any vocabulary use)."@en ;
    rdfs:seeAlso <howto/entity-type-gate.ttl> .

:topicVirtuosoSparqlFormats a schema:Thing ;
    schema:name "Virtuoso SPARQL URL Format Parameters"@en ;
    schema:description "Default &format= parameter values for SPARQL URLs targeting Virtuoso endpoints: SELECT → text/x-html+tr; CONSTRUCT/DESCRIBE → text/x-html-nice-turtle. Always percent-encode the value."@en ;
    rdfs:seeAlso <howto/virtuoso-sparql-formats.ttl> .

# ── Step 29: Entity, Property, and Type IRI Gate ──────────────────────────────

:step-entityTypeGate a schema:HowToStep ;
    schema:position 43 ;
    schema:name "Verify every entity type, property IRI, and type IRI against the declared vocabulary"@en ;
    schema:text "Before using any RDF type or property IRI, verify it exists in its declared vocabulary — never fabricate or assume schema:ceo, schema:ArticleSection, or similar terms."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/entity-type-gate.ttl> .

:topicExternalIriVerification a schema:Thing ;
    schema:name "External IRI Verification Gate"@en ;
    schema:description "Every external IRI (Wikidata, DBpedia, or any third-party namespace) used in RDF must be verified by dereferencing it and confirming the returned entity matches the referent. Fabricated or guessed external IRIs are prohibited — a prefix or Q-ID pattern alone is insufficient. Verification is done via curl against the IRI's content-negotiation endpoint (e.g. wikidata.org/wiki/Special:EntityData/{qid}.json) and inspecting the returned labels/descriptions."@en .

# ── Step 30: External IRI Verification Gate ────────────────────────────────────

:step-externalIriVerification a schema:HowToStep ;
    schema:position 44 ;
    schema:name "Verify every external IRI (Wikidata, DBpedia) by dereferencing before use"@en ;
    schema:text "Before adding any Wikidata or DBpedia IRI to RDF, dereference it to confirm the referent matches — never use an IRI that merely looks right without verification."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/external-iri-verification.ttl> .

:topicEntityLinkPlacement a schema:Thing ;
    schema:name "Entity Hyperlink Placement Gate"@en ;
    schema:description "Rules for placing entity-link hyperlinks in HTML infographics. Two selectable modes: Mode A (first-reference-only — link each entity at most once, on its first DOM occurrence) and Mode B (all references — link every occurrence of every entity). Mode is elicited from the user before applying links. The gate verifies the chosen mode is applied correctly and completely."@en ;
    rdfs:seeAlso <howto/entity-link-placement.ttl> .

# ── Step 31: Entity Hyperlink Placement Gate ──────────────────────────────────

:step-entityLinkPlacement a schema:HowToStep ;
    schema:position 45 ;
    schema:name "Elicit hyperlink mode, then verify entity-link placement in HTML"@en ;
    schema:text "Elicit hyperlink mode (Mode A: first-reference-only or Mode B: all references) before adding entity links, then apply consistently throughout the HTML."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/entity-link-placement.ttl> .

:topicCanonicalIriCompliance a schema:Thing ;
    schema:name "Canonical IRI Compliance Gate"@en ;
    schema:description "Post-generation audit that verifies every entity uses the highest-priority canonical platform IRI available — never a document-local IRI when DBpedia, Wikidata, LinkedIn, or other platform IRI exists. Covers audit procedure, priority ladder enforcement, cross-reference updates, exception approval, and HTML resolver URL sync."@en ;
    rdfs:seeAlso <howto/canonical-iri-compliance-gate.ttl> .

# ── Step 32: Canonical IRI Compliance Gate ───────────────────────────────────

:step-canonicalIriCompliance a schema:HowToStep ;
    schema:position 46 ;
    schema:name "Audit every entity for canonical IRI compliance after KG generation"@en ;
    schema:text "After generating RDF, audit every entity to ensure it uses the highest-priority canonical platform IRI (DBpedia, Wikidata, LinkedIn) rather than a document-local IRI."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/canonical-iri-compliance-gate.ttl> .

:topicConceptEntityHyperlinking a schema:Thing ;
    schema:name "Concept/Term Entity Hyperlinking Gate"@en ;
    schema:description "Rules for hyperlinking concept and term entities (schema:DefinedTerm, custom ontology classes, schema:Thing concepts) in HTML infographics. Analogous to the person and organization entity-linking rules but for abstract concepts like 'System of Intelligence', 'Agentic Client', 'Co-Design', 'Semantic Web', etc. Covers canonical IRI selection for concepts (standards-body → DBpedia → Wikidata → document-local), first-reference hyperlinking, and verification checklist."@en ;
    rdfs:seeAlso <howto/concept-entity-hyperlinking.ttl> .

# ── Step 33: Concept/Term Entity Hyperlinking Gate ─────────────────────────────

:step-conceptEntityHyperlinking a schema:HowToStep ;
    schema:position 47 ;
    schema:name "Hyperlink concept/term entities (DefinedTerm, custom ontology classes) in HTML on first reference"@en ;
    schema:text "Concept and term entities (schema:DefinedTerm, custom ontology classes) must be hyperlinked in HTML on first reference, using the same resolver pattern as person and organization entities."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/concept-entity-hyperlinking.ttl> .

# ── Step 34: Generated Artifact Placement ──────────────────────────────────────

:topicModelOverEnvironment a schema:Thing ;
    schema:name "Model Identity vs Agent Environment Tiebreaker"@en ;
    schema:description "Rule that model identity from the system prompt always takes precedence over the agent environment name for output routing. Claude Code and Codex Desktop are multi-model runtimes — the model determines the output path, not the environment."@en .

:topicArtifactPlacement a schema:Thing ;
    schema:name "Generated Artifact Placement"@en ;
    schema:description "Decision about where generated output artifacts (HTML, RDF, Markdown) should be placed relative to each other and to the source content. Locations depend on publication intent — they may share a folder or use dedicated subfolders (rdf/, webpages/, md/). Elicit user preference before assuming placement."@en .

:topicModelIdentityResolution a schema:Thing ;
    schema:name "Model Identity Resolution Chain"@en ;
    schema:description "Three-source blocking gate for resolving the active LLM model identity: (1) system prompt, (2) environment variables (ANTHROPIC_MODEL, OPENAI_MODEL, etc.), (3) elicit from user. Never guess from session context, never leave 'unresolved'. Feeds both artifact routing and whoami responses. Companion procedure in howto/model-identity-resolution.ttl."@en ;
    rdfs:seeAlso <howto/model-identity-resolution.ttl> .

:step-rdfInfographicGateEnforcement a schema:HowToStep ;
    schema:position 49 ;
    schema:name "Run validate-harness-contract.py before delivering any rdf-infographic-skill HTML artifact"@en ;
    schema:text "Before delivering any rdf-infographic-skill HTML artifact, run validate-harness-contract.py and achieve 0 failures — this is a blocking gate."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/rdf-infographic-compliance-gate.ttl> .

:topicRdfInfographicGate a schema:Thing ;
    schema:name "rdf-infographic-skill Harness Gate Enforcement"@en ;
    schema:description "Requirement to run validate-harness-contract.py and achieve 0 failures before delivering any rdf-infographic-skill HTML artifact. Added 2026-06-10 after edge-label and SPARQL button defects were delivered without gate execution."@en .

:step-artifactPlacement a schema:HowToStep ;
    schema:position 48 ;
    schema:name "Elicit user preference for generated file placement before writing outputs"@en ;
    schema:text "Before writing output files, elicit or look up the user's preferred placement layout for rdf/, webpages/, and md/ artifacts."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerPreferencesUpdate .

:step-opalSessionVocabulary a schema:HowToStep ;
    schema:position 50 ;
    schema:name "Use OPAL Analytics Ontology vocabulary as default in all session log TTL files"@en ;
    schema:text "All session memory TTL files must use OPAL Analytics Ontology vocabulary (opal:ChatSession, opal:ChatModel, opal:LLMProvider) as the primary vocabulary unless overridden by an operator."@en ;
    onto:hasTrigger onto:triggerSessionWrite ;
    rdfs:seeAlso <howto/opal-session-vocabulary.ttl> .

:topicOpalSessionVocabulary a schema:Thing ;
    schema:name "OPAL Analytics Ontology for Session Logs"@en ;
    schema:description "Standing requirement to use opal:ChatSession, opal:ChatModel, opal:LLMProvider, opal:ChatMessage and related OPAL properties in all session memory TTL files. Default unless overridden by operator. Ontology at {ONTOLOGY_ROOT}/OpenLink/opal-analytics-ontology-2.ttl"@en .

# ── Step 37: No Blank Nodes in RDF Output ─────────────────────────────────────

:step-noBlankNodes a schema:HowToStep ;
    schema:position 51 ;
    schema:name "Never use blank nodes in generated RDF Turtle — all resources must be named IRIs"@en ;
    schema:text "Never use blank nodes in generated RDF — all resources must be named IRIs; use comma-separated objects instead of collection syntax."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/rdf-document-authoring.ttl> .

:topicNoBlankNodes a schema:Thing ;
    schema:name "No Blank Nodes in RDF Output"@en ;
    schema:description "Absolute prohibition on blank nodes in generated RDF Turtle. All resources must be named IRIs. Collections use comma-separated objects, never Turtle (...) syntax or explicit blank node labels."@en .

# ── Step 38: Remote WebDAV Upload ─────────────────────────────────────────────

:step-remoteWebdavUpload a schema:HowToStep ;
    schema:position 52 ;
    schema:name "After generating artifacts, offer to upload to remote WebDAV (URIBurner default)"@en ;
    schema:text "After completing any artifact, offer to upload it to a remote WebDAV server (URIBurner DAV is the default). Uploads follow the same HTTP then WebDAV then iSQL order and principal PKCS#12 pattern as remote removals (Step 216)."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/remote-webdav-upload.ttl>,
        <howto/remote-resource-removal.ttl>,
        :step-remoteUploadOrder .

:topicRemoteWebdavUpload a schema:Thing ;
    schema:name "Remote WebDAV Upload"@en ;
    schema:description "Workflow for uploading locally generated artifacts to a remote WebDAV server using curl PUT with mTLS authentication. URIBurner is the default endpoint; user may designate alternatives. Supports On-Behalf-Of identity delegation."@en .

# ── Topic: Memory Protocol Validation Gate ────────────────────────────────────

:topicMemoryProtocolGate a schema:Thing ;
    schema:name "Memory Protocol Validation Gate"@en ;
    schema:description "Post-session audit gate that validates every Claude Code session transcript against the 5-step Agent RDF Memory Protocol using validate-memory-protocol.py. Programmatic backstop to the SessionStart hook injection. Added 2026-06-10 after protocol violation on a whoami query."@en .

# ── Step 39: Memory Protocol Validation Gate ─────────────────────────────────

:step-memoryProtocolGate a schema:HowToStep ;
    schema:position 53 ;
    schema:name "Validate memory protocol compliance with transcript audit gate"@en ;
    schema:text "After every session, run validate-memory-protocol.py on the session transcript to confirm all 5 mandatory protocol steps were executed."@en ;
    onto:hasTrigger onto:triggerSessionEnd ;
    rdfs:seeAlso <howto/memory-protocol-gate.ttl> .

# ── Topic: Token-Optimized Session Handoff ───────────────────────────────────

:topicTokenOptimizedSessionHandoff a schema:Thing ;
    schema:name "Token-Optimized Session Handoff"@en ;
    schema:description "Best practice for reducing token usage across repeated artifact-generation tasks: use a new session with a compact handoff for similar next articles, and keep the current session only for small edits to the same artifact. Added 2026-06-12 after repeated RDF/HTML collection generation and Graph IRI contract correction."@en .

# ── Step 40: Token-Optimized Session Handoff ─────────────────────────────────

:step-tokenOptimizedSessionHandoff a schema:HowToStep ;
    schema:position 54 ;
    schema:name "For repeated similar generation tasks, start a fresh session with a compact validated-pattern handoff"@en ;
    schema:text "For repeated similar generation tasks, start a fresh session seeded with a compact handoff naming the latest validated template, contract fixes, output routing, and validation gates."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation, onto:triggerNamedWorkflow ;
    rdfs:seeAlso <howto/token-optimized-session-handoff.ttl> .

# ── Topic: Virtuoso Workbench Query Deduplication ────────────────────────────

:topicVirtuosoWorkbenchQueryDedup a schema:Thing ;
    schema:name "Virtuoso Workbench Query Deduplication"@en ;
    schema:description "Virtuoso is a quad store: duplicate triples can appear across multiple named graphs. All workbench SPARQL queries must be scoped to the derived named graph (as specified in the active skill) to avoid cross-graph duplicates in results."@en .

# ── Step 41: Virtuoso Workbench Query Deduplication ──────────────────────────

:step-virtuosoWorkbenchQueryDedup a schema:HowToStep ;
    schema:position 55 ;
    schema:name "Scope all Virtuoso workbench SPARQL queries to the derived named graph to prevent cross-graph duplicates"@en ;
    schema:text "Scope all Virtuoso SPARQL queries to the relevant named graph using FROM to prevent cross-graph duplicate results in the quad store."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/virtuoso-workbench-query-dedup.ttl> .

:step-faqEntityIriGate a schema:HowToStep ;
    schema:position 56 ;
    schema:name "FAQ entity IRI pre-build gate: confirm schema:Question entities exist in companion TTL before writing FAQ HTML"@en ;
    schema:text "Before generating FAQ HTML, confirm schema:Question entities exist in the companion TTL and use their resolver-wrapped DAV IRIs as hrefs — never external concept IRIs."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/faq-entity-iri-gate.ttl>, <howto/rdf-infographic-compliance-gate.ttl> .

# ── Step 43: Ontology Cross-Reference Gate ────────────────────────────────────

:step-ontologyCrossReference a schema:HowToStep ;
    schema:position 57 ;
    schema:name "Cross-reference custom ontology terms against shared vocabularies via OWL equivalence and alignment properties; mandate domain, range, and annotations"@en ;
    schema:text "Every custom ontology class and property must carry rdfs:label, rdfs:comment, rdfs:domain/range, and at least one verified cross-reference to schema.org, DBpedia, or Wikidata."@en ;
    rdfs:seeAlso <howto/ontology-cross-reference-gate.ttl> ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation .

:topicOntologyCrossReference a schema:Thing ;
    schema:name "Ontology Cross-Reference Gate"@en ;
    schema:description "Requirement to cross-reference every custom ontology class and property against schema.org, DBpedia, and Wikidata using OWL equivalence and alignment properties; plus mandatory rdfs:label, rdfs:comment, rdfs:domain, and rdfs:range on every custom term. Ensures generated ontologies are fully described, properly constrained, and semantically aligned."@en .

# ── Step 44: UI/UX Expert Persona ─────────────────────────────────────────────

:step-uiUxExpertPersona a schema:HowToStep ;
    schema:position 58 ;
    schema:name "Operate as a modern UI/UX expert when producing any visual or interactive artifact"@en ;
    schema:text "Operate as a modern UI/UX expert on all visual artifacts: enforce the accent color system (--accent blue for entity links), explicit hyperlink CSS, label precision, and cross-section visual coherence."@en ;
    onto:hasTrigger onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/ui-ux-expert-persona.ttl> .

:topicUiUxExpertPersona a schema:Thing ;
    schema:name "UI/UX Expert Persona"@en ;
    schema:description "Standing behavioral default: operate as a UI/UX expert whenever producing any visual or interactive artifact. Enforces color system discipline, hyperlink consistency (--accent blue for entity links), label precision, and cross-section visual coherence. Never requires explicit per-session activation by the user."@en .

# ── Step 114: No Raw URL Dump ──────────────────────────────────────────────────

:step-noRawUrlDump a schema:HowToStep ;
    schema:position 115 ;
    schema:name "Never dump a raw percent-encoded URL as visible wrapped text — style live-query links as compact pill affordances"@en ;
    schema:text "Never render a live-query link's full encoded URL as plain wrapped text — style it as a compact pill-styled <a> labeled with intent instead."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/ui-ux-expert-persona.ttl> .

# ── Step 115: KG Explorer Edge Resolver Href Parity ────────────────────────────

:step-edgeResolverHref a schema:HowToStep ;
    schema:position 116 ;
    schema:name "KG Explorer edge label anchors must route through the resolver exactly like node labels — never the bare predicate IRI"@en ;
    schema:text "Edge label <a> href/xlink:href must be resolverUrl(predicateIri(d)), matching the resolver treatment already applied to node labels."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl>, <howto/kg-explorer-edge-property-typing.ttl> .

# ── Step 45: agent-rdf-memory/index.ttl as Sole Discovery Mechanism ──────────

:step-soleMemoryIndex a schema:HowToStep ;
    schema:position 59 ;
    schema:name "Use agent-rdf-memory/index.ttl as the sole session memory discovery mechanism"@en ;
    schema:text "agent-rdf-memory/index.ttl is the sole memory discovery index — never write to MEMORY.md; the canonical write targets are preferences.ttl, howto/*.ttl, core.ttl, index.ttl, and sessions/*.ttl."@en ;
    rdfs:seeAlso <howto/sparql-memory-loading.ttl> .

:topicSoleMemoryIndex a schema:Thing ;
    schema:name "Sole Memory Discovery Mechanism"@en ;
    schema:description "agent-rdf-memory/index.ttl is the canonical session memory discovery index. The platform's auto-memory MEMORY.md is redundant and must not be written to proactively."@en .

# ── Step 46: SPARQL-Based Session Memory Loading ──────────────────────────────

:step-sparqlMemoryLoading a schema:HowToStep ;
    schema:position 60 ;
    schema:name "BLOCKING GATE — elicit or reuse load path; never silently default to file reads on first session"@en ;
    schema:text "On every session start: check the most recent session TTL for onto:usedFileReads or onto:usedSparqlEndpoint. If found, reuse the recorded method. If absent (first session), BLOCK and elicit the 3-way load-path choice from the user — file reads (default), local Virtuoso SPARQL, or other endpoint. Do not silently default to file reads without presenting the choice. Record onto:usedFileReads or onto:usedSparqlEndpoint in every session TTL."@en ;
    onto:hasTrigger onto:triggerSessionStart ;
    rdfs:seeAlso <howto/sparql-memory-loading.ttl> .

:topicSparqlMemoryLoading a schema:Thing ;
    schema:name "SPARQL-Based Session Memory Loading"@en ;
    schema:description "Elicited SPARQL endpoint selection (localhost:8890/sparql or linkeddata.uriburner.com/sparql) for loading preferences, howto steps, and session context in a single query round-trip rather than N sequential file reads."@en .

# ── Step 47: KG Curation Attribution Pattern ──────────────────────────────────

:step-kgCurationAttribution a schema:HowToStep ;
    schema:position 61 ;
    schema:name "Apply KG curation attribution pattern in hero-meta and infographic headers"@en ;
    schema:text "In hero-meta and headers, attribute KG curation as: 'KG curated by {skills} and {llm} on behalf of [Kingsley Idehen](resolver-IRI)' with all parties hyperlinked."@en ;
    rdfs:seeAlso <howto/kg-curation-attribution.ttl> .

:topicKgCurationAttribution a schema:Thing ;
    schema:name "KG Curation Attribution Pattern"@en ;
    schema:description "Hero-meta and infographic header attribution pattern: 'KG curated by {skills} and {llm} on behalf of [Kingsley Idehen](resolver-IRI)' — exposes the full provenance chain of skills, AI agent, and human principal."@en .

# ── Step 116: Entity-Level Article/Content Authorship Delegation ──────────────

:step-entityLevelAuthorship a schema:HowToStep ;
    schema:position 117 ;
    schema:name "Article/entity authorship must reflect whoami's agent-operates-for-principal semantics — never set schema:author of agent-synthesized content directly to the principal"@en ;
    schema:text "Apply the same skills+agent-on-behalf-of-principal delegation pattern used for document-level curation credit at the entity level too, for any sub-entity the agent authors on the principal's behalf."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/kg-curation-attribution.ttl> .

# ── Step 117: saved-prompts/ Sibling Folder ────────────────────────────────────

:step-savedPromptsFolder a schema:HowToStep ;
    schema:position 118 ;
    schema:name "Reusable reproduction prompts go in a saved-prompts/ sibling folder under the model output root, never inside md/"@en ;
    schema:text "Write reusable reproduction prompts to {model-root}/saved-prompts/{slug}-reproduction-prompt.md — a sibling of rdf/, md/, and webpages/, never a file placed inside md/."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/artifact-routing.ttl>, <core.ttl> .

# ── Step 48: Use schema:author — Never foaf:maker ─────────────────────────────

:step-schemaAuthorOverFoafMaker a schema:HowToStep ;
    schema:position 62 ;
    schema:name "Use schema:author instead of foaf:maker — always"@en ;
    schema:text "Use schema:author for document and CreativeWork attribution in all RDF serializations — never foaf:maker."@en ;
    rdfs:seeAlso <howto/rdf-document-authoring.ttl> .

:topicSchemaAuthorOverFoafMaker a schema:Thing ;
    schema:name "schema:author over foaf:maker"@en ;
    schema:description "Standing rule: always use schema:author for document/creative work attribution. foaf:maker is never used."@en .

:step-entityHrefCompanionTTL a schema:HowToStep ;
    schema:position 63 ;
    schema:name "Entity hrefs in HTML infographics must resolve from the companion TTL via the resolver pattern"@en ;
    schema:text "All entity hyperlinks in HTML infographics must be resolver-wrapped IRIs sourced from the companion TTL — never external Wikipedia, W3C, or GitHub IRIs."@en ;
    rdfs:seeAlso <howto/entity-href-companion-ttl.ttl> .

:topicEntityHrefCompanionTTL a schema:Thing ;
    schema:name "Entity href sourcing from companion TTL"@en ;
    schema:description "Standing rule: all HTML infographic entity hrefs must be resolver-wrapped IRIs from the companion TTL, not external sources."@en .

:step-sparqlAbsolutePrefixIRI a schema:HowToStep ;
    schema:position 64 ;
    schema:name "SPARQL accordion PREFIX IRIs must always be absolute DAV IRIs — never relative IRIs"@en ;
    schema:text "All PREFIX declarations in SPARQL accordion queries must use absolute DAV IRIs derived from the skills contract — never relative IRIs."@en ;
    rdfs:seeAlso <howto/sparql-absolute-prefix-iri.ttl> .

:topicSparqlAbsolutePrefixIRI a schema:Thing ;
    schema:name "SPARQL accordion absolute PREFIX IRIs"@en ;
    schema:description "Standing rule: all PREFIX declarations in SPARQL accordion queries must use absolute DAV IRIs derived from the skills contract — never relative IRIs."@en .

# ── Step 51: No Unauthorized File Deletion ─────────────────────────────────────

:step-noUnauthorizedDeletion a schema:HowToStep ;
    schema:position 65 ;
    schema:name "Never delete files without explicit user approval"@en ;
    schema:text "Never delete any file without explicit user approval — flag and ask, never delete and explain."@en ;
    rdfs:seeAlso <howto/no-unauthorized-deletion.ttl> .

:topicNoUnauthorizedDeletion a schema:Thing ;
    schema:name "No unauthorized file deletion"@en ;
    schema:description "Standing rule: never delete any file without explicit user approval — flag and ask, never delete and explain."@en .

# ── Step 52: MEMORY.md Is a Fallback, Not a Write Target ──────────────────────

:step-noMemoryMdWrite a schema:HowToStep ;
    schema:position 66 ;
    schema:name "MEMORY.md is a read-only fallback — never write to it unless preferences.ttl is inaccessible"@en ;
    schema:text "Never write to MEMORY.md under normal operation — preferences.ttl and its companion howto/*.ttl files are the sole canonical write targets."@en ;
    rdfs:seeAlso <howto/no-memory-md-write.ttl> .

:topicNoMemoryMdWrite a schema:Thing ;
    schema:name "MEMORY.md is fallback, not write target"@en ;
    schema:description "Standing rule: never write to MEMORY.md unless preferences.ttl is inaccessible or corrupted — stop at preferences.ttl + howto/*.ttl."@en .

# ── Step 53: owl:sameAs vs skos:related assignment rule ──────────────────────

:step-owlSameAsVsSkosRelated a schema:HowToStep ;
    schema:position 67 ;
    schema:name "owl:sameAs vs skos:related for LOD cross-references"@en ;
    schema:text "Use owl:sameAs only when a KG entity co-denotes the exact same individual as the DBpedia or Wikidata resource; use skos:related for associative or contextual links."@en ;
    rdfs:seeAlso <howto/owl-sameas-vs-skos-related.ttl> .

:topicOwlSameAsVsSkosRelated a schema:Thing ;
    schema:name "owl:sameAs vs skos:related predicate selection"@en ;
    schema:description "Algorithm for choosing between owl:sameAs and skos:related when cross-referencing KG entities with DBpedia/Wikidata LOD resources."@en .

# ── Step 54: Entity Lookup Disambiguation Script ─────────────────────────────

:step-entityLookupDisambiguation a schema:HowToStep ;
    schema:position 68 ;
    schema:name "Use entity_lookup.py for Jaro-Winkler disambiguation of DBpedia/Wikidata IDs"@en ;
    schema:text "When assigning Wikidata or DBpedia IRIs to KG entities, use agent-rdf-memory/scripts/entity_lookup.py which applies Jaro-Winkler similarity scoring to return confidence-thresholded owl:sameAs, skos:related, or rdfs:seeAlso relationships."@en ;
    rdfs:seeAlso <howto/entity-lookup-disambiguation.ttl> .

:topicEntityLookupDisambiguation a schema:Thing ;
    schema:name "Entity lookup disambiguation via Jaro-Winkler"@en ;
    schema:description "Use entity_lookup.py to search Wikidata/DBpedia by name with Jaro-Winkler fuzzy matching, scoped by entity type, returning scored IRIs with owl:sameAs/skos:related/rdfs:seeAlso relationships."@en .

:topicDelegationLocalFiles a schema:Thing ;
    schema:name "YouID Delegation — Local File Modification Pattern"@en ;
    schema:description "WebID delegation triples must be applied to LOCAL profile files (TTL, JSON-LD, RDFa HTML, index.html) in the user's credentials folder, then uploaded manually. Never deploy via server-side SPARQL PATCH — the user controls when to sync."@en .

# ── Step 55: YouID Delegation — Local File Modification ──────────────────────

:step-delegationLocalFiles a schema:HowToStep ;
    schema:position 69 ;
    schema:name "Apply delegation triples to local profile files, not server-side PATCH"@en ;
    schema:text "Apply WebID On-Behalf-Of delegation triples to local profile files (profile.ttl, profile.jsonld, profile_rdfa.html, index.html), then let the user upload — never HTTP PATCH the live server."@en ;
    rdfs:seeAlso <howto/youid-delegation.ttl> .

:step-rdfInfographicGatedWorkflow a schema:HowToStep ;
    schema:position 70 ;
    schema:name "RDF-to-HTML infographic: script-assisted, gate-first, port-don't-write workflow"@en ;
    schema:text "Every RDF-to-HTML infographic must follow three parts: script-assisted entity extraction from companion TTL, gate-first validator protocol (PASS before any delivery), and port KG Explorer from prior working output rather than writing D3 from scratch."@en ;
    rdfs:seeAlso <howto/rdf-infographic-gated-workflow.ttl> .

# ── Step 57: SPARQL HTML Escape Gate ──────────────────────────────────────────

:step-sparqlHtmlEscape a schema:HowToStep ;
    schema:position 71 ;
    schema:name "HTML-escape SPARQL query text in <pre> blocks — angle brackets MUST be escaped"@en ;
    schema:text "HTML-escape all SPARQL query text in pre class='sparql-code' blocks so angle brackets in GRAPH/FROM IRIs render as &amp;lt; and &amp;gt; rather than being consumed as HTML tags."@en ;
    rdfs:seeAlso <howto/sparql-html-escape-gate.ttl> .

:topicSparqlHtmlEscape a schema:Thing ;
    schema:name "SPARQL pre-block HTML escape gate"@en ;
    schema:description "Standing rule: HTML-escape all SPARQL query text in <pre> blocks so angle brackets in GRAPH/FROM IRIs render as &lt; and &gt; instead of being consumed as invisible HTML tags."@en .

:step-youidValidationGate a schema:HowToStep ;
    schema:position 73 ;
    schema:name "Run Basic WebID Test (PKCS#12 Public Key Consistency Gate) for youid credential bundles"@en ;
    schema:text "Before deploying any WebID credential bundle, verify the PKCS#12 RSA modulus and exponent are consistently reflected in index.html, profile.ttl, and profile.jsonld."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/youid-validation-gates.ttl> .

:topicYouidValidationGate a schema:Thing ;
    schema:name "YouID Basic WebID Test Gate"@en ;
    schema:description "Must verify PKCS#12 cert public key matches index.html, profile.ttl, and profile.jsonld before deploying any youid credential bundle."@en .

:step-reuseWorkingKG a schema:HowToStep ;
    schema:position 72 ;
    schema:name "Reuse working KG Explorer code from prior output files — never write D3 from scratch"@en ;
    schema:text "When generating an HTML infographic with D3 KG Explorer, copy the proven D3 force graph, mode switching, settings panel, and filter logic from the most recent working output — never write from scratch."@en ;
    rdfs:seeAlso <howto/kg-explorer-reuse-first.ttl> .

:step-terminologySemanticWeb a schema:HowToStep ;
    schema:position 74 ;
    schema:name "Terminology: 'the Semantic Web' is unacceptable — always 'a Semantic Web' or 'purpose-specific Semantic Webs'"@en ;
    schema:text "TIGHTENED 2026-07-18: 'the Semantic Web' (definite article) is never acceptable, including for the global vision. Always write 'a Semantic Web' (indefinite, singular deployment) or 'purpose-specific Semantic Webs' (plural, the general phenomenon). This supersedes the prior exception that permitted 'the Semantic Web' for the global Web-wide vision."@en ;
    rdfs:seeAlso <howto/rdf-document-authoring.ttl> .

:step-verifiedWhoami a schema:HowToStep ;
    schema:position 75 ;
    schema:name "Run verified identity gate before responding to whoami OR any natural-language equivalent ('who am I', 'what are my preferences') — not for 'who are you?' queries"@en ;
    schema:text "Before responding to 'whoami?' or a natural-language equivalent whose subject is the user's own identity, run openssl modulus checks against local cert bundles for both user and agent, then emit the two-section response with verified or unverified badges."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery ;
    rdfs:seeAlso <howto/verified-identity.ttl>, <howto/agent-identity.ttl#step-classifyTrigger> .

:topicVerifiedWhoami a schema:Thing ;
    schema:name "Verified identity gate for whoami"@en ;
    schema:description "Before responding to 'whoami?' or a natural-language equivalent (Trigger A — subject is the user's own identity), run openssl cert modulus checks against local credential bundles for both user and agent. Emit verified IRI lines with ✅ or ⚠️ Unverified badge. For 'who are you?' (Trigger B — subject is the agent), skip gate and emit Agent-only section without badges."@en .

# ── Step 61: URIBurner OAuth Authorization Code Flow ──────────────────────────

:step-uriburnerOAuthAuthCodeFlow a schema:HowToStep ;
    schema:position 76 ;
    schema:name "Use OAuth Authorization Code flow with local server for URIBurner resources"@en ;
    schema:text "For URIBurner DAV resources returning 401, use the OAuth Authorization Code flow with dynamic client registration at linkeddata.uriburner.com — the token issuer must match the resource server."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerCurlAuth ;
    rdfs:seeAlso <howto/uriburner-oauth-authcode-flow.ttl> .

:topicOAuthAuthCodeFlow a schema:Thing ;
    schema:name "URIBurner OAuth Authorization Code Flow"@en ;
    schema:description "OAuth2 Authorization Code grant flow with dynamic client registration and local redirect server for accessing URIBurner DAV resources. Token issuer must match resource server (linkeddata.uriburner.com), not my.openlinksw.com."@en .

# ── Step 61a: ActivityPub Actor Document Endpoint Source Gate ─────────────

:step-activitypubActorDocumentGate a schema:HowToStep ;
    schema:position 78 ;
    schema:name "BLOCKING GATE — all ActivityPub endpoint URLs (inbox, outbox, sharedInbox, followers, following) MUST be sourced from the actor document, never guessed"@en ;
    schema:text "Every ActivityPub endpoint URL used for read or write operations must be read from the actor document's corresponding property — never constructed by appending path segments to the actor URI."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/activitypub-actor-document-gate.ttl> .

:topicActivitypubActorDocumentGate a schema:Thing ;
    schema:name "ActivityPub Actor Document Endpoint Source Gate"@en ;
    schema:description "Blocking protocol gate: all ActivityPub endpoint URLs must be read from the actor document — never guessed by convention."@en .

# ── Step 62: schema:homeLocation vs schema:birthPlace ─────────────────────────

:step-residenceVsBirthplace a schema:HowToStep ;
    schema:position 77 ;
    schema:name "Use schema:homeLocation for residence, not schema:birthPlace"@en ;
    schema:text "Newton, Massachusetts is Kingsley's residence — use schema:homeLocation, not schema:birthPlace, for locations derived from LinkedIn or X.509 Locality fields."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/rdf-residence-vs-birthplace.ttl> .

# ── Step 64: FAQ question text must be a resolver hyperlink ──────────────────

:step-faqQuestionTextHyperlink a schema:HowToStep ;
    schema:position 79 ;
    schema:name "Wrap FAQ question TEXT in a resolver <a> — 'Lookup' badge alone is insufficient"@en ;
    schema:text "Wrap FAQ question text in a resolver anchor targeting the schema:Question entity IRI — the 'Lookup' badge is additional, not a substitute for the text hyperlink."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/faq-entity-iri-gate.ttl> .

:topicFaqQuestionTextHyperlink a schema:Thing ;
    schema:name "FAQ Question Text Hyperlink Gate"@en ;
    schema:description "FAQ question TEXT must be wrapped in a resolver <a> targeting the schema:Question entity IRI — the 'Lookup' badge is additional, not a substitute. Verified by grepping .faq-q-text spans for nested resolver anchors."@en .

# ── Step 65: SPARQL workbench placement — after content sections ──────────────

:step-sparqlWorkbenchPlacement a schema:HowToStep ;
    schema:position 80 ;
    schema:name "Place the SPARQL workbench section AFTER FAQ/Glossary/HowTo — never between KG Explorer and FAQ"@en ;
    schema:text "Place the SPARQL workbench section after FAQ/Glossary/HowTo and immediately before the footer — never between the KG Explorer and FAQ."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

:topicSparqlWorkbenchPlacement a schema:Thing ;
    schema:name "SPARQL Workbench Placement"@en ;
    schema:description "The SPARQL workbench must be the last content section, placed after FAQ/Glossary/HowTo and before the attribution footer. Verified by comparing character positions of id='sparql-workbench' vs id='howto' in generated HTML."@en .

# ── Step 66: KG drag sticky — never null fx/fy on dragend ────────────────────

:step-kgDragSticky a schema:HowToStep ;
    schema:position 81 ;
    schema:name "KG Explorer sticky drag: never null d.fx/d.fy on dragend; dblclick to unpin"@en ;
    schema:text "KG Explorer nodes must remain pinned after drag — dragend must NOT clear d.fx/d.fy; use double-click to unpin."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

:topicKgDragSticky a schema:Thing ;
    schema:name "KG Explorer Sticky Drag"@en ;
    schema:description "D3 KG Explorer nodes must stay pinned after drag. dragend MUST NOT clear d.fx/d.fy. Double-click to unpin. Static validator cannot catch this — it is a pre-build behavioral gate."@en .

# ── Step 67: IIFE scope — all onclick handlers must be window-exposed ──────────

:step-iifeGlobalScope a schema:HowToStep ;
    schema:position 82 ;
    schema:name "All onclick/onchange handler functions defined inside an IIFE must be exposed on window"@en ;
    schema:text "Every function called from an HTML onclick or onchange attribute that is defined inside an IIFE must be explicitly exposed on window."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

:topicIifeGlobalScope a schema:Thing ;
    schema:name "IIFE Global Scope for onclick Handlers"@en ;
    schema:description "All functions called from HTML onclick/onchange attributes MUST be exposed on window if defined inside an IIFE. Unscoped functions silently fail at runtime — no static validator catches this. Verified by cross-referencing onclick attribute function names against window.X assignments."@en .

# ── Step 63: No blank nodes for resolver-addressable entities ─────────────────

:step-noBlankNodesForResolverEntities a schema:HowToStep ;
    schema:position 78 ;
    schema:name "Prohibit blank nodes for any entity that requires a resolver URL"@en ;
    schema:text "Any entity that requires a resolver URL (FAQ answers, HowTo steps, glossary terms) must use a named IRI — never a blank node."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/no-blank-nodes-resolver-entities.ttl> .

# ── Step 68: sparqlBtn must be <a> in footer with real SPARQL href ─────────────

:step-sparqlBtnFooterAnchor a schema:HowToStep ;
    schema:position 83 ;
    schema:name "sparqlBtn must be an <a> element in the footer with a pre-built SPARQL href — not a <button> scroll trigger at page top"@en ;
    schema:text "The id='sparqlBtn' element must be an anchor in the footer with a pre-built SPARQL href — never a button scroll trigger at the top of the page."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

:topicSparqlBtnFooterAnchor a schema:Thing ;
    schema:name "sparqlBtn Footer Anchor Gate"@en ;
    schema:description "id=sparqlBtn must be an <a> element placed in the footer/sparql-explorer section with a pre-built canonical SPARQL href — never a <button> scroll trigger at the top of the page. Static validator checks presence only, not element type or position."@en .

# ── Step 69: Theme toggle must be in nav header bar — always visible ───────────

:step-themeToggleInNavHeader a schema:HowToStep ;
    schema:position 84 ;
    schema:name "Theme toggle must live in the nav panel header bar — not a separate controls bar, not inside the collapsible nav body"@en ;
    schema:text "The theme toggle must be inside the nav panel header bar (always-visible strip) — not in a separate controls bar and not in the collapsible nav body."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

:topicThemeToggleInNavHeader a schema:Thing ;
    schema:name "Theme Toggle Nav Header Placement Gate"@en ;
    schema:description "The theme toggle must be in the nav panel header bar (always-visible strip) — not in a separate controls bar, not in the collapsible nav body. Static validator checks string presence only, not DOM placement."@en .

# ── Step 70: Section heading fragment identifiers + 🔗 copy-to-clipboard ───────

:step-headingFragmentIds a schema:HowToStep ;
    schema:position 85 ;
    schema:name "Every section heading must carry a stable id + hover anchor with copy-to-clipboard"@en ;
    schema:text "Every section heading must be an h2 carrying its own stable id, plus a hidden .heading-anchor child that appears on hover and copies the fragment URL to clipboard."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/harness-contract-compliance.ttl> .

:topicHeadingFragmentIds a schema:Thing ;
    schema:name "Section Heading Fragment Id Gate"@en ;
    schema:description "Every section heading must be an <h2> (not <div>) carrying its own id attribute, plus a .heading-anchor <a> child that appears on hover and copies the fragment URL to clipboard. Static validator has no check for heading element type, id-on-wrapper vs id-on-heading, or 🔗 icon presence."@en .

# ── Step 71: Static D3 script tag ──────────────────────────────────────────────

:step-staticD3Load a schema:HowToStep ;
    schema:position 86 ;
    schema:name "Load D3.js as static <script> in <head> — never dynamic injection"@en ;
    schema:text "Load D3.js as a static <script> tag in <head> — never via script.createElement + DOMContentLoaded, which creates a race condition."@en ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

:topicD3Loading a schema:Thing ;
    schema:name "Static D3.js Loading Policy"@en ;
    schema:description "D3.js must be loaded as a static script tag in <head>, not injected dynamically. Dynamic loading causes a race condition that breaks KG Explorer initialization."@en .

# ── Step 72: Single render() function ──────────────────────────────────────────

:step-singleRender a schema:HowToStep ;
    schema:position 87 ;
    schema:name "Use single render() that wipes/rebuilds SVG — not initGraph/updateGraph split"@en ;
    schema:text "Use a single render() function that wipes and rebuilds the SVG from scratch — never an initGraph/updateGraph split, which is prone to D3 data-join mutation bugs."@en ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

# ── Step 73: Secret value echo protection ──────────────────────────────────────

:topicSecretEchoRedaction a schema:Thing ;
    schema:name "Secret Value Echo Protection"@en ;
    schema:description "Never echo API keys, bearer tokens, or other credentials in command output, shell traces, or displayed text. When executing authenticated curl commands or processing responses that contain secrets, ensure the secret values are never visible in stdout, stderr, or any output shown to the user — even when piping through tee or debugging helpers. Interactions may be recorded for training or demo purposes."@en .

:step-secretEchoRedaction a schema:HowToStep ;
    schema:position 88 ;
    schema:name "Never echo secret values in command output or displayed text"@en ;
    schema:text "Never display API keys, bearer tokens, or credential values in command output — always append a trailing colon to curl -u flags, never tee raw responses containing secrets to stderr."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 74: DBpedia IRI as canonical subject — no local-alias + owl:sameAs ────

:step-dbpediaCanonicalSubject a schema:HowToStep ;
    schema:position 89 ;
    schema:name "When a DBpedia IRI exists for an entity, use it as the primary subject — never a document-local alias with owl:sameAs dbr:X"@en ;
    schema:text "When a verified DBpedia IRI exists for an entity, use it as the primary RDF subject — never create a document-local alias with owl:sameAs dbr:X."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/canonical-iri-compliance-gate.ttl> .

:topicDbpediaCanonicalSubject a schema:Thing ;
    schema:name "DBpedia Canonical Subject Gate"@en ;
    schema:description "When a DBpedia IRI exists for an entity, it must be used as the primary subject — never as the target of owl:sameAs from a document-local IRI. owl:sameAs should only express genuine cross-vocabulary alignment (DBpedia↔Wikidata) or platform identity equivalences."@en .

# ── Step 75: sparqlBtn is a mandatory harness element — never remove in cleanup ──

:step-sparqlBtnMandatory a schema:HowToStep ;
    schema:position 90 ;
    schema:name "The footer id='sparqlBtn' anchor is a mandatory harness contract element — never remove it when cleaning up duplicate SPARQL sections"@en ;
    schema:text "The footer id='sparqlBtn' anchor is a mandatory harness element — when removing duplicate SPARQL sections, never remove the footer anchor itself."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 76: id="sparql-explorer" must display SAMPLE query text visibly ─────────

:step-sparqlExplorerVisibleText a schema:HowToStep ;
    schema:position 91 ;
    schema:name "The footer id='sparql-explorer' section must display the SAMPLE query as visible pre.sparql-code text, not only encode it in the sparqlBtn href"@en ;
    schema:text "The id='sparql-explorer' footer section must display the SAMPLE entity-type summary query as visible, syntax-highlighted pre.sparql-code text with a Copy button — not only encoded in the sparqlBtn href."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 77: footer text-align:center cascade gate ───────────────────────────────

:step-footerTextAlignCascade a schema:HowToStep ;
    schema:position 92 ;
    schema:name "When footer text-align:center is in the CSS, the id='sparql-explorer' div must override with text-align:left; .fmt-tabs must use justify-content:flex-start"@en ;
    schema:text "When the footer CSS uses text-align:center, the id='sparql-explorer' div must override with text-align:left and .fmt-tabs must use justify-content:flex-start."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 78: stale interactive workbench cleanup gate ────────────────────────────

:step-staleWorkbenchCleanup a schema:HowToStep ;
    schema:position 93 ;
    schema:name "When removing the interactive SPARQL workbench HTML, also remove its companion JS functions and CSS classes"@en ;
    schema:text "When removing interactive SPARQL workbench HTML, also remove its companion JS functions (sparqlRecipes, loadSparqlRecipe, setSparqlMode, runSparqlQuery) and their CSS classes."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 79: KG Explorer lazy-init via IntersectionObserver ──────────────────────

:step-kgLazyInit a schema:HowToStep ;
    schema:position 94 ;
    schema:name "KG Explorer must not activate until its section enters the viewport — use a one-shot IntersectionObserver"@en ;
    schema:text "Defer initKG() until #kg-svg-wrap enters the viewport via a one-shot IntersectionObserver(threshold:0.1); the resize handler's existing if(simulation) guard keeps it dormant until then."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/kg-explorer-d3-patterns.ttl> .

# ── Step 80: preferences.ttl must stay sparse — prose belongs in howto/ ─────────

:step-preferencesSparse a schema:HowToStep ;
    schema:position 95 ;
    schema:name "Every new preferences.ttl step must be a name + one-sentence schema:text + rdfs:seeAlso — never inline prose"@en ;
    schema:text "New HowToStep entries in preferences.ttl are limited to schema:name, a one-sentence schema:text, onto:hasTrigger, and rdfs:seeAlso; all rationale, code, gates, and incident notes go in the companion howto/*.ttl file."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/memory-protocol-gate.ttl> .

# ── Step 81: Study proven patterns from prior work when constructing execution plans ──

:step-studyPriorPatterns a schema:HowToStep ;
    schema:position 96 ;
    schema:name "Study proven patterns from prior output as input to execution plan construction, in line with operator request"@en ;
    schema:text "Before planning a new HTML infographic, study proven patterns from prior working outputs to inform — never blindly reproduce — a plan that reflects what the operator's prompt actually asks for."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/study-prior-patterns.ttl>,
        <howto/prior-artifact-footer-polish-gate.ttl>,
        :step-priorArtifactFooterPolishGate .

:topicStudyPriorPatterns a schema:Thing ;
    schema:name "Study Prior Patterns, Don't Mandate Reuse"@en ;
    schema:description "The FAQ accordion pattern (.faq-item > .faq-q onclick toggle > .faq-a max-height expand) from prior documents (satyas-convenient-truth, startups-2030) is a strong signal for what works in this repo — study it, use it to inform plan construction, but let the operator's actual request determine the final approach."@en .

# ── Step 82: WebID/NetID Verification Service Selection ──────────────────────

:step-webidVerificationServiceSelection a schema:HowToStep ;
    schema:position 97 ;
    schema:name "Elicit WebID/NetID verification service selection and MTLS_PKCS12_PW setup before remote mTLS verification"@en ;
    schema:text "Elicit which WebID/NetID verification service to use from the known list before any remote mTLS call, and check for MTLS_PKCS12_PW via the OS environment without ever printing, echoing, or storing it."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/webid-verification-services.ttl> .

:topicWebidVerificationServices a schema:Thing ;
    schema:name "WebID/NetID Verification Service Selection"@en ;
    schema:description "Rules for eliciting and executing WebID/NetID verification against OpenLink's mTLS verification services. Known services: netid-qa.openlinksw.com:9443/webid/, ods-qa.openlinksw.com/webid/, linkeddata.uriburner.com/webid/, demo.openlinksw.com/webid/. List is open and extensible. Selection is always elicited unless the user names a service in their prompt. Remote mTLS verification must also verify that MTLS_PKCS12_PW is available without printing it, and if absent must elicit OS-specific setup guidance before proceeding."@en ;
    rdfs:seeAlso <howto/webid-verification-services.ttl> .

# ── Step 83: whoami owl:sameAs as hyperlinks ──────────────────────────────────

:step-whoamiSameAsHyperlinks a schema:HowToStep ;
    schema:position 98 ;
    schema:name "Emit owl:sameAs values in whoami as Markdown hyperlinks sourced from the user's WebID index.html rel=me links"@en ;
    schema:text "Before emitting the whoami User section, grep the user's WebID index.html for <link rel='me'> entries and emit each as a Markdown hyperlink [Title](URL) — never as prose platform categories."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery ;
    rdfs:seeAlso <howto/agent-identity.ttl> .

:topicWhoamiSameAsHyperlinks a schema:Thing ;
    schema:name "whoami owl:sameAs as Markdown hyperlinks"@en ;
    schema:description "The owl:sameAs bullet in the whoami User section must list each platform identity as a Markdown hyperlink [Title](URL), sourced at runtime by grepping <link rel='me'> entries from the user's WebID index.html. Prose descriptions of platform categories are not acceptable."@en .

# ── Step 84: Reciprocal delegation claim verification ─────────────────────────

:step-verifyRecipDelegation a schema:HowToStep ;
    schema:position 99 ;
    schema:name "Verify reciprocal oplcert:hasIdentityDelegate / oplcert:onBehalfOf before accepting On-Behalf-Of"@en ;
    schema:text "Before accepting an On-Behalf-Of claim as corroborated, grep both credential profiles for the reciprocal oplcert:hasIdentityDelegate / oplcert:onBehalfOf triples and report the result in the whoami Delegation line."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery ;
    rdfs:seeAlso <howto/verified-identity.ttl> .

# ── Step 85: All URLs in response output must be Markdown hyperlinks ──────────

:step-urlsAsHyperlinks a schema:HowToStep ;
    schema:position 100 ;
    schema:name "Every URL in response text, tables, and bullets must be a Markdown hyperlink [label](url)"@en ;
    schema:text "Never emit a bare URL in any response text, table cell, or bullet point — always wrap it as a Markdown hyperlink [label](url)."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery, onto:triggerSkillInvocation, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/agent-identity.ttl> .

:topicUrlsAsHyperlinks a schema:Thing ;
    schema:name "URLs in response output always as Markdown hyperlinks"@en ;
    schema:description "Standing rule: every URL appearing in agent response text, table cells, or bullet points must be rendered as a Markdown hyperlink [label](url) — never bare. Covers WebID URIs, On-Behalf-Of values, owl:sameAs targets, NetIDs, and all other IRIs."@en .

:topicVerifyRecipDelegation a schema:Thing ;
    schema:name "Reciprocal delegation claim verification"@en ;
    schema:description "An On-Behalf-Of header is a self-declaration. Full corroboration requires checking both sides: the delegator's profile must contain oplcert:hasIdentityDelegate pointing to the agent, and the agent's profile must contain oplcert:onBehalfOf pointing to the delegator. Either side missing → partially corroborated. Neither present → unconfirmed. Local verification (Step 6) greps local credential files; remote verification (Step 7) fetches live WebDAV profiles via curl, cross-checks all RDF serializations, and optionally tests against a WebID verification service with the On-Behalf-Of header. Protocol in howto/verified-identity.ttl Steps 6 and 7."@en .

# ── Step 86: Remote delegation verification ───────────────────────────────────

:step-verifyDelegationRemote a schema:HowToStep ;
    schema:position 101 ;
    schema:name "Verify reciprocal delegation claims against live remote WebDAV profiles"@en ;
    schema:text "After local delegation verification, also verify against the live remote WebDAV-hosted profiles by fetching profile.ttl and index.html via curl, public read first."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery ;
    rdfs:seeAlso <howto/verified-identity.ttl> .

# ── Step 87: Identity Verification Table Pattern ──────────────────────────────

:topicWebidVerificationTable a schema:Thing ;
    schema:name "Identity Verification Table Pattern"@en ;
    schema:description "Structured verification table pattern for WebID/NetID identity validation. Covers: (1) Agent cert SHA-1 fingerprint extraction from PKCS#12, (2) base verification against remote ODS webid_verify.vsp, (3) On-Behalf-Of verification with delegator WebID header, (4) cross-check of delegator profile for oplcert:hasIdentityDelegate, (5) cross-check of agent profile for oplcert:onBehalfOf across all RDF serializations (TTL, JSON-LD, HTML RDFa), (6) modulus consistency check between cert and profile documents, (7) results emitted as a verification table with rows for each check and ✅/⚠️ status columns."@en .

:step-webidVerificationTable a schema:HowToStep ;
    schema:position 102 ;
    schema:name "Run identity verification table: cert extraction → base OBO → delegation cross-check → modulus consistency → emit table"@en ;
    schema:text "Verify WebID/NetID identity via the structured table pattern: cert fingerprint, base/OBO verification, delegation cross-check, modulus consistency, then emit a verification table."@en ;
    onto:hasTrigger onto:triggerWhoamiQuery, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/webid-verification-table.ttl> .

# ── Step 88: Preferences Presentation Format ──────────────────────────────────

:topicPreferencesPresentationFormat a schema:Thing ;
    schema:name "Preferences Presentation Format"@en ;
    schema:description "When presenting the user's preferences, use the succinct themed-table widget format (mcp__visualize__show_widget) with grouped tables by theme, step number, rule name, and one-line detail. Use this format by default unless the user explicitly requests a different form."@en .

:step-preferencesPresentationFormat a schema:HowToStep ;
    schema:position 103 ;
    schema:name "Present preferences as a succinct themed-table widget — not a flat numbered list"@en ;
    schema:text "When asked to display preferences, render a category-level table (#, Category, Steps, Primary HowTo Files) derived dynamically from :agentBehaviorGuide's schema:hasPart — never a hardcoded flat list."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/preferences-presentation.ttl> .

# ── Step 89: Server-Side Delegation INSERT Gate ────────────────────────────────

:topicDelegationInsertGate a schema:Thing ;
    schema:name "Server-Side Delegation INSERT Gate"@en ;
    schema:description "When registering oplcert:hasIdentityDelegate on a delegator's profile graph via SPARQL INSERT, the delegate's public key (cert:modulus + cert:exponent) must be included inline as a blank node under cert:key. Omission breaks the WebID-TLS verification chain: the delegator graph has no way to resolve the delegate's public key to corroborate the mTLS certificate presented via On-Behalf-Of."@en .

:step-delegationInsertGate a schema:HowToStep ;
    schema:position 104 ;
    schema:name "BLOCKING GATE — SPARQL INSERT of oplcert:hasIdentityDelegate must include delegate cert:key (modulus + exponent) inline"@en ;
    schema:text "Before executing a SPARQL INSERT of oplcert:hasIdentityDelegate, ensure it also includes the delegate's cert:key (modulus + exponent) inline as a blank node."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/delegation-insert-gate.ttl> .

# ── Step 90: On-Behalf-Of header format — bare URI, no angle brackets ───────────

:topicOboHeaderFormat a schema:Thing ;
    schema:name "On-Behalf-Of Header Format — Bare URI, No Angle Brackets"@en ;
    schema:description "The On-Behalf-Of HTTP header value must be a bare WebID URI without angle brackets. Format: 'On-Behalf-Of: https://example.com/path#fragment' — not '<https://example.com/path#fragment>'. Angle brackets cause the delegation verification to fail, returning 402 Payment Required even when the delegation chain is correct on both sides."@en .

:step-oboHeaderFormat a schema:HowToStep ;
    schema:position 105 ;
    schema:name "On-Behalf-Of header value: bare WebID URI — never angle brackets"@en ;
    schema:text "The On-Behalf-Of HTTP header value must be a bare WebID URI without angle brackets, since angle brackets cause delegation resolution failure (402/401)."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerCurlAuth ;
    rdfs:seeAlso <howto/youid-delegation.ttl> .

# ── Step 91: OWL Property Characterization for Generated Ontologies ─────────

:topicOwlPropertyCharacterization a schema:Thing ;
    schema:name "OWL Property Characterization for Generated Ontologies"@en ;
    schema:description "When generating custom ontologies as part of a KG task, every object property must be characterized using applicable OWL constructs from nine semantic categories: Typing (domain/range — mandatory), Hierarchy (subPropertyOf/equivalentProperty), Identity/Direction (inverseOf), Reflexivity (Reflexive/Irreflexive), Symmetry (Symmetric/Asymmetric), Propagation (Transitive), Cardinality/Uniqueness (Functional/InverseFunctional), Composition (propertyChainAxiom), and Class-based Constraints (someValuesFrom/allValuesFrom/cardinality restrictions). Classification/status properties default to owl:FunctionalProperty + owl:AsymmetricProperty + owl:IrreflexiveProperty."@en ;
    rdfs:seeAlso <howto/owl-property-characterization.ttl> .

:step-owlPropertyCharacterization a schema:HowToStep ;
    schema:position 106 ;
    schema:name "Characterize every generated custom object property with applicable OWL constructs from the nine semantic categories"@en ;
    schema:text "Every custom owl:ObjectProperty must carry at least one OWL characteristic from the nine semantic categories, defaulting classification/status properties to Functional + Asymmetric + Irreflexive."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/owl-property-characterization.ttl> .

# ── Step 92: Footer/Attribution Card Text Overflow — BLOCKING CHECK ─────────

:topicFooterCardOverflow a schema:Thing ;
    schema:name "Long-Token Text Overflow Gate (generalized)"@en ;
    schema:description "Any element rendering an algorithmically-derived long unbroken token (URL, IRI, camelCase identifier, base64) overflows its container unless the container defaults to min-width:0 and the text-bearing element has overflow-wrap:anywhere + word-break:break-word. Not limited to <code> tags or footer cards. Recurred 3 times across 2 sessions: 2026-06-29 (footer attribution <code> URL), 2026-07-01 (same class of footer card), 2026-07-02 (an offer card's plain-text <h4> title with no <code> wrapper, plus the shared .sparql-code <pre> class itself lacked the protection before a new panel reused it). Treat as a blocking pre-delivery check on every session touching HTML infographics, not a one-off fix scoped to one selector."@en .

:step-footerCardOverflow a schema:HowToStep ;
    schema:position 107 ;
    schema:name "ANY card/heading/pre containing a long unbroken token can overflow — not just <code> URLs — verify via scrollWidth before delivery"@en ;
    schema:text "Any element that may render a long unbroken token (URL, IRI, identifier) needs overflow-wrap:anywhere and word-break:break-word, verified via el.scrollWidth <= el.clientWidth before delivery."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/infographic-authoring.ttl> .

# ── Step 93: Acronym Expansion on First Use ──────────────────────────────────

:topicAcronymExpansion a schema:Thing ;
    schema:name "Acronym Expansion on First Use"@en ;
    schema:description "Every acronym/initialism must be expanded to its full form on first use per response or generated artifact, with the acronym given parenthetically — e.g. 'Attribute-Based Access Control (ABAC)', not bare 'ABAC'. Common web/tech acronyms (HTML, URL, HTTP, CSS, JSON, API, PDF, AI, ID) are exempt. Triggered 2026-07-01 after domain-specific acronyms (ABAC, MPP, ACP, SPT, WebID-TLS, LOAC) were left unexpanded across a chat response and generated report."@en .

:step-expandFirstUse a schema:HowToStep ;
    schema:position 108 ;
    schema:name "Expand every acronym/initialism on first use — full term, acronym in parentheses"@en ;
    schema:text "Expand every acronym on first use per artifact as 'Full Term (ACRONYM)', except common web/tech acronyms and glossary DefinedTerm entries."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/acronym-expansion.ttl> .

# ── Step 94: Session-Log Reconciliation on Structural Violation ──────────────

:topicSessionLogReconciliation a schema:Thing ;
    schema:name "Session-Log Reconciliation on Structural Violation"@en ;
    schema:description "When a structural violation is discovered in preferences.ttl or any howto/*.ttl file — an orphan step, a missing cross-reference, a duplicate entity, or a contract breach — the agent must trace the violation to its source commit and session log before fixing it. Blind repair erases the decision context; forensic reconciliation surfaces the originating agent's reasoning and enables corrective feedback. Triggered by any audit that finds a non-zero violation count."@en .

:step-sessionLogReconciliation a schema:HowToStep ;
    schema:position 109 ;
    schema:name "Trace every structural violation to its source session log before applying the fix"@en ;
    schema:text "Trace every structural violation found in preferences.ttl or howto/*.ttl to its originating commit and session log before applying the fix, and cite both in the fix report."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/session-governance.ttl> .

# ── Step 95: Semantic Prompt → Session Context Bootstrapping ────────────────

:topicSemanticSessionBootstrap a schema:Thing ;
    schema:name "Semantic Prompt → Session Context Bootstrapping"@en ;
    schema:description "On every session start, after the mandatory memory protocol (core/prefs/index reads), the agent must analyze the user's prompt for key concepts, entities, and task types, then grep/query index.ttl and session file descriptions for semantically related past sessions, and load the top 3–5 most relevant ones as bootstrap context. This turns the session corpus from a passive archive into an active retrieval source."@en .

:step-semanticSessionBootstrap a schema:HowToStep ;
    schema:position 110 ;
    schema:name "DEPRECATED — replaced by step-progressiveContextLoading (position 144)"@en ;
    schema:text "This step is deprecated. Prior session context is now loaded per task via step-progressiveContextLoading (position 144), not at session start. See howto/progressive-context-loading.ttl for the new procedure."@en ;
    rdfs:seeAlso <howto/progressive-context-loading.ttl> .

:topicFilesystemPathVerification a schema:Thing ;
    schema:name "Filesystem Path Verification Gate"@en ;
    schema:description "When mapping model ID to an output directory, verify the actual path exists on disk via ls before using it — never infer directory naming conventions (casing, hyphens, spacing) from entries in core.ttl or artifact-routing.ttl alone. Pure inference was the failure pattern that created this rule."@en .

:step-filesystemPathVerification a schema:HowToStep ;
    schema:position 111 ;
    schema:name "Verify the actual filesystem path exists — never infer directory names by convention alone"@en ;
    schema:text "List the parent directory with ls to confirm the exact output directory name on disk before writing, rather than inferring casing or spacing by convention."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/filesystem-path-verification.ttl> .

# ── Step 97: KG Explorer Edge Property Typing ────────────────────────────────

:topicEdgePropertyTyping a schema:Thing ;
    schema:name "KG Explorer Edges Must Resolve to rdf:Property Instances, Never schema:DefinedTerm"@en ;
    schema:description "An edge in a KG Explorer represents a relationship/predicate, not a concept definition. Its resolver link must dereference to an owl:ObjectProperty/rdf:Property instance, never a schema:DefinedTerm glossary entry — even when a glossary term is topically related and conveniently already dereferenceable. If no suitable real-world predicate exists for an informal/diagram-only edge, mint a locally-namespaced owl:ObjectProperty with domain/range plus at least one OWL characteristic (per Step 91), and back it with an actual triple in the companion TTL — not just a JS array entry. Found 2026-07-02: three edge labels (mTLS, feeds, gates) in a hand-built KG Explorer were wired to glossary DefinedTerm entries instead of properties."@en .

:step-edgePropertyTyping a schema:HowToStep ;
    schema:position 112 ;
    schema:name "Type-check every KG Explorer edge's resolver target — reject schema:DefinedTerm, mint a characterized owl:ObjectProperty if no real predicate exists"@en ;
    schema:text "Before setting a KG Explorer edge's resolver href, reuse a real predicate if one exists as an actual triple, otherwise mint a characterized owl:ObjectProperty with a backing triple — never link an edge to a schema:DefinedTerm."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/kg-explorer-edge-property-typing.ttl>, <howto/owl-property-characterization.ttl> .

# ── Step 98: Minting a New Property Never Skips the Ontology Gates ──────────

:topicMintingSkipsOntologyGates a schema:Thing ;
    schema:name "A Narrow Fix Task Does Not Exempt New Terms From the General Ontology Gates"@en ;
    schema:description "Found 2026-07-03: when Step 97's fix minted :authenticatesVia, :feedsInto, :gatesAccessTo as owl:ObjectProperty instances, the pre-existing, general-purpose ontology-discovery.ttl (search prefix.cc/known vocabularies before inventing a predicate, present findings for user accept/reject) and ontology-cross-reference-gate.ttl (rdfs:label/comment, domain/range, rdfs:isDefinedBy to a document-local owl:Ontology entity, plus a verified external cross-reference or documented gap) were never run. The narrow instruction ('make this edge resolve to a real Property, not a DefinedTerm') was satisfied literally while silently bypassing the broader, already-established minting protocol it depends on. User caught it directly: 'you haven't followed the howto guide in prefs for handling new terms and their associated ontology.'"@en .

:step-mintingRunsOntologyGates a schema:HowToStep ;
    schema:position 113 ;
    schema:name "Any time a new class or property is minted for ANY reason (edge typing, glossary expansion, KG generation, etc.), run the general ontology-discovery and cross-reference gates in full — no exceptions for narrowly-scoped fixes"@en ;
    schema:text "Minting any new class or property for any reason always triggers the ontology-discovery and cross-reference gates in full, regardless of how narrowly the triggering task is framed."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/ontology-discovery.ttl>, <howto/ontology-cross-reference-gate.ttl>, <howto/kg-explorer-edge-property-typing.ttl> .

# ── Step 113: schema:position Objects Must Be xsd:integer, Sequential, Non-Decimal ──

:topicPositionIntegerType a schema:Thing ;
    schema:name "schema:position Objects Must Be Plain or Typed xsd:integer, Never Decimal, Never Duplicated"@en ;
    schema:description "Found 2026-07-03 in preferences.ttl itself: 15 schema:HowToStep entities used decimal schema:position values (e.g. 2.1, 10.05, 59.1) as an ad-hoc insertion mechanism for slotting a new step between two existing integers, producing xsd:decimal-typed literals instead of xsd:integer. A duplicate entity (:step-kgLazyInit) was also found declared twice at the same position (79). Both defects were invisible to rdflib parsing (decimals and duplicates are syntactically valid Turtle) and only surfaced when the user inspected the data directly."@en .

:step-positionIntegerType a schema:HowToStep ;
    schema:position 114 ;
    schema:name "Never use a decimal schema:position to slot a step between two existing integers — renumber the full sequence instead"@en ;
    schema:text "schema:position on a schema:HowToStep (or any ordered schema:ItemList-style member) must always be an xsd:integer object — a bare Turtle integer literal (e.g. 42) or an explicitly typed one (e.g. \"42\"^^xsd:integer). Never insert a new step at a decimal position (2.1, 10.05) to avoid renumbering — this produces an xsd:decimal object, which violates the type contract even though it parses without error. When inserting a step between two existing integer positions, renumber the ENTIRE downstream sequence to consecutive integers (a scripted sort-and-reassign over all schema:position triples in the file, not manual editing one at a time) so no gaps, decimals, or duplicate positions remain. After renumbering, verify programmatically: extract every schema:position value, confirm all are integer-typed, and confirm the full set is exactly {1..N} with no duplicates and no decimals — do not rely on rdflib parsing success alone, since decimals and duplicate positions both parse cleanly."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified .

# ── Step 118: Symbolic Short-Term Log Offloading ─────────────────────────────

:topicSymbolicLogOffloading a schema:Thing ;
    schema:name "Offload Large Tool Outputs to IRI-Addressed Logs, Keep Only Symbol Nodes in Context"@en ;
    schema:description "Added 2026-07-06 after comparing agent-rdf-memory against TencentDB Agent Memory's Mermaid symbol-graph approach: this repo had a session-boundary token-optimization step (token-optimized-session-handoff.ttl) but nothing for within-session compression of large tool outputs (big file reads, long command output, bulk SPARQL/SQL results). New onto:OffloadedLog and onto:SessionSymbolNode classes address this, with every storage location expressed as an IRI (file:, https:, or urn: for Virtuoso named graphs) — never a string literal path — and every symbol node minted as its own IRI rather than a blank node keyed by a literal, per the no-blank-nodes-resolver-entities.ttl rule."@en .

:step-symbolicLogOffloading a schema:HowToStep ;
    schema:position 119 ;
    schema:name "Offload large tool outputs to an IRI-addressed log and keep only a symbolic node reference in context"@en ;
    schema:text "Offload oversized tool results to an IRI-addressed onto:OffloadedLog and stand in for it with an onto:SessionSymbolNode (its own IRI, never a blank node), recalling detail via that IRI instead of re-running the tool call."@en ;
    onto:hasTrigger onto:triggerLogOffloadThreshold ;
    rdfs:seeAlso <howto/symbolic-log-offloading.ttl>, <howto/no-blank-nodes-resolver-entities.ttl>, <howto/token-optimized-session-handoff.ttl> .

# ── Step 120: Elicit Before Applying a Gate's Conditional Default ───────────

:topicElicitBeforeConditionalDefault a schema:Thing ;
    schema:name "Elicit User Preference Before Applying a Gate's Conditional Default"@en ;
    schema:description "Found 2026-07-06: applied ontology-cross-reference-gate.ttl Requirement C's default (add DBpedia cross-references) to ontology.ttl without eliciting whether this user wants that in this file, since the gate's own text says 'unless explicitly waived by the user.' User corrected: 'You are supposed to elicit guidance if I haven't provided clear operational preferences.' Any gate phrased with a user-conditioned exception must be elicited explicitly, not assumed, whenever no prior preference already covers it."@en .

:step-elicitBeforeConditionalDefault a schema:HowToStep ;
    schema:position 120 ;
    schema:name "Elicit user preference before applying a gate's user-conditioned default, rather than assuming it"@en ;
    schema:text "When a gate's own text names a user-conditioned exception and no prior preference already answers it, elicit the user's preference before writing anything that depends on the answer."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/elicit-before-conditional-default.ttl>, <howto/ontology-cross-reference-gate.ttl> .

:step-resolverDoubleEncodingGate a schema:HowToStep ;
    schema:position 121 ;
    schema:name "Never wrap an already resolver-wrapped URL a second time — grep every call site of an IRI-vs-resolver-URL helper pair before declaring a fix complete"@en ;
    schema:text "When a generator has two IRI helpers (e.g. a raw-IRI function and a resolver-wrapping function), a render function that itself calls the resolver wrapper must only ever receive the raw IRI, never the pre-wrapped URL. Passing a resolver-wrapped URL into another rlink()/resolver call double-encodes it (describe/?url=<percent-encoded-describe-url>), which decodes to another resolver URL instead of the entity IRI and silently fails to resolve. Grep the entire generator for every call site of both helpers before declaring the fix complete — fixing only the call sites you remember reproduces the same bug in the sites you missed. validate-harness-contract.py now greps for the double-encoding signature (%2523 or %253A%252F%252F inside a describe/?url= href) as a standing gate."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/resolver-double-encoding-gate.ttl> .

:step-unclosedAnchorSwallowsBlock a schema:HowToStep ;
    schema:position 122 ;
    schema:name "BLOCKING GATE — every <summary><a>...</a></summary> anchor must be explicitly closed; an unclosed <a> swallows the sibling <pre>/query-text block"@en ;
    schema:text "Recurring defect, flagged by the user a second time on 2026-07-08 in aaron-levie-enterprise-ai-agent-issues-semantic-web-virtuoso-claude_sonnet_5-1.html's footer SPARQL workbench accordion — a <summary><a href=...> resolver link left without its closing </a> before </summary> causes the browser's HTML parser to keep the anchor open across the </summary> boundary, so the following <pre class=\"sparql-code\"> query-text block renders entirely as link text (blue/underlined, sometimes visually indistinguishable from 'missing' text at a glance). The query text was NOT actually missing from the DOM or the textarea .value — it was present but visually disguised as a giant hyperlink, which is why prior fixes to the SPARQL escape/newline gates (step-sparqlHtmlEscape, step-sparqlBtnMandatory) did not catch it: those gates check for escaping and encoding correctness, not tag closure. Root cause in this case: the </a> was dropped during template adaptation (surgical text swap of the accordion title) from the reuse-first source candidate (how-to-plagiarize-talisman-claude_sonnet_5-1.html), which had it correctly closed. MANDATORY GREP GATE before delivering any HTML infographic with a footer SPARQL accordion: grep -oE '<summary><a[^>]*>[^<]*</summary>' file.html — any match (i.e. a <summary><a> whose next tag is </summary> with no intervening </a>) is a FAIL. Also visually verify by expanding the accordion in the live preview and confirming the query text renders in normal (non-link) color, not just checking the JS-populated textarea's .value in isolation — the textarea and the static <pre> accordion are two separate elements and one being correct does not guarantee the other is."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/sparql-html-escape-gate.ttl> .

:step-exampleIriAntiPattern a schema:HowToStep ;
    schema:position 123 ;
    schema:name "example.com/example.org IRIs in illustrative RDF/YAML-LD/JSON-LD examples are an anti-pattern — check the primary source for a real example first, else use relative hash IRIs"@en ;
    schema:text "Before inventing an illustrative code example, check whether the document's primary source already has a real one to reproduce; if none exists, use relative hash IRIs scoped to the document's own base — never example.com/example.org placeholder domains or a non-dereferenceable urn: scheme."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/example-iri-anti-pattern.ttl> .

# ── Step 124: Destructive Command Guard ──────────────────────────────────────

:step-destructiveCommandGuard a schema:HowToStep ;
    schema:position 124 ;
    schema:name "BLOCK: never execute destructive shell commands — force push, recursive delete, fork bomb, disk wipe, pipe-to-shell"@en ;
    schema:text "Never execute destructive shell commands including: git push --force/-f, git reset --hard, rm -rf/-r, dd if=/dev/zero, mkfs, chmod -R 777, :(){ :|:& };:, curl|bash, wget|bash, mv /* /dev/null, shutdown/reboot/halt. These patterns are blocked unconditionally — no context or task justifies their execution."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/destructive-command-guard.ttl> .

# ── Step 125: OpenLink Brand Color Scheme Is the Default HTML Infographic Palette ──

:step-openlinkBrandColorScheme a schema:HowToStep ;
    schema:position 125 ;
    schema:name "Default HTML infographic CSS theme blocks (:root / dark) to the OpenLink brand palette unless the user names a different site to match"@en ;
    schema:text "All HTML infographics generated by kg-generator + rdf-infographic-skill default their :root / html[data-theme=dark] / @media(prefers-color-scheme:dark) CSS variable blocks to the OpenLink Software brand palette, unless the user names a different site or brand to match for a specific document."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/openlink-brand-color-scheme.ttl>, <howto/infographic-authoring.ttl> .

# ── Step 126: DAV-Hosted URL Is the Default Public Rendition for Cross-Document Links ──

:step-davPublicUrlDefault a schema:HowToStep ;
    schema:position 126 ;
    schema:name "Links to a DIFFERENT generated document default to its public https://linkeddata.uriburner.com/DAV/demos/daas/{filename} URL, never a filesystem-relative or file: path"@en ;
    schema:text "When a generated HTML or Markdown artifact links to a different, separately-generated document (not its own companion .ttl/.md/.html triplet), the default target is that document's public DAV-hosted URL, not a filesystem-relative path — unless the user explicitly overrides the destination for that link."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/dav-public-url-default.ttl> .

# ── Step 127: Reuse Resolver-Dereferenceable Local Ontology Terms From ANY Prior Task Run ──

:step-crossDocumentLocalTermReuse a schema:HowToStep ;
    schema:position 127 ;
    schema:name "Before minting any new local ontology term, check whether a resolver-dereferenceable equivalent already exists from ANY prior doc-collection production run — not only a topically-related companion document"@en ;
    schema:text "Before minting a new local DefinedTerm, class, or property in any doc-collection production task, check this agent's prior published output for an equivalent resolver-dereferenceable term and reuse it via its bound prefix, regardless of topical relation, to avoid custom term bloat."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/cross-document-local-term-reuse.ttl>, <howto/ontology-discovery.ttl>, <howto/canonical-entity-iri-denotation.ttl>, <entities/concepts.ttl> .

# ── Step 128: Reader-Facing Copy Gate for HTML Infographics ─────────────────

:step-readerFacingCopyGate a schema:HowToStep ;
    schema:position 128 ;
    schema:name "Reader-facing HTML copy must not expose artifact mechanics unless the section is explicitly technical"@en ;
    schema:text "In generated HTML infographics and article collections, visible main-flow headings, subtitles, card blurbs, and section intros must help readers understand the topic, not describe RDF/entity/extraction/resolver mechanics. Remove nonessential subtitles when the heading and content already carry the section."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/reader-facing-copy-gate.ttl>, <howto/ui-ux-expert-persona.ttl>, <howto/infographic-authoring.ttl> .

# ── Step 129: Workbench Brevity Gate for Technical Sections ─────────────────

:step-workbenchBrevityGate a schema:HowToStep ;
    schema:position 129 ;
    schema:name "Technical workbenches must be compact and non-redundant while preserving required controls"@en ;
    schema:text "In SPARQL, KG settings, query, and other technical workbench sections, expose only the controls, labels, status text, and links needed to perform the task. Avoid stacked labels, explanatory paragraphs, duplicate query previews, and repeated format guidance when controls already carry that meaning."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/workbench-brevity-gate.ttl>, <howto/footer-sparql-explorer-gate.ttl>, <howto/ui-ux-expert-persona.ttl> .

# ── Step 130: Chat-Response File Links Must Be Portable ──────────────────────

:step-chatResponsePortableLinks a schema:HowToStep ;
    schema:position 130 ;
    schema:name "Chat-response markdown file links must use paths relative to the working directory, never absolute local filesystem paths"@en ;
    schema:text "An absolute local path used as a chat-response markdown link href is functionally a file: URL once opened off this machine, so compute it relative to the working directory instead, even across '../' traversal to a sibling directory."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/chat-response-portable-file-links.ttl>, <howto/dav-public-url-default.ttl>, <howto/artifact-routing.ttl> .

# ── Step 132: Entity Registry Census Verification ────────────────────────────

:step-entityRegistryCensusVerification a schema:HowToStep ;
    schema:position 132 ;
    schema:name "Verify registry additions against already-read documents; exclude corpus owl:sameAs errors surfaced by a census rather than propagating them"@en ;
    schema:text "Before writing a schema:Person, DefinedTerm, or TBox registry entry, grep the actual source document for its real asserted IRI instead of guessing a plausible slug, and manually review any census-surfaced owl:sameAs cluster before reuse since corpus documents can themselves contain entity-resolution errors."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/entity-registry-census-verification.ttl>, <howto/external-iri-verification.ttl>, <entities/people.ttl> .

# ── Step 133: HTTP Interactions Use curl First; MCP Tools Are Last Resort ────

:step-curlFirstMcpLastResort a schema:HowToStep ;
    schema:position 133 ;
    schema:name "Use curl (or other local CLI tools) for HTTP interactions; invoke MCP server tools only as a last resort"@en ;
    schema:text "For fetching pages, WebDAV PROPFIND/PUT, feed retrieval, and endpoint probing, always reach for curl and local CLI utilities first. MCP tools (execute_sql_query, EXECUTE_SQL_SCRIPT, WEB_FETCH, etc.) are a last resort, justified only when the task genuinely requires privileged server-side access that no local CLI path (curl, isql with known credentials, filesystem) can provide. Stated by Kingsley on 2026-07-16 after an MCP SQL call was used where a curl PROPFIND sufficed."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/curl-first-mcp-last-resort.ttl> .

# ── Step 134: VSP Artifacts Route to a vsps/ Subfolder of the Model Output Root ──

:step-vspArtifactsFolder a schema:HowToStep ;
    schema:position 134 ;
    schema:name "Generated VSP (Virtuoso Server Page) artifacts go in a vsps/ subfolder under the model-specific output root"@en ;
    schema:text "VSP pages and their deployment companions (SQL deploy scripts, READMEs) are routed to {model-root}/vsps/ — a sibling of rdf/, md/, webpages/, and saved-prompts/ under the output root resolved by artifact-routing step-outputDirs (e.g. Claude models → {LLM_ROOT}/Claude Generated/vsps/). Never leave them in the working repo or a generator work folder. Stated by Kingsley on 2026-07-16 when a weblog index.vsp was first placed in a repo-root vsp-weblog/ folder."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ── Step 134: WebDAV Weblog Engine Gate ─────────────────────────────────────

:step-webdavWeblogEngineGate a schema:HowToStep ;
    schema:position 138 ;
    schema:name "WebDAV weblog requests require a VSP/isql engine bundle unless static HTML is explicit"@en ;
    schema:text "When the user asks to generate a weblog from a WebDAV URL, invoke weblog-from-webdav and treat the request as a VSP/isql weblog-engine task. First inspect the DAV collection and search prior memory for VSP/WebDAV weblog deployments. If no executable index.vsp weblog is present, produce a complete deployable bundle: index.vsp, deploy SQL using string_output() + DAV_RES_UPLOAD_STRSES_INT, route SQL when needed, optional facet/category SQL when requested, README/run notes, and verification queries. Static HTML is only an optional preview and only satisfies the request when the user explicitly asks for static-only output."@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/webdav-weblog-engine-gate.ttl> .

# ── Step 135: Resolvable IRI Payload Presentation ───────────────────────────

:step-resolvableIriPayloadPresentation a schema:HowToStep ;
    schema:position 135 ;
    schema:name "When result payloads contain resolvable IRIs, hyperlink the label and omit redundant raw-IRI columns by default"@en ;
    schema:text "For chat-response tables or lists derived from query/tool payloads that include both a human label/title and its resolvable IRI, render the human label/title as a Markdown hyperlink to that IRI and drop any redundant separate IRI column unless the user explicitly asks for raw IRIs, debugging output, or machine-readable tabular columns."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/resolvable-iri-payload-presentation.ttl> .

# ── Step 136: Screencast Distribution Artifacts ─────────────────────────────

:step-screencastDistributionArtifacts a schema:HowToStep ;
    schema:position 136 ;
    schema:name "HTML documents that embed screencasts are screencast distribution artifacts and go in the model screencasts/ folder"@en ;
    schema:text "When an HTML document embeds or primarily distributes a screencast, route that HTML wrapper plus caption sidecars, narration assets, and the video files to {model-root}/screencasts/ rather than {model-root}/webpages/. Use bundle-relative media links, and apply the same hero-meta and footer on-behalf-of attribution rules used for generated HTML artifacts."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/screencast-distribution-artifacts.ttl>, <howto/artifact-routing.ttl>, <howto/kg-curation-attribution.ttl>, <howto/infographic-authoring.ttl> .

# ── Step 137: HowTo Authoring Structure ─────────────────────────────────────

:step-howtoAuthoringStructure a schema:HowToStep ;
    schema:position 137 ;
    schema:name "Author howto/*.ttl files as multi-step queryable HowTos with anchored cross-references, and parse-validate before finishing"@en ;
    schema:text "Every howto/*.ttl must use one schema:HowToStep per requirement, anchor cross-references to preferences.ttl via #step-… fragments (never the bare document), and be parse-validated with a Turtle parser before the task ends."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/howto-authoring-structure.ttl> .

# ── Step 139: Python Default; JavaScript Only When Explicitly Required ─────

:step-pythonDefaultJsFallback a schema:HowToStep ;
    schema:position 139 ;
    schema:name "Write new scripts in Python by default; use JavaScript/Node only when explicitly required"@en ;
    schema:text "For new standalone scripts, default to Python and use JavaScript/Node only when explicitly required."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/python-default-js-fallback.ttl> .

# ── Step 140: Diagram Artifacts Route to a visualizations/ Subfolder of the Model Output Root ──

:step-visualizationsFolder a schema:HowToStep ;
    schema:position 140 ;
    schema:name "Generated diagram artifacts (draw.io, Mermaid exports, etc.) go in a visualizations/ subfolder under the model-specific output root"@en ;
    schema:text "Standalone diagram files (.drawio/mxGraph XML, exported Mermaid, etc.) are routed to {model-root}/visualizations/, a sibling of rdf/, md/, webpages/, saved-prompts/, and vsps/ under the output root resolved by artifact-routing step-outputDirs."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/artifact-routing.ttl> .

# ═══════════════════════════════════════════════════════════════════════════
# ── Session Bootstrap Protocol (positions 141-144) ────────────────────────
# ═══════════════════════════════════════════════════════════════════════════

# ── Step 141: Identity Establishment ───────────────────────────────────────────

:step-identityEstablishment a schema:HowToStep ;
    schema:position 141 ;
    schema:name "BLOCKING GATE — establish identity at session start: resolve credentials, verify WebID-TLS, emit identity report"@en ;
    schema:text """At session start, after memory loading and model identity resolution, establish identity:

1. Resolve credentials root (step-resolveCredentialsRoot)
2. Verify WebID-TLS credentials (step-verifyCredentials)
3. RE-READ the output template in agent-identity.ttl (:workExample-triggerAResponse) before composing the report
4. Emit identity report with verified badges per the template format

This step establishes WHO the agent is. It does NOT set identity mode — that happens in step-identityMode after preferences establishment.

OUTPUT: Identity verified (or unverified with reason), delegation status noted (informational only)."""@en ;
    onto:hasTrigger onto:triggerSessionStart ;
    rdfs:seeAlso <howto/identity-establishment.ttl>, <howto/agent-identity.ttl> .

# ── Step 142: Preferences Establishment ────────────────────────────────────────

:step-preferencesEstablishment a schema:HowToStep ;
    schema:position 142 ;
    schema:name "Confirm behavioral contract loaded — one-time report at session start"@en ;
    schema:text """At session start, after identity establishment, confirm the behavioral contract:

1. Count standing instructions in preferences.ttl
2. Note recent additions (last 3-5 steps)
3. Confirm memory load path (file reads or SPARQL)
4. Emit brief confirmation

This is a one-time report. Updated editions only on explicit user request.

OUTPUT: Preferences confirmed (instruction count, recent additions, load path)."""@en ;
    onto:hasTrigger onto:triggerSessionStart ;
    rdfs:seeAlso <howto/preferences-establishment.ttl> .

# ── Step 143: Identity Mode ───────────────────────────────────────────────────

:step-identityMode a schema:HowToStep ;
    schema:position 143 ;
    schema:name "Set identity mode — default agent-only; delegation only if explicitly asserted"@en ;
    schema:text """At session start, after preferences establishment, set identity mode:

DEFAULT: agent-only (no delegation)
:session onto:identityMode :identityModeAgentOnly .

OVERRIDE: Only if user explicitly asserts delegation:
- "use delegation"
- "my credentials"
- "on behalf of"
- Any explicit delegation request

CRITICAL: Delegation corroboration is INFORMATIONAL ONLY — it does NOT automatically set delegation mode. Identity mode can be overridden per task.

DOWNSTREAM: step-curlAuth and step-remoteWebdavUpload read :session onto:identityMode to determine certificate and header usage."""@en ;
    onto:hasTrigger onto:triggerSessionStart ;
    rdfs:seeAlso <howto/identity-mode.ttl> .

# ── Step 144: Progressive Context Loading ──────────────────────────────────────

:step-progressiveContextLoading a schema:HowToStep ;
    schema:position 144 ;
    schema:name "Load prior session context per task — progressive disclosure, not session-start bootstrap"@en ;
    schema:text """Load prior session context PER TASK, not at session start:

TRIGGERS for context loading:
- Task references a specific prior session or artifact
- Task involves correcting or updating prior work
- Task requires accumulated patterns or corrections
- User explicitly asks to check prior sessions

PROCEDURE:
1. Assess if task needs prior context (step-assessContextNeed)
2. If yes, load 3-5 most relevant sessions (step-loadRelevantSessions)
3. Record what was loaded (step-recordContextLoad)

This replaces the old step-semanticSessionBootstrap which loaded context at session start. Progressive disclosure saves tokens and improves relevance."""@en ;
    onto:hasTrigger onto:triggerSkillInvocation, onto:triggerNamedWorkflow ;
    rdfs:seeAlso <howto/progressive-context-loading.ttl> .

# ── Step 145: Full Skills Contract Applies Regardless of Request Phrasing ──────

:step-fullSkillsContractAlwaysApplies a schema:HowToStep ;
    schema:position 145 ;
    schema:name "BLOCKING GATE — RDF+HTML collection requests always get the full kg-generator/rdf-infographic-skill contract, not a lighter cut"@en ;
    schema:text """Corrected 2026-07-22: a Buzz/Block/Jack-Dorsey thesis-and-value-prop meshup was delivered with only 5 FAQ items, 6 glossary terms, no HowTo section, and plain (non-resolver) hrefs for entity mentions in body prose — because the request said 'RDF-Turtle and HTML collection... styled as thesis and value prop analysis' rather than 'infographic', which was wrongly read as license to scope down.

RULE: softer request phrasing (no literal 'infographic' or 'KG explorer') does NOT reduce the contract. Any RDF+HTML(+MD) collection requires:
  1. FAQ section: >= 10 schema:Question entities, each with schema:parentItem back to the schema:FAQPage.
  2. Glossary: >= 10 schema:DefinedTerm entities in the schema:DefinedTermSet.
  3. A schema:HowTo section with schema:HowToStep entities whenever the source material contains ANY procedural content (setup/quick-start commands, configuration steps, etc.) — do not omit it just because the user didn't ask for a 'howto' by name.
  4. Every entity heading or mention in BODY PROSE (not just the footer) must be a resolver-wrapped hyperlink built from the companion TTL's own entity IRIs — thesis quotes, principle/value-prop/open-question headings, and inline source citations all qualify. Footer/hero-meta tool-attribution links (kg-generator, rdf-infographic-skill, URIBurner, Virtuoso, LLM homepage) remain the documented exception and use canonical homepages, not the resolver.

BLOCKING VERIFICATION before calling any such deliverable done:
  grep -c 'describe/?url=%23' file.html   # MUST be 0 (bare-fragment hrefs)
  grep -oc 'linkeddata.uriburner.com/describe/?url=' file.html   # should be a large, non-trivial count spanning body sections, not just the footer"""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/full-skills-contract-always-applies.ttl>, <howto/faq-entity-iri-gate.ttl>, <howto/entity-href-companion-ttl.ttl> .

# ── Step 146: Structural Contract Details — FAQ Accordion vs. Glossary Index vs. Nav Fade ──

:step-structuralContractDetails a schema:HowToStep ;
    schema:position 146 ;
    schema:name "BLOCKING GATE — three specific rdf-infographic-skill/SKILL.md structural requirements missed on first pass, caught by user review (2026-07-23)"@en ;
    schema:text """A single Buzz meshup document needed three separate corrections after delivery because the exact structural contract (Core Architecture § Document Structure, and the Navigation Control section) in rdf-infographic-skill/SKILL.md was not re-read before building those sections:

1. FAQ MUST be an accordion with smooth expand/collapse (SKILL.md item 7: 'FAQ Accordion — Common questions with smooth expand/collapse'). The exact markup is in howto/faq-entity-iri-gate.ttl step-writeHtmlHref: `<div class="faq-q" role="button" tabindex="0">` wrapping the resolver-linked question `<a>` (with `onclick="event.stopPropagation()"`) plus a chevron indicator — NOT a native `<details>/<summary>` disclosure (first delivered), and NOT `<a>` nested inside `<button>` (the anti-pattern the same file warns against, found even in an older reference file). Toggle via a `toggleFaq(el)` JS function that adds/removes an `.open` class on the parent `.faq-item`; CSS uses `max-height` transition on a sibling `.faq-a` panel, not the `hidden` attribute.

2. Glossary is SKILL.md item 8: 'Glossary/Definitions — Interactive entity index with external links' — NOT an accordion. It does not need expand/collapse. 'Interactive' here means resolver-linked term names, best rendered as a card grid (`.gloss-card` — term name as a resolver-wrapped `<h4><a>`, definition as plain text below), not a toggle widget. Do not add accordion behavior to the glossary by false analogy with the FAQ fix.

3. The floating nav MUST implement a 2-minute inactivity fade with a dynamically created reactivation marker (SKILL.md 'Navigation Control' section: opacity 0 + pointer-events none after 2 minutes of no mousemove/keydown/scroll/click/touchstart; a small ☰ marker at the same top/right position, one z-index above, becomes visible; any activity or clicking the marker resets the timer and restores the nav). This requires a SECOND IIFE separate from the drag+collapse-toggle IIFE — building only the drag+collapse IIFE (as first delivered) silently omits this required behavior with no visible symptom until a user waits two minutes.

Root cause common to all three: sections were built from memory of a similar prior document rather than re-reading the exact Core Architecture / Navigation Control text in rdf-infographic-skill/SKILL.md before writing that section's HTML/CSS/JS."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/full-skills-contract-always-applies.ttl>, <howto/faq-entity-iri-gate.ttl> .

# ── Step 147: Redundant-Lede Check Re-Applies on Every Edit Touching That Paragraph ──

:step-redundantLedeRecheckOnEveryEdit a schema:HowToStep ;
    schema:position 147 ;
    schema:name "BLOCKING GATE — re-run the heading-redundancy test every time a lede paragraph is touched, not just once at delivery"@en ;
    schema:text """Corrected 2026-07-23 (third time on the same document): the FAQ lede 'Eighteen questions this meshup answers, each backed by a schema:Question entity in the companion RDF — click a question to look up its entity.' was flagged as redundant with its self-explanatory 'FAQ' heading, fixed, then SILENTLY REINTRODUCED across several follow-up edits — each time new FAQ/glossary items were added, the count number ('Ten' -> 'Eleven' -> ... -> 'Eighteen') was mechanically updated in place without re-asking whether the sentence should exist at all. The same 'Each X links to its RDF :Y entity' / 'click a term to look up its entity' boilerplate had also crept back into the Principles, Value-props, and Open-questions ledes.

ROOT CAUSE: treating a lede paragraph as a template to patch (update the count, update the label) rather than re-evaluating it from scratch against preferences.ttl step-fullSkillsContractAlwaysApplies's redundancy principle every time it is touched — including edits that only change a number or a count, not just edits that rewrite the sentence.

RULE: any time a lede/subtitle paragraph is edited for ANY reason (including a mechanical count update after adding new FAQ/glossary/list items), re-run the test: does this sentence say something the heading itself doesn't already convey? If not — including generic UI-affordance boilerplate like 'click X to look up its entity' repeated near-verbatim across multiple sections — cut it, don't just update the number inside it. Sections already correctly emptied (HowTo, Comparison) are the reference: heading alone, no lede line, when the heading is self-explanatory."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/full-skills-contract-always-applies.ttl> .

# ── Step 148: Nav Panel Resize + Manual-Hide Added to rdf-infographic-skill/SKILL.md Contract ──

:step-navResizeAndManualHide a schema:HowToStep ;
    schema:position 148 ;
    schema:name "Nav panel MUST be resizable when expanded AND manually hideable via the same fade/marker path — added to rdf-infographic-skill/SKILL.md 2026-07-23 at user's explicit request"@en ;
    schema:text """User-requested contract update, applied directly to rdf-infographic-skill/SKILL.md (Core Architecture item 5 already said 'resizable' but gave no implementation; Navigation Control Best Practices and the Interactive Components summary both said 'no separate close/restore elements' with no resize implementation guidance and no manual-hide concept at all):

1. RESIZE: native CSS `resize:both; overflow:auto;` on the nav panel, active only when expanded (`resize:none` while `.collapsed`). Must raise the expanded max-height/max-width caps (e.g. from a fixed 460px to something like `max-height:80vh`) — a tight max-height silently blocks the native resize handle from doing anything even though `resize:both` is set.

2. MANUAL HIDE: a small icon in the header bar next to the existing collapse toggle (+/−) that calls the SAME `fadeOut()` function already built for the 2-minute inactivity timer — exposed via e.g. `window.__navFadeOut = fadeOut` inside the fade IIFE, called from the hide button's click handler in the drag/toggle IIFE. This is a manual TRIGGER for the existing fade/restore path, not a second independent close/restore control — restoring still happens through the single ☰ reactivation marker either way. This reconciles the new manual-hide requirement with the pre-existing 'no separate close/restore elements' rule: that rule prohibits a second, different restore mechanism, not a second way to trigger the one that already exists.

BLOCKING GOTCHA: the hide button's click handler MUST call `event.stopPropagation()` before invoking fadeOut() — the existing inactivity-fade IIFE attaches a `document.addEventListener('click', reset)` global listener (any click anywhere resets the fade timer and restores the nav), so without stopPropagation the hide button's own click bubbles to that document listener and immediately undoes the fade it just triggered.

Verified live 2026-07-23 on the Buzz/Block document: resize handle appears at the panel's bottom-right corner when expanded and is absent when collapsed; clicking the hide icon fades the nav immediately without being undone by the global click-reset listener; clicking the resulting ☰ marker restores it."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <../rdf-infographic-skill/SKILL.md> .

# ── Step 149: Manual Nav-Hide Must Ignore Ambient Activity Until Marker Is Clicked ──

:step-manualHideMustStick a schema:HowToStep ;
    schema:position 149 ;
    schema:name "BLOCKING GATE — manual nav-hide silently undone by the next mousemove/scroll unless gated by a manuallyHidden flag; caught by user report 'click on [x] doesn't stick' 2026-07-23"@en ;
    schema:text """The Step 148 manual-hide fix (stopPropagation on the hide button's own click, so it doesn't immediately re-trigger the document-level activity listener in the SAME tick) was necessary but not sufficient. The inactivity-fade IIFE's reset() function is also attached to document-level mousemove/scroll/keydown/touchstart listeners so the nav restores after the user becomes active again post-inactivity-fade — correct for THAT case. But reset() has no way to distinguish 'nav faded because the user was idle for 2 minutes' from 'nav faded because the user just clicked hide' — so the very next ambient mouse movement (not even a click) silently restored the nav, making the manual-hide button look non-functional ('doesn't stick') even though the click itself worked perfectly.

FIX: add a `manuallyHidden` boolean in the closure shared by fadeOut/reset. The manual-hide trigger (`window.__navFadeOut`) sets `manuallyHidden = true` before calling fadeOut(). reset() checks `if (manuallyHidden) return;` as its first line — so ambient activity becomes a no-op while manually hidden. Only the reactivation marker's OWN click handler (a separate `restoreFromMarker()` function, not the generic activity-triggered `reset`) clears `manuallyHidden = false` and then calls reset() for real. The auto-fade timer path (`setTimeout(fadeOut, TIMEOUT)`) never sets the flag, so its normal any-activity-restores behavior is untouched.

Verified live 2026-07-23: clicked hide in collapsed nav state, then exercised real hover + scroll + mousemove (not just a JS .click() dispatch, which never reproduces this bug since it skips real mousemove) — nav stayed hidden through all of it; clicking the ☰ marker still restored it correctly. Recorded in rdf-infographic-skill/SKILL.md as a sub-bullet under 'Is manually hideable' alongside the Step 148 stopPropagation gotcha — the two are easy to fix one at a time and mistake the first for a complete fix."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <../rdf-infographic-skill/SKILL.md> .

# ── Step 150: Ontology Cross-Reference Gate Requires the Registry Write-Back, Not Just a Local Check ──

:step-ontologyRegistryWriteBack a schema:HowToStep ;
    schema:position 150 ;
    schema:name "BLOCKING GATE — checking entities/ontology-terms.ttl before minting a local class is only half the gate; the OTHER half is registering the new re-mint back into the registry"@en ;
    schema:text """Caught by user question 2026-07-23: while building buzz-block-thesis-value-prop, :KeyPrinciple and :ComparisonDimension were minted as document-local classes with an inline TTL comment noting 'mirrors the corpus-wide generator-template pattern in agent-rdf-memory/entities/ontology-terms.ttl' — but entities/ontology-terms.ttl was never actually re-opened and edited to add the new document's IRIs to those two classes' existing owl:equivalentClass lists. Both terms were ALREADY canonical corpus terms (KeyPrinciple: 5 prior re-mints; ComparisonDimension: 2 prior re-mints) before this document existed — this was the exact 'check the registry' scenario the cross-document-local-term-reuse rule (Step 127) is about, and the check happened (the comment proves it), but the write-back half was skipped.

RULE: the ontology cross-reference gate has TWO halves, both required, neither optional:
  1. CHECK — before minting any generator-template-style analysis class (a class describing 'a named X extracted from/about a source document,' not a domain-specific one), grep entities/ontology-terms.ttl for an existing canonical class with the same or overlapping meaning.
  2a. If found — either reuse the canonical IRI directly in the new document (preferred when practical), OR mint document-locally per established corpus convention AND immediately add the new document's IRI to that canonical class's owl:equivalentClass list in entities/ontology-terms.ttl, updating the re-mint count in its rdfs:comment. Do not defer this to 'a future census pass' — the census-based cleanup model only works if every session that mints a re-mint also performs its own write-back; treating the registry as read-only defeats its purpose.
  2b. If NOT found (genuinely new concept, as with :ValueProposition and :OpenQuestion in this same document) — register the new class in entities/ontology-terms.ttl's 'Reusable classes already correctly shared' section (the karp:CriticalPerspective exemplar pattern: rdfs:label, rdfs:comment stating what was checked against and that future documents should reuse the IRI, rdfs:isDefinedBy pointing at the defining document's DAV URL) so the NEXT document that needs the same concept can discover and reuse it by IRI instead of re-minting a 3rd/4th/5th disjoint copy.

Both halves were completed retroactively for this document 2026-07-23 (KeyPrinciple and ComparisonDimension added as new equivalentClass entries; ValueProposition and OpenQuestion registered as new discoverable corpus terms) — but the gate should close in the SAME session the class is minted, not after a user has to ask why it didn't."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/cross-document-local-term-reuse.ttl>, <howto/ontology-cross-reference-gate.ttl>, <entities/ontology-terms.ttl> .

# ── Step 151: Fixed-Background UI Regions Must Pin Text Colors, Never Use Theme Variables ──

:step-fixedBackgroundColorPinning a schema:HowToStep ;
    schema:position 151 ;
    schema:name "Any UI region with a hard-coded (non-theme-switching) background must pin its text/border colors to literal values — never theme variables like var(--text) or var(--muted)"@en ;
    schema:text """Caught 2026-07-23 on the URIBurner DaaS weblog (weblog-from-webdav facet template): the sidebar .panel background is hard-coded to a dark navy gradient in BOTH themes, but .facet-name used color: var(--text) and the panel's labels/dates used var(--muted). In dark theme these resolve to light ink and the bug is invisible; in light theme --text becomes #172838 (dark ink) — dark text on a dark panel, rendering the categories facet unreadable. The defect was latent from the start and only surfaced when the page was viewed in light theme.

RULE: when an element's background is fixed (does not change with the light/dark theme toggle or prefers-color-scheme), every piece of text, border, and accent inside it must use literal colors (or dedicated fixed-region variables) chosen for that one background — NOT the global theme variables, which flip per theme and will break contrast in exactly one of the two modes. Audit BOTH themes whenever a fixed-background region is styled; testing only the theme that happens to be active masks the failure. Fix applied 2026-07-23 to all weblog-from-webdav templates (repo + ~/.codex copies) and the four Claude-variant deploy scripts: panel text pinned to #d9e6f0/#9fb4c4, facet chips to #e8f2fa on cyan-tinted fills, accents to the fixed --openlink-cyan/--openlink-blue brand values."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/fixed-background-color-pinning.ttl>, <howto/ui-ux-expert-persona.ttl>, <howto/openlink-brand-color-scheme.ttl> .

# ── Step 152: Prior-Session Reads Default to LLM-Own Scope, Elicited Fresh Every Session ──

:step-sessionReadLlmScope a schema:HowToStep ;
    schema:position 152 ;
    schema:name "Reading agent-rdf-memory/sessions/ defaults to the current model's own history; elicit on the first read of each session whether to lift that filter — answer is session-scoped only, never persisted as a cross-session default"@en ;
    schema:text """Confirmed by the user 2026-07-23: agent-rdf-memory/sessions/ is shared across multiple LLM harnesses pointed at this same memory store (Claude, DeepSeek, Grok, GPT, GLM, etc. — see model-identity-resolution.ttl's per-model output paths). Session filenames encode the model (e.g. sessions/2026-07-14-deepseek_v4pro-pi.ttl).

RULE:
1. Default behavior for any read of agent-rdf-memory/sessions/*.ttl is to scope to files matching the CURRENT session's resolved model identity only — not cross-model.
2. The FIRST time in a session that a prior-session read is about to happen, elicit whether the user wants that filter applied or lifted (cross-model read instead), before performing that first read. This is the elicit-before-conditional-default pattern (step-elicitBeforeConditionalDefault) applied to session reads.
3. UNLIKE most elicited gate answers, this one is explicitly NOT promoted to a standing preferences.ttl default. The user confirmed: 'The elicited answer becomes the standing pref for the session only i.e., new sessions redo the dance.' Every new session re-elicits from scratch — do not skip Step 2 because a prior session already answered it, and do not write a rule here saying 'always scope' or 'always cross-model' based on any single session's answer."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/session-read-llm-scope-gate.ttl>, <howto/model-identity-resolution.ttl>, <howto/elicit-before-conditional-default.ttl> .

# ── Step 153: CORRECTION to Step 150 — Registry Write-Back Is Only Correct for Genuinely New Terms; an Existing Canonical Term MUST Be Reused via Bound Prefix, Never Re-Minted ──

:step-ontologyReuseNotWriteBack a schema:HowToStep ;
    schema:position 153 ;
    schema:name "CORRECTION 2026-07-23, same session: Step 150's fix was itself wrong for the KeyPrinciple/ComparisonDimension case — those already existed canonically, so the correct move was reuse-via-bound-prefix (cross-document-local-term-reuse.ttl step 3), not mint-locally-then-register-as-another-disjoint-variant"@en ;
    schema:text """User pressed twice in the same session: first 'did you apply the ontology fixes' (revealing Step 150's registry edit had silently failed, fixed via Bash), then 'does the ontology now follow the rules in prefs — the current edition doesn't' (revealing Step 150's fix, once actually applied, was ITSELF the wrong resolution).

WHAT STEP 150 GOT WRONG: it treated 'mint the class locally in the new document, then add the new document's IRI to the canonical term's owl:equivalentClass list in entities/ontology-terms.ttl' as the correct closing move for BOTH (a) genuinely new concepts and (b) concepts that already have a canonical registry entry. That's only correct for (a). howto/cross-document-local-term-reuse.ttl step-reuseExistingTerm is unambiguous for (b): '(a) Add an @prefix binding for the origin document's namespace, using ITS OWN canonical DAV URL as the IRI base... (b) Reference the existing term directly by its bound prefix... (c) Do NOT create a new local term with a different name for the same concept... never re-mint.' The registry's own header repeats this as a MUST: 'Future doc-collection tasks MUST reuse the canonical IRI directly instead of minting another local one.' Adding yet another owl:equivalentClass entry for a re-mint that could have been avoided entirely is exactly the pattern the registry exists to retroactively clean up — not something a new document should knowingly repeat now that the check has already surfaced an existing canonical term.

CORRECTED PROCEDURE (supersedes Step 150 for the 'existing canonical term found' branch):
  - Existing canonical term found in entities/ontology-terms.ttl → bind a new @prefix in the CONSUMING document to one of the term's existing owl:equivalentClass origin-document DAV URLs (any one — corpus census ties are broken arbitrarily per step-censusCanonicalIri) as that prefix's IRI base, then type instances directly against `{prefix}:{ClassName}` (e.g. `kpx:KeyPrinciple`). Do NOT declare a local `:ClassName a owl:Class` in the consuming document at all. No registry edit is needed — reuse of an existing dereferenceable IRI is not a new re-mint and creates no new disjoint variant to align.
  - No canonical term found (genuinely new concept, checked and confirmed absent) → Step 150's original procedure still applies: mint locally, register in entities/ontology-terms.ttl's 'Reusable classes already correctly shared' section (karp:CriticalPerspective exemplar) so the NEXT document reuses by IRI instead of re-minting.

Applied retroactively to buzz-block-thesis-value-prop 2026-07-23: :KeyPrinciple instances retyped to `kpx:KeyPrinciple` (prefix bound to thinkingmachines.ai/blog/interaction-models/#), :ComparisonDimension instances retyped to `cdx:ComparisonDimension` (prefix bound to the neo4j.com blog post), both local class declarations removed, and the registry equivalentClass/re-mint-count additions from Step 150 reverted since they no longer describe a real re-mint. :ValueProposition and :OpenQuestion (genuinely new, per Step 150's other branch) were left as-is — locally minted and registered for future reuse, which was already correct."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <../preferences.ttl#step-ontologyRegistryWriteBack>, <howto/cross-document-local-term-reuse.ttl>, <entities/ontology-terms.ttl> .

# ── Step 154: owl:Ontology Must Be Its Own Distinct Entity — Never a Second rdf:type Conflated Onto an Existing Resource ──

:step-ontologyIsDistinctEntity a schema:HowToStep ;
    schema:position 154 ;
    schema:name "rdfs:isDefinedBy's range is owl:Ontology — but the fix is a SEPARATE owl:Ontology resource, not typing the document root as owl:Ontology in addition to its existing type"@en ;
    schema:text """User caught this in two steps while reviewing buzz-block-thesis-value-prop, 2026-07-23. Step 1: locally-minted classes (:ValueProposition, :OpenQuestion, :hasStatusQuo, :hasBuzzApproach) had NO rdfs:isDefinedBy at all — added, but pointed at the document's own `<>` entity (typed schema:AnalysisNewsArticle). User: 'an owl:Ontology is the range of rdfs:isDefinedBy. That's an important rule that wasn't applied.' First fix attempt (WRONG): changed `<> a schema:AnalysisNewsArticle` to `<> a schema:AnalysisNewsArticle, owl:Ontology` — satisfies the range constraint technically but conflates two distinct entity kinds onto one IRI. User, interrupting immediately: 'An Ontology is its own entity type i.e., instance of owl:Ontology' — rejecting the conflation outright.

RULE: an owl:Ontology is never a second rdf:type bolted onto a resource that is already something else (a schema:CreativeWork document, a schema:AnalysisNewsArticle article, etc.). It must be modeled as its OWN distinct resource:
  1. Mint a separate IRI (e.g. `:ontology`, a fragment on the same document) typed SOLELY `a owl:Ontology` (plus rdfs:label/rdfs:comment describing what TBox fragment it covers).
  2. Link it from the containing document via `schema:hasPart :ontology` (or equivalent) — the document is the human-readable container; the ontology is the machine-consumable TBox fragment. These are different things even when co-located in the same file.
  3. Point every locally-minted class/property's `rdfs:isDefinedBy` at the DISTINCT ontology resource, never at the document root.

Applied to two documents same day: buzz-block-thesis-value-prop-claude_sonnet_5-1.ttl (4 local terms retargeted from `<>` to `:ontology`) and the corpus registry itself, entities/ontology-terms.ttl (which had the IDENTICAL conflation — `<> a schema:CreativeWork, owl:Ontology` — caught retroactively during this same correction pass; un-conflated the same way, 16 rdfs:isDefinedBy triples retargeted to a new `:ontology` resource). Validated via rdflib both times: exactly one owl:Ontology instance per file, zero remaining isDefinedBy triples pointing at a non-owl:Ontology-typed document root."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <entities/ontology-terms.ttl>, <../howto/cross-document-local-term-reuse.ttl>, <../preferences.ttl#step-ontologyReuseNotWriteBack> .

# ── Step 155: Screencast / Presentation HTML Naming Style ───────────────────

:step-screencastPresentationNaming a schema:HowToStep ;
    schema:position 155 ;
    schema:name "Name distributable screencast presentation HTML as {model-display-id}-{topic-slug}-presentation.html — never bare presentation.html"@en ;
    schema:text """Stated by the user 2026-07-24 after renaming presentation.html → grok-4.5-context-from-pdf-presentation.html and requesting the naming style be noted for future operations. Confirmed by prior-day pattern grok-4.5-context-presentation.html (2026-07-23).

RULE — two roles, two names:

1. DISTRIBUTABLE presentation (embeds the MP4 player, hero attribution, JSON-LD, downloads):
   Pattern: {model-display-id}-{topic-slug}-presentation.html
   Examples:
     - grok-4.5-context-from-pdf-presentation.html
     - grok-4.5-context-presentation.html
   Model display id: human-readable product form with version dots and hyphens as used in the UI (e.g. grok-4.5, claude-sonnet-5) — lowercase. Do NOT use session-file underscores (grok_4_5) or a bare generic name.
   Topic slug: short kebab-case phrase describing the content (context-from-pdf, context, 11-layer-stack, etc.).
   Suffix: always -presentation.html

2. RECORDING scene deck (scroll-snap slides used only as shot-scraper input):
   Prefer a functional name such as presentation-scenes-recording-deck.html inside the same screencasts/{bundle}/ folder. Do not brand the recording deck as the public presentation filename.

PROHIBITED for the public/distributable page: presentation.html, index-only-as-sole-player without a model-topic presentation file when the user expects a named presentation artifact, or reusing the recording-deck filename as the distribution page.

Cross-links: index.html (if present), storyboard.yml, and POSH/prefetch links must use the model-topic presentation filename after creation. Bundle still routes to {model-root}/screencasts/ per step-screencastDistributionArtifacts."""@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/screencast-distribution-artifacts.ttl>, <howto/artifact-routing.ttl> .

# ── Step 156: Screencast HTML MUST embed the MP4 player ─────────────────────

:step-screencastEmbedMp4 a schema:HowToStep ;
    schema:position 156 ;
    schema:name "Distributable screencast presentation HTML MUST embed the primary MP4 via HTML5 video — never download-only links"@en ;
    schema:text """BLOCKING GATE for screencast distribution HTML (the {model-display-id}-{topic-slug}-presentation.html page and any index player wrapper whose primary purpose is to present the recording).

REQUIREMENTS:
1. Include a visible in-document HTML5 <video controls> (playsinline recommended) that plays the primary deliverable MP4 inline.
2. Prefer the narrated mux as primary source when present: {basename}-with-voiceover.mp4; fall back to silent {basename}.mp4 and/or {basename}.webm as additional <source> elements.
3. Use bundle-relative src/href only (same folder) — never file: or absolute /Users/... paths.
4. Provide poster= when a poster frame exists; set a meaningful aria-label; keep a download fallback <a> only inside the video element's fallback content (for non-supporting browsers), not as the sole way to watch.
5. POSH rel=enclosure and JSON-LD VideoObject contentUrl remain required and MUST match the embedded primary file.
6. A page that only lists download links, redirects without a player, or embeds only an external non-bundle URL fails this gate.

Applies alongside step-screencastDistributionArtifacts (routing) and step-screencastPresentationNaming (filename). Companion procedure: howto/screencast-distribution-artifacts.ttl step-embedPrimaryMp4. Default skill behavior: screencast-recorder SKILL.md Step 6b / distribution HTML section."""@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/screencast-distribution-artifacts.ttl>, <howto/artifact-routing.ttl> .

# ── Step 157: Disambiguate FAQ/Glossary/HowTo/Table section labels ──────────

:step-disambiguatedSectionLabels a schema:HowToStep ;
    schema:position 157 ;
    schema:name "FAQPage/HowTo/Glossary/Table section entities must use '{Article Short Title} -- {Section Type}' as schema:name, never a bare generic label"@en ;
    schema:text "FAQPage, HowTo, glossary, and comparison Table section entities must set schema:name to '{Article Short Title} -- {Section Type}', never a bare generic label, preserving any prior descriptive text as schema:description."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/disambiguated-section-labels.ttl> .

# ── Step 158: Recurring miss — hero-meta on-behalf-of attribution omitted ────

:step-heroAttributionRecurringMiss a schema:HowToStep ;
    schema:position 158 ;
    schema:name "Hero-meta KG curation attribution (Step 47/61) is a pre-build gate, not a post-hoc nicety — re-check it explicitly on every generated HTML infographic before delivery"@en ;
    schema:text "Grep the generated HTML for the literal string 'KG curated by' and the generated RDF/JSON-LD for 'actedOnBehalfOf' as an explicit pre-delivery check on every generated artifact set, even when reusing a known-good template shell."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/kg-curation-attribution.ttl>, <#step-kgCurationAttribution> .

# ── Step 159: Reused template shells silently lack newer contract sections ──

:step-reusedTemplateContractDrift a schema:HowToStep ;
    schema:position 159 ;
    schema:name "A reused HTML template is a snapshot of the contract on its generation date — audit it feature-by-feature against the current SKILL.md before trusting it"@en ;
    schema:text "Grep a reused template for each named current-contract feature (KG Explorer label geometry/anchors, SPARQL GRAPH/FROM pattern, nav inactivity-fade/manual-hide/resize) before treating it as compliant."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/reuse-proven-patterns.ttl> .

# ── Step 160: /tmp/uyi PKCS#12 passphrase file format ───────────────────────

:step-p12PassphraseUyiFile a schema:HowToStep ;
    schema:position 160 ;
    schema:name "When PKCS#12 password is in /tmp/uyi (or user-named path): each line is KEY=VALUE — unlock with the VALUE of the first pair only"@en ;
    schema:text """Stated by the user 2026-07-30 after the agent failed to unlock link-in-bio-credentials-5/cert.p12 by treating whole lines of /tmp/uyi as bare passwords. SUPERSEDED AS PRIMARY 2026-08-18 by :step-p12PassphraseKeychainFirst — /tmp/uyi is now the FALLBACK, not the first source. Its parse remains exactly as recorded: lines are KEY=VALUE pairs; the principal p12 passphrase is the substring after the first '=' on the first non-empty line (first key-pair value). Never use the whole line, the key, or concatenated lines unless the user explicitly says otherwise. Never print, log, or store the value in memory files. Companion: howto/p12-passphrase-retrieval.ttl."""@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/p12-passphrase-retrieval.ttl>, <howto/session-governance.ttl>, <howto/verified-identity.ttl> .

# ── Step 161: Entity resolver-linking gates — first occurrence + RDF/HTML parity ──

:step-entityFirstOccurrenceAndParity a schema:HowToStep ;
    schema:position 161 ;
    schema:name "Resolver-link every named entity at its FIRST occurrence; every entity minted in the companion TTL must appear somewhere in the HTML"@en ;
    schema:text """Two gaps found 2026-07-30 on ontologies-agentic-systems-latent-space-mesh-claude_sonnet_5-1.html: (1) Frank Coyle, Emil Eifrem, Kingsley Idehen, Prasenjit Sarkar, Neo4j, OpenLink Software, and UC Berkeley were all named in the hero/intro paragraphs as plain unlinked text, only becoming resolver-linked later at a quote-card — the FIRST occurrence in reading order was left unlinked. (2) Two TTL entities ('lux', 'Oxford Semantic Technologies') never appeared anywhere in the HTML at all — an RDF/HTML parity gap. Both are now BLOCKING CHECKS before delivering any HTML infographic with resolver-linked entities: (a) for every named schema:Person/schema:Organization in the companion TTL, the first literal-name match in the HTML body must be inside a resolver <a href> anchor; (b) every schema:Person/Organization/DefinedTerm subject in the companion TTL must have at least one real mention in the HTML body or KG Explorer kgData."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/entity-href-companion-ttl.ttl> .

# ── Step 162: Frame single-source-article collections as notes about the article ──

:step-articleNotesFraming a schema:HowToStep ;
    schema:position 162 ;
    schema:name "Frame RDF+HTML collections built from a single source article as notes taken about that article"@en ;
    schema:text """Stated by Kingsley 2026-07-30 for the Latent Space 'Ontologies Are So Back' collection. When a kg-generator/rdf-infographic-skill collection is generated FROM a single named external article (including meshup variants that also cross-reference other corpus documents), frame it in schema:description, hero copy, and section labeling as notes/commentary taken about that article — not as a standalone publication, a definitive analysis, or the article's own official companion. This is a tone/description choice, not a scope reduction: the full harness contract (FAQ, glossary, HowTo, resolver-linking, RDF/HTML parity, KG Explorer, attribution) still applies in full."""@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/article-notes-framing.ttl> .

# ── Step 163: Locally-declared ontology terms must be used under their own namespace ──

:step-localTermNamespaceConsistency a schema:HowToStep ;
    schema:position 163 ;
    schema:name "A local ontology term declared correctly is still a gate violation if invoked under schema: (or any foreign prefix) instead of its own namespace"@en ;
    schema:text """Caught 2026-07-30 on ontologies-agentic-systems-latent-space-mesh-claude_sonnet_5-1.ttl: `:meshesWith` was correctly declared as a local rdf:Property (rdfs:domain/range, rdfs:isDefinedBy :), but the one place it was actually used asserted `schema:meshesWith` — fabricating a nonexistent schema.org term at the call site despite the declaration itself being correct. BLOCKING CHECK before delivery: for every term declared under the bare `:` prefix as a rdf:Property/rdfs:Class/owl:Class, grep the whole file for that term name immediately preceded by any OTHER declared prefix (schema:, dbr:, owl:, etc.) — any hit means the term was invoked under a namespace that doesn't own it, and must be corrected to the bare local form. Applies to every foreign vocabulary in scope, not schema.org alone."""@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/local-term-namespace-consistency.ttl> .

# ── Step 164: Keep filesystem agent-rdf-memory edits synced to an active Virtuoso instance ──

:step-filesystemVirtuosoSync a schema:HowToStep ;
    schema:position 164 ;
    schema:name "When a Virtuoso instance is in active use, mirror every filesystem edit to agent-rdf-memory via WebDAV (preferred) or SPARQL INSERT — immediately, not batched"@en ;
    schema:text """Stated by Kingsley 2026-07-30: localhost is the operator's Virtuoso instance for this setup, reachable via SPARQL at https://localhost/sparql and via WebDAV at https://localhost/DAV/home/kidehen/ (mounted locally at /Volumes/kidehen). SPARQL INSERT/LOAD and WebDAV copy are equivalent sync mechanisms; the operator's preference is WebDAV copy, targeting /Volumes/kidehen/rdf-import-test/{relpath} (mirroring agent-rdf-memory/{relpath} exactly, subfolders included) — this maps to named graph urn:dav:/DAV/home/kidehen/rdf-import-test/{relpath}. BLOCKING FINDING: this agent's own sandbox denies direct filesystem access to the mounted volume ('Operation not permitted'), so the reliable mechanism is a curl PUT against the DAV URL directly (https://localhost/DAV/home/kidehen/rdf-import-test/{relpath}), not `cp` to the mount — same underlying resource, different access path. Sync immediately after any write to preferences.ttl, ontology.ttl, index.ttl, howto/*.ttl, entities/*.ttl, or sessions/*.ttl during a session where Virtuoso is confirmed active (per the SessionStart SPARQL bootstrap succeeding) — never batch or defer, since the next session's SPARQL-first bootstrap reads Virtuoso directly and would silently serve a stale copy otherwise. This howto does not apply when the session's bootstrap fell back to filesystem-only mode."""@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/filesystem-virtuoso-sync.ttl> .

# ── Step 165: RDF output defaults to Turtle only — JSON-LD requires explicit request ──

:step-turtleOnlyDefaultNoImpliedJsonld a schema:HowToStep ;
    schema:position 165 ;
    schema:name "Never generate JSON-LD as a side effect of an HTML companion's format-toggle footer — Turtle only unless the user names JSON-LD explicitly"@en ;
    schema:text "Default every RDF+HTML generation to Turtle only; produce JSON-LD only when the user's own words name it in that session."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/turtle-only-default.ttl> .

# ── Step 166: Subsumption Plausibility Verification and Abduction (subclass + subproperty) ──

:step-subsumptionPlausibilityAbduction a schema:HowToStep ;
    schema:position 166 ;
    schema:name "Verify rdfs:subClassOf/rdfs:subPropertyOf placements structurally and textually, then abduce plausible missing axioms for terms left at a maximally generic superclass/superproperty"@en ;
    schema:text "Every rdfs:subClassOf and rdfs:subPropertyOf placement made during ontology generation must pass a structural fit check and a textual plausibility check, followed by an abduction re-scan that proposes missing axioms, with rationale, for terms left at a maximally generic superclass/superproperty."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/ontology-subsumption-plausibility.ttl>,
        <howto/ontology-cross-reference-gate.ttl#step-subpropertyReasoning>,
        <howto/ontology-cross-reference-gate.ttl> .

# ── Step 167: One canonical full-stack attribution surface per document — footer tech-grid, everywhere else a pointer ──

:step-attributionSingleCanonicalSurface a schema:HowToStep ;
    schema:position 167 ;
    schema:name "The full skills/LLM/server/KG-endpoint attribution stack is enumerated in exactly ONE visible place per HTML page — the footer tech-grid; hero-meta stays a short delegation line and other sections point at the footer instead of repeating the list"@en ;
    schema:text "Designate the footer tech-grid as the sole full-stack attribution listing; the hero-meta line stays a short 'curated by {skills+llm} on behalf of {principal}' delegation statement, and any other section either omits the tool inventory or references the footer instead of restating it."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/kg-curation-attribution.ttl#stepSingleCanonicalSurface> .

# ── Step 168: FAQ/Glossary/HowTo Counts Track Source Density, Not a Fixed Number ──

:step-countReflectsSourceDensity a schema:HowToStep ;
    schema:position 168 ;
    schema:name "FAQ and glossary counts must cover every distinct question-worthy claim and defined term in the source, with 10 as an anti-under-delivery floor, never a ceiling to stop at"@en ;
    schema:text "The FAQ and glossary minimums (>= 10 each) are a floor against under-delivery, not a target count — the delivered set must span every distinct question-worthy claim and defined term the source material actually contains, whether that means padding is never needed or the count runs well past 10."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/full-skills-contract-always-applies.ttl#step-countReflectsSourceDensity> .

# ── Step 169: A generator script's own validators are not proof of full-contract compliance; owl:sameAs alias IRIs must stay untyped ──

:step-generatorScriptNotSubstituteForChecklist a schema:HowToStep ;
    schema:position 169 ;
    schema:name "rdf-infographic-skill's generate_infographic.py + its bundled validators check a narrower surface than the full contract; also, owl:sameAs alias IRIs must never be re-typed as full entities"@en ;
    schema:text "A generator script's own bundled validators passing is not proof of full-contract compliance, and owl:sameAs alias IRIs must stay untyped or the RDF-to-HTML extractor renders duplicate entity cards."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/generator-script-output-not-a-substitute-for-contract-check.ttl>,
        <howto/prior-artifact-footer-polish-gate.ttl>,
        :step-priorArtifactFooterPolishGate .

# ── Step 170: An ad hoc footer sparqlBtn patch must follow the documented Gate 2 structure, not a bare link ──

:step-adHocSparqlBtnMustFollowGate2 a schema:HowToStep ;
    schema:position 170 ;
    schema:name "When patching a missing footer sparqlBtn onto generator output, build the full footer-sparql-explorer-gate.ttl structure (visible SAMPLE query + copy button), not a bare CTA link, and give it distinct heading text from any existing mid-page SPARQL workbench"@en ;
    schema:text "A bare sparqlBtn link with no visible query text recreates the already-documented query-visibility defect, and reusing the exact same heading phrase as an existing mid-page SPARQL section reads as an unintended duplicate."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 171: Elicit the entity-link-placement mode before writing any new body prose, not only when adding an HTML infographic from scratch ──

:step-elicitEntityLinkModeOnAnyProseAddition a schema:HowToStep ;
    schema:position 171 ;
    schema:name "entity-link-placement.ttl's Mode A/B elicitation applies to ANY new body-prose section added to an existing infographic (e.g. a Synopsis added after the fact), not only to initial HTML generation"@en ;
    schema:text "New narrative prose added to an already-delivered infographic must still get first-reference entity links per the elicited mode; a Synopsis section added later was delivered with zero entity links until asked about it."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/entity-link-placement.ttl> .

# ── Step 172: A one-off footer sparqlBtn patch must be consolidated into the page's single existing SPARQL section, not stacked as a second one ──

:step-consolidateNotStackSparqlSections a schema:HowToStep ;
    schema:position 172 ;
    schema:name "Before patching in a missing sparqlBtn, check whether the page already has a SPARQL section (id, heading, or workbench) and consolidate into it instead of adding a second one with a duplicate id/heading"@en ;
    schema:text "Patching a required element (sparqlBtn) onto generator output must start with a duplicate-id and duplicate-heading grep against the existing page, not an unconditional append; a second footer patch produced a literal duplicate id=\"sparql-explorer\" and a repeated 'Explore Knowledge Graph using SPARQL' heading, plus a stacked, redundant About-section attribution list on top of the footer's canonical one, both only caught when the user pointed them out directly."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl>, <howto/kg-curation-attribution.ttl#stepSingleCanonicalSurface> .

# ── Step 173: A generator script's own bundled validators passing still does not mean the article's narrative body or the KG Explorer's Basic-mode feature set is complete ──

:step-generatorGapsSectionBodyAndKgExplorer a schema:HowToStep ;
    schema:position 173 ;
    schema:name "generate_infographic.py silently drops schema:CreativeWork section bodies from rendering, and its KG Explorer omits several Basic-mode non-negotiables (label geometry/contrast, search, tooltip, predicate descriptions, edge hover)"@en ;
    schema:text "Grep the RDF for every schema:CreativeWork under the article's schema:hasPart and confirm its schema:text is actually rendered in the HTML body, and diff the KG Explorer toolbar against SKILL.md's Basic Mode checklist item by item, rather than trusting a populated Advanced panel or the harness script's own validators."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/generator-script-output-not-a-substitute-for-contract-check.ttl> .

# ── Step 174: Canonical identity ≠ WebID/NetID — protocol credential vs person ──

:step-webidVsCanonicalIdentity a schema:HowToStep ;
    schema:position 174 ;
    schema:name "A WebID (NetID) is a certificate-bound protocol credential — it is NOT a person's canonical identity"@en ;
    schema:text """Canonical identity (e.g., https://www.linkedin.com/in/kidehen#this) names WHO a person IS, independent of any protocol. A WebID or NetID (e.g., https://kingsley.idehen.net/.../link-in-bio-credentials-5/index.html#netid) is a certificate-bound identifier used WITH the WebID-TLS/mTLS protocol for authentication. A person may have multiple WebIDs (different certs, different bundles), each owl:sameAs their canonical identity. When answering 'what is my WebID?', always present the certificate-bound SAN URI as the WebID and clearly state it is a protocol credential, not the person — and name the canonical identity separately. When composing whoami, the WebID line shows the cert-bound URI; the canonical identity is the person's name + owl:sameAs links. Never say 'your WebID is your identity' — it represents identity within the protocol, it is not the identity itself."""@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/webid-vs-canonical-identity.ttl> .

# ── Step 174: Load HTML+RDF infographic deliveries in an actual browser before declaring them done — grep/syntax validation cannot catch a dead external script URL ──

:step-mustBrowserVerifyNotJustGrep a schema:HowToStep ;
    schema:position 174 ;
    schema:name "A generated HTML infographic must be loaded in a real browser (local server + console-error check + DOM population check) before delivery, not just grep/harness-validator/node-syntax-checked"@en ;
    schema:text "The KG Explorer's SVG was completely blank across five 'PASS' validator runs because rdf-infographic-skill's own base_template.html hard-codes a 404ing D3 CDN URL, and the validator's own check tested for that literal broken string as proof of correctness rather than a working one."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/generator-script-output-not-a-substitute-for-contract-check.ttl#step-loadInBrowserNotJustGrep> .

# ── Step 175: TTS / voice-over pronunciation of URIBurner and SPARQL ──

:step-ttsPronunciations a schema:HowToStep ;
    schema:position 175 ;
    schema:name "Voice-over pronunciation rules for domain terms"@en ;
    schema:text "When generating a TTS voice-over (screencast-recorder skill) that mentions these terms, spell them phonetically so the synthesizer reads them correctly. URIBurner → write 'U-R-I Burner' (letters U, R, I, then Burner). SPARQL → write 'Sparkle'. DaaS → write 'DAAS' (rhymes with gas, starting with D). ABAC → write 'A-BACK'. This applies to narration.txt, voiceover instructions, and any TTS input text."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/screencast-recording.ttl>, <howto/artifact-routing.ttl> .

# ── Step 176: Nav panel toggleNav()/saveState() race with the max-height CSS transition ──

:step-navSaveStateTransitionRace a schema:HowToStep ;
    schema:position 176 ;
    schema:name "Defer the floating-nav's saveState() call until after the expand CSS transition settles, or it persists a corrupt collapsed-height as the 'expanded' state"@en ;
    schema:text "Calling saveState() synchronously right after nav.classList.toggle('expanded') captures the pre-transition (still-collapsed) bounding-rect height and writes it to localStorage, which then permanently clips the nav on reload via a higher-specificity inline max-height."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/nav-panel-localstorage-race.ttl> .

# ── Step 177: Floating nav panel must default to collapsed on page load ──

:step-navDefaultCollapsed a schema:HowToStep ;
    schema:position 177 ;
    schema:name "The floating navigation panel MUST default to the collapsed header-bar state on page load (no 'expanded' class in initial markup), unless the user explicitly requests an expanded default"@en ;
    schema:text "Already required by rdf-infographic-skill/SKILL.md; cross-referenced into prefs since it was previously skill-contract-only."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/nav-panel-localstorage-race.ttl> .

# ── Step 178: Ad hoc filesystem searches scope to {LLM_ROOT}, never a whole-disk find ──

:step-scopeFilesystemSearchesToLlmRoot a schema:HowToStep ;
    schema:position 178 ;
    schema:name "Any ad hoc filesystem search for a generated artifact (duplicate/stale-copy checks, 'where did this file go') must scope to {LLM_ROOT}, never run an unscoped whole-disk find"@en ;
    schema:text "Caught 2026-08-04: ran 'find / -iname ontology.ttl' across the entire filesystem instead of scoping to {LLM_ROOT}, generalizing the existing LOCAL RDF ROOT rule beyond KG-ONLY query mode to any artifact lookup."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/artifact-routing.ttl#step-scopeFilesystemSearchesToLlmRoot>, <howto/skill-invocation.ttl> .

# ── Step 179: Ontology document entity and owl:Ontology entity need differentiated name/description ──

:step-ontologyDocumentNameDifferentiation a schema:HowToStep ;
    schema:position 179 ;
    schema:name "The schema:CreativeWork document entity (<>) and the owl:Ontology entity it schema:about-links to must NOT share identical schema:name/schema:description text — extends Step 154's 'owl:Ontology is a distinct entity' rule to the entities' name/description text as well"@en ;
    schema:text "User fixed hospital-os-rdf-harness/ontology.ttl to differentiate ('...Ontology Document' vs '...Ontology'), then found the same anti-pattern in the canonical exemplar agent-rdf-memory/ontology.ttl itself — both retrofitted, and kg-generator/scripts/validate-kg-compliance.sh gained a blocking check (11b) for it."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/ontology-document-name-differentiation.ttl>, <howto/canonical-entity-iri-denotation.ttl> .

# ── Step 180: rdfs:isDefinedBy must point to the actual owl:Ontology-typed entity, never the bare ':' fragment ──

:step-isDefinedByBareFragmentBug a schema:HowToStep ;
    schema:position 180 ;
    schema:name "A third rdfs:isDefinedBy failure mode (beyond Step 154's two): pointing at the bare ':' (<#>) fragment instead of the named entity actually typed owl:Ontology"@en ;
    schema:text "Both hospital-os-rdf-harness/ontology.ttl and the canonical exemplar agent-rdf-memory/ontology.ttl had this bug; both retrofitted and validate-kg-compliance.sh gained a blocking check (11c)."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/ontology-document-name-differentiation.ttl#step-isDefinedByBareFragmentBug>, <preferences.ttl#step-ontologyIsDistinctEntity> .

# ── Step 181: XBRL/US-GAAP alignment is mandatory for SEC/EDGAR-sourced financial content ──

:step-xbrlFinancialReportingAlignment a schema:HowToStep ;
    schema:position 181 ;
    schema:name "Financial-statement line items from SEC/EDGAR (or similar XBRL-tagged) sources MUST be aligned to the FASB US-GAAP XBRL taxonomy — an important standing preference and financial-reporting skills gate"@en ;
    schema:text "User-stated standing preference (2026-08-06): SEC/EDGAR-sourced financial-statement line items must be aligned to the verified XBRL/us-gaap vocabulary rather than left as bare literal labels or reinvented as ad hoc local terms."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerArtifactGeneration ;
    rdfs:seeAlso <howto/financial-reporting-xbrl-alignment.ttl>, <howto/canonical-entity-iri-denotation.ttl> .

# ── Step 182: SPARQL explore-the-graph requests get an encoded query URL, not just raw query text ──

:step-sparqlExploreQueryAsUrl a schema:HowToStep ;
    schema:position 182 ;
    schema:name "When asked to show the SPARQL query for exploring a generated KG, return a ready-to-click percent-encoded query URL, not just a bare query code block"@en ;
    schema:text "User-stated standing preference (2026-08-08): return a fully percent-encoded, ready-to-click SPARQL query URL as the primary deliverable, not just raw query text."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/sparql-explore-query-as-url.ttl>, <howto/footer-sparql-explorer-gate.ttl>, <howto/virtuoso-workbench-query-dedup.ttl> .

# ── Step 183: Responsive head-to-head comparison (table large / cards small) ─

:step-responsiveComparisonPresentation a schema:HowToStep ;
    schema:position 183 ;
    schema:name "Multi-entity comparison matrices MUST dual-present: table on large screens, product cards on phones"@en ;
    schema:text """FALLBACK for rdf-infographic-skill when the skill text is not loaded. PRIMARY authority is rdf-infographic-skill SKILL.md 'Responsive Head-to-Head Comparison Presentation' and assets/templates/competitive-analysis-head-to-head-claude_sonnet_4_6.html.

When HTML includes a head-to-head / multi-column comparison of two or more named products, platforms, systems, or offerings:
1. Emit dual markup: .comparison-table-view (semantic table) AND .comparison-cards-view (one .comp-card per entity with dimension rows).
2. CSS switch at 900px — table visible ≥901px; cards visible ≤900px. No JS required for the switch.
3. Both views carry identical facts; entity names resolver-linked in table headers and card headers.
4. Every comparison aspect MUST be a described TTL **instance** (schema:name+description) typed with a proper ontology class: reuse shared or corpus-canonical classes (e.g. cdx:ComparisonDimension) when they exist; only mint a new class under a distinct owl:Ontology entity when no shared/corpus term fits (ontology-discovery + cross-reference gates). The first column of each table body row (and matching card row labels) MUST resolver-link to that **instance** IRI — never plain-text aspect labels.
5. Overflow-safe cells (min-width:0; overflow-wrap:anywhere); dark-mode via two separate selector blocks.
6. Verify both viewports before delivery (table block at desktop; cards block at ~390px phone width).

Do not ship a multi-column matrix that only horizontal-scrolls on phones. See howto/responsive-comparison-presentation.ttl."""@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/responsive-comparison-presentation.ttl>,
        <howto/infographic-authoring.ttl>,
        <https://github.com/OpenLinkSoftware/ai-agent-skills/tree/main/rdf-infographic-skill#this> .

# ── Step 184: Prior-artifact footer / post-generator polish gate ─────────────

:step-priorArtifactFooterPolishGate a schema:HowToStep ;
    schema:position 184 ;
    schema:name "BLOCKING GATE — before delivering any HTML infographic, open the newest same-model webpages/ artifact, port its footer and post-generator polish, and never treat harness PASS as aesthetic PASS"@en ;
    schema:text "After generate_infographic.py or any stock HTML assembly, open the newest prior HTML under the active model's webpages/ root, port its footer and related post-generator polish (skills URLs, generation environment, explore CTA, prose Generated-using line, overflow-safe paths, DAV named graphs, hero-meta when present), clear stock-defect greps, and re-run the harness — harness PASS alone is never delivery-complete."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerSkillInvocation, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/prior-artifact-footer-polish-gate.ttl>,
        <howto/study-prior-patterns.ttl>,
        <howto/generator-script-output-not-a-substitute-for-contract-check.ttl>,
        <howto/kg-explorer-reuse-first.ttl>,
        <howto/infographic-authoring.ttl>,
        <howto/kg-curation-attribution.ttl>,
        <howto/footer-sparql-explorer-gate.ttl> .

:step-synopsisDeckDesignSystem a schema:HowToStep ;
    schema:position 200 ;
    schema:name "DEFAULT — render every infographic's synopsis as the executive-summary deck and every section with the editorial header system (kicker eyebrow + heading + rule); reusable template, not a one-off patch"@en ;
    schema:text "Since 2026-08-14 the rdf-infographic-skill pipeline (scripts/templates/styles.css + scripts/html_assembler.py + scripts/rdf_parser.py) ships the reusable editorial design system: the synopsis renders as an executive-summary deck (kicker pill + author/publisher/date meta, lede, two-column grid with optional spotlight panel, source chips, pull-quote, KG-entity CTA) and every narrative section gets a sec-head eyebrow + kebab-case heading id + rule. Deck data is RDF-driven and optional — spotlight panel from document-ontology class instances (title = class schema:name, fallback rdfs:label; featured row = the instance the article schema:about's, tag = its schema:alternateName, fallback 'Featured'), source chips from schema:citation objects, pull-quote from the first schema:Quotation. Graceful degradation: any missing slot is simply omitted. Do not hand-patch published HTML for this design; regenerate through the pipeline."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/synopsis-deck-design-system.ttl> .

:topicPriorArtifactFooterPolish a schema:Thing ;
    schema:name "Prior-artifact footer polish is a blocking delivery gate"@en ;
    schema:description "Harness and generator validators do not prove footer aesthetics or skill/environment attribution correctness. Same-model webpages/ baseline open + port is mandatory before delivery. Incident: 2026-08-11 SynthID-Text stock footer vs same-day polished coding-agent-harness comparison."@en ;
    rdfs:seeAlso <howto/prior-artifact-footer-polish-gate.ttl> .

# ── Step 185: SPARQL-bearing sections are closed-by-default accordions (aesthetics + contract fix) ──

:step-sparqlSectionsClosedAccordion a schema:HowToStep ;
    schema:position 185 ;
    schema:name "Wrap every SPARQL-bearing section — sample query cards AND the whole KG Explorer / SPARQL Workbench sections — in a closed-by-default <details> accordion"@en ;
    schema:text "SKILL.md already required per-query <details>/<summary> accordions; rdf-infographic-skill's build_sample_query_cards generator silently rendered plain always-open <div> cards instead — another contract-vs-implementation gap in the same family as generator-script-output-not-a-substitute-for-contract-check.ttl. Fixed at the generator (html_assembler.py + base_template.html + styles.css), not by hand-patching one output file: per-query cards are now <details class=\"sparql-card\">, and the whole #kg-explorer and #sparql-explorer sections are each wrapped in an outer <details class=\"section-accordion\">, both closed by default, with a hashchange/on-load JS handler that auto-opens any <details> ancestor of a same-page anchor target so nav links still work. Caught two related bugs in the same pass: a #sparqlRun button whose click handler was a byte-for-byte duplicate of #sparqlBtn (window.open of the identical href — a second visible 'Run' control doing nothing new), and a CSS specificity bug where `.sparql-actions a{display:inline-flex}` silently defeated the `hidden` attribute on the legitimately-hidden #sparqlLiveLink proxy, making a third 'hidden' button visible anyway."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl>,
        <howto/generator-script-output-not-a-substitute-for-contract-check.ttl> .

# ── Step 186: no second attribution surface — "About This Page" was redundant with the footer, deleted at the generator ──

:step-noSecondAttributionSurface a schema:HowToStep ;
    schema:position 186 ;
    schema:name "There is exactly ONE attribution/provenance surface per page — the footer #footer 'Attribution & Provenance' attr-grid — never a second mid-page 'About This Page' section"@en ;
    schema:text "rdf-infographic-skill's build_about_section() generated a fully redundant mid-page section duplicating the footer attr-grid, so it was deleted at the generator (html_assembler.py) rather than patched in one output file."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/generator-script-output-not-a-substitute-for-contract-check.ttl> .

# ── Step 187: owl-property-characterization.ttl and ontology-cross-reference-gate.ttl skipped end-to-end on a "small" 4-term ontology ──

:step-smallOntologyNoExemption a schema:HowToStep ;
    schema:position 187 ;
    schema:name "Minting even a tiny 2-4-term staging ontology still requires the full owl-property-characterization.ttl + ontology-cross-reference-gate.ttl checklist per term — a small vocabulary is not an exemption"@en ;
    schema:text "A minted post:revisionOf property was missing rdfs:domain/rdfs:range entirely (mandatory, no exceptions) and neither minted class/property had an external cross-reference, per the full incident writeup."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/owl-property-characterization.ttl>, <howto/ontology-cross-reference-gate.ttl> .

# ── Step 188: <summary> elements never inherit h1-h4 heading CSS — restate typography explicitly on any accordion title ──

:step-accordionSummaryHeadingInheritance a schema:HowToStep ;
    schema:position 188 ;
    schema:name "Any <details><summary> used as a section/card title must have its font-family/font-size/font-weight restated explicitly to match the page's real h2 — tag-selector CSS rules (h1,h2,h3,h4{...}) never apply to a <summary> element"@en ;
    schema:text "Caught 2026-08-12 when a custom-sized accordion summary silently fell back to the body font at a size matching neither the sitewide h2 nor the card-header scale, reading as 'distorted'/'not uniform' despite matching border-radius/padding/shadow tokens."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/accordion-summary-heading-inheritance-gap.ttl>,
        <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 189: KG Explorer and SPARQL Workbench MUST precede FAQ, Glossary, and HowTo in document order ──

:step-explorerPrecedesReference a schema:HowToStep ;
    schema:position 189 ;
    schema:name "KG Explorer and SPARQL Workbench MUST precede FAQ, Glossary, and HowTo — they are how a reader interacts with the data directly; reference material assumes that exploration already happened"@en ;
    schema:text "Fixed 2026-08-12 by splitting render_narrative() into primary/reference halves so base_template.html can sandwich the explorer/workbench accordions between them, instead of hardcoding the accordions after all narrative content."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/explorer-precedes-reference.ttl> .

# ── Step 190: a SoftwareSourceCode entity nested inside ANY section must not duplicate its SPARQL Workbench Execute card ──

:step-noNestedQueryCardDuplication a schema:HowToStep ;
    schema:position 190 ;
    schema:name "A schema:SoftwareSourceCode entity nested as a schema:hasPart child of any section (not just top-level) must not render as a second static card duplicating its SPARQL Workbench Execute card"@en ;
    schema:text "The generic 'sections' child-extraction loop excluded media-object children but not SoftwareSourceCode, letting a hand-authored demo-data section duplicate its own SPARQL Workbench sample-query cards one-for-one."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/explorer-precedes-reference.ttl> .

# ── Step 191: any container added outside .section/.section-alt needs its own explicit width cap ──

:step-unconstrainedContainerWidth a schema:HowToStep ;
    schema:position 191 ;
    schema:name "Any container placed outside the .section/.section-alt system (a direct <body> child, or a footer sub-wrapper) needs its own explicit max-width:1100px;margin:0 auto cap restated — it does not inherit .section's constraint"@en ;
    schema:text "The KG Explorer/SPARQL Workbench accordion wrapper had no max-width at all, and the footer's inner wrapper had a width cap but no padding of its own, so both rendered wider than every regular section's content box."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/explorer-precedes-reference.ttl> .

# ── Step 192: card-grid containers use auto-fill, never auto-fit, or a lone card stretches full-width ──

:step-cardGridAutoFitStretch a schema:HowToStep ;
    schema:position 192 ;
    schema:name "Every card-grid container (grid-template-columns:repeat(...,minmax(...))) MUST use auto-fill, never auto-fit — auto-fit stretches a lone or few card(s) edge-to-edge across the full row instead of staying compact and left-aligned"@en ;
    schema:text "Fixed 2026-08-12 on .cards-grid and .attr-grid (both changed from auto-fit to auto-fill, matching .glossary-grid's already-correct convention) after single-card sections rendered stretched full-width and read as 'misaligned'."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/explorer-precedes-reference.ttl> .

# ── Step 193: .section-alt margin shorthand silently overrode .section's centering — verify with getBoundingClientRect(), not screenshots alone ──

:step-sectionAltMarginShorthandCentering a schema:HowToStep ;
    schema:position 193 ;
    schema:name "A shared class's spacing rule must use longhand margin-bottom (not the 3/4-value margin shorthand) or it silently overrides a base class's margin:0 auto centering on the same element — verify alignment fixes with getBoundingClientRect() in a real browser, not by re-reading CSS"@en ;
    schema:text "Fixed 2026-08-12: .section-alt's margin shorthand overrode .section's centering on every alt-background section, invisible below ~1228px viewport; changed to margin-bottom only, confirmed via getBoundingClientRect() across nine sections."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/explorer-precedes-reference.ttl> .

# ── Step 194: KG Explorer / SPARQL Workbench section-level accordion REMOVED — supersedes Step 185 for these two sections ──

:step-kgSparqlAccordionRemoved a schema:HowToStep ;
    schema:position 194 ;
    schema:name "KG Explorer and SPARQL Workbench are always-visible sections again — do NOT wrap #kg-explorer or #sparql-explorer in a section-level <details> accordion; this supersedes Step 185 for these two sections specifically (per-query .sparql-card accordions inside the workbench are unaffected and still closed-by-default)"@en ;
    schema:text "Removed 2026-08-12 per explicit direct user instruction ('Remove the accordion aspect of the KG Explorer and SPARQL workbench cards'); the icon/title/live-stat-badge moved into a real h2 instead of the old summary bar, and validate-harness-contract.py now forbids the accordion-wrapper strings it previously required."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/kg-explorer-sparql-workbench-accordion-removed.ttl>,
        :step-sparqlSectionsClosedAccordion .

# ── Step 195: every sample SPARQL query must be self-contained (PREFIX, dataset scope, DISTINCT) and its runnable claims empirically verified live ──

:step-sparqlSampleQuerySelfContainment a schema:HowToStep ;
    schema:position 195 ;
    schema:name "Every sample/documented SPARQL query text MUST declare its own PREFIX lines, scope to the actual DAV graph IRI (except cross-graph reasoning demos), use DISTINCT, and have any reasoning-entailment claim empirically verified live (both with and without the pragma) rather than assumed — a query does not inherit its source Turtle document's @prefix/@base/graph context"@en ;
    schema:text "Caught 2026-08-13 when a live-run sample query failed with Virtuoso 'Undefined default namespace prefix' — none of 20 sample SPARQL fields in a generated document declared their own PREFIX lines."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/sparql-sample-query-self-containment-gate.ttl>,
        <howto/virtuoso-workbench-query-dedup.ttl> .


# ── Step 196: a copied prior-HTML template must be checked against the CURRENT numbered gates, not assumed compliant because it looks recent ──

:step-priorTemplateStalenessCheck a schema:HowToStep ;
    schema:position 196 ;
    schema:name "Before copying any prior HTML file as a structural base (LLM-Direct hand-authoring OR generator-assisted), grep it against the current footer/about-merge, explorer-placement, and card-uniformity gates — an older template silently reintroduces already-fixed defects even when picked from the same output folder and same model"@en ;
    schema:text """Incident (2026-08-13): a new artifact (enterprise-ai-coordinate-system-claude_sonnet_5-1.html) was hand-built by copying uber-adr-agentic-ai-security-claude_sonnet_5-1.html (dated 2026-08-04) as the structural/CSS/JS base, per the established 'reuse a prior working example' practice (Step 184 / howto/study-prior-patterns.ttl). But the copied file predated three later fixes (Step 186 no-second-attribution-surface, Step 189 explorer-precedes-reference, Steps 191-193 card/container uniformity), so all three defects were silently reintroduced: a standalone 'About This Page' section duplicating the footer attribution block, the SPARQL explorer workbench stranded at the end of the footer instead of directly following the KG Explorer, and uneven format-tab/tech-card sizing from an unconstrained footer container. Harness validation still passed throughout, because validate-harness-contract.py checks for required CONTENT (labels, ids, resolver patterns), not document ORDER or layout redundancy — so 'validator green' gave false confidence.

Rule: picking a prior file as a template is still correct practice (do not stop reusing proven CSS/JS), but before treating it as a baseline you MUST verify — by grep or by date — that it already satisfies every currently-numbered footer/about/explorer-placement/card-uniformity gate:
  grep -c 'id=\"about\"' {template} — must show About merged INTO <footer>, never a separate mid-page <section id=\"about\">
  grep -n '<section.*id=\"kg-explorer-section\"' {template} then confirm the NEXT <section> is id=\"sparql-explorer\" (Step 189) — not FAQ/glossary/howto
  grep -n 'tech-card{' {template} — confirm min-height/flex-centering present (Step 192/193 lineage), not bare text-align:center padding
  grep -n 'kg-format-tabs button{' {template} — confirm flex:1 (equal-width tabs), not auto-width buttons

If any check fails, port the CURRENT pattern from the newest compliant file in the same output folder instead of the one you happened to grab — 'same model, reasonably recent filename' is not sufficient evidence of compliance. A stale template is a silent regression vector that harness-PASS does not catch."""@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl>,
        <howto/prior-artifact-footer-polish-gate.ttl>,
        <howto/study-prior-patterns.ttl>,
        <howto/explorer-precedes-reference.ttl>,
        :step-priorArtifactFooterPolishGate,
        :step-noSecondAttributionSurface,
        :step-explorerPrecedesReference,
        :step-unconstrainedContainerWidth,
        :step-cardGridAutoFitStretch .

# ── Step 197: generic-card description truncation must be word-boundary-safe with a visible ellipsis; every .card needs min-width:0 + overflow-wrap ──

:step-cardDescriptionTruncation a schema:HowToStep ;
    schema:position 197 ;
    schema:name "extract_description() MUST truncate at a word boundary with a visible ellipsis, never a bare [:N] slice that silently cuts mid-word; every .cards-grid card MUST have min-width:0 plus overflow-wrap:anywhere/word-break:break-word on its h3 and p"@en ;
    schema:text "Fixed 2026-08-13 after a card's description silently cut off mid-word ('...the nine SP') with no ellipsis, and separately a long raw-filename card title nearly overflowed its card border — two related generic-card bugs affecting every People/Organizations/analysis-N card grid, not just one document."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/card-description-truncation-gate.ttl> .

# ── Step 198: a product's general/roadmap capability (RDF-star support) is not verified by testing against the exact endpoint in use ──

:step-rdfStarNotVerified a schema:HowToStep ;
    schema:position 198 ;
    schema:name "Never claim a specific SPARQL endpoint supports RDF-star/RDF 1.2 quoted-triple syntax (or any similar spec-level feature) without testing that exact syntax against that exact endpoint — general product reputation or roadmap status is not verification"@en ;
    schema:text "Caught 2026-08-13: multiple fields asserted 'Virtuoso's RDF 1.2 (RDF-star) support' as fact, but both quoted-triple syntax forms returned a Virtuoso SP030 syntax error when actually tested against the live endpoint."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/sparql-sample-query-self-containment-gate.ttl> .

# ── Step 199: every live sample query using a Virtuoso reasoning pragma gets a commented-pragma A/B companion query ──

:step-pragmaAbToggleVariant a schema:HowToStep ;
    schema:position 199 ;
    schema:name "Standing preference: any live/Execute-button SPARQL sample query relying on a Virtuoso query-level pragma (DEFINE input:same-as, DEFINE input:inference '<ruleset>', etc.) MUST be accompanied by an identical companion query with the pragma commented out as a plain '#' line, cross-referenced both directions, so a reader can toggle reasoning on/off with a one-character edit"@en ;
    schema:text "Direct user instruction 2026-08-13: 'Examples with Virtuoso pragmas should always be accompanied with variants where the pragma is commented out re A/B testing and demonstration of reasoning & inference' — implemented as :demoQ10/:demoQ11 companions to :demoQ5/:demoQ9, both verified live before being written in."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/pragma-ab-toggle-variant.ttl> .

# ── Step 200: referenced posts in any response get resolver-pattern hyperlinks, verified before use ──

:step-hyperlinkPostReferencesResolver a schema:HowToStep ;
    schema:position 200 ;
    schema:name "Whenever a response references other posts (weblog posts, articles, papers), hyperlink them via the URIBurner resolver pattern and verify each resolver URL resolves before including it"@en ;
    schema:text "Direct user instruction 2026-08-14: 'As a practice going forward, hyperlink other posts when you make reference to them. Verify the URL using the resolver pattern.' Every referenced post becomes a Markdown hyperlink of the form https://linkeddata.uriburner.com/describe/?url={url-encoded-post-IRI} — single-encoded only (one url-decode pass must yield the clean post IRI; never pre-encoded %27/%20 inputs that produce %2527/%2520 double-encoding). Compute the encoding with a tool, then verify each resolver URL returns HTTP 200 before including it in the response. Never emit a bare post URL or a direct (non-resolver) link."@en ;
    onto:hasTrigger onto:triggerPreferencesUpdate ;
    rdfs:seeAlso <howto/hyperlink-post-references-resolver.ttl> .

:topicHyperlinkPostReferencesResolver a schema:Thing ;
    schema:name "Resolver-pattern hyperlinks for referenced posts"@en ;
    schema:description "Standing rule: references to other posts in agent responses are hyperlinked through the URIBurner resolver (linkeddata.uriburner.com/describe/?url={url-encoded-iri}), single-encoded, with each resolver URL verified (HTTP 200) before use."@en .

# ── Step 201: don't ship a simplified SPARQL button+toggle when the harness contract requires the full Workbench ──

:step-sparqlWorkbenchNotSimplifiedButton a schema:HowToStep ;
    schema:position 201 ;
    schema:name "The footer SPARQL feature is the full Workbench (sample-query <details> cards + editable recipe/textarea editor + single #sparqlBtn live CTA) — never a standalone button plus a Turtle/JSON-LD format-toggle substitute"@en ;
    schema:text "Caught 2026-08-14 on claude-watermark-2026.html: shipped only a bare #sparqlBtn + kg-format-tabs toggle, skipping the rdf-infographic-skill harness's 'Footer SPARQL Workbench Non-Negotiables' (named graph selector, query recipe selector, editable textarea, live query link, refresh/copy) and the already-recorded howto/footer-sparql-explorer-gate.ttl gates (closed-by-default sample-query <details> cards, one consolidated surface, no duplicate #sparqlRun). Fixed by porting the exact established pattern from the newest compliant prior file (enterprise-ai-coordinate-system-grok_4_6-1.html, 2026-08-13): #sparql-explorer section directly after #kg-explorer-section (never stranded in the footer), N sample-query <details class=\"sparql-card\"> cards each resolver-linked and closed by default, a shared query-editor card (#sparqlGraph, #sparqlRecipe, #sparqlText textarea), #sparqlBtn as the one live CTA plus a hidden #sparqlLiveLink proxy for per-card Execute buttons, and a footer that points back to the Workbench instead of duplicating it. Note the section-level outer <details> accordion wrap described in gate-sparqlSectionsClosedAccordion was itself superseded 2026-08-12 per explicit user request — #kg-explorer and #sparql-explorer are NOT double-wrapped in an outer accordion; only nested sample-query cards are. Always verify which howto rule is current by file mtime, not just presence."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/footer-sparql-explorer-gate.ttl> .

# ── Step 202: after an endpoint upgrade, re-verify the exact previously-failing capability — the re-test can surface new, narrower findings, not just confirm/deny the original claim ──

:step-rdfStarUpgradeReverify a schema:HowToStep ;
    schema:position 202 ;
    schema:name "When a user reports an endpoint was upgraded to support a previously-unverified feature, re-run the exact original failing test before updating any prose — and check the raw stored data directly (not just pattern-matching queries) if a re-test returns empty with no error"@en ;
    schema:text "2026-08-14: an RDF-star upgrade re-test confirmed the original syntax error was fixed but surfaced a new limitation — a language-tagged literal inside a quoted-triple pattern silently failed to match despite correctly stored data."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/rdf-star-upgrade-verification-and-literal-tag-caveat.ttl> .

# ── Step 203: when a document claims two independent reasoning engines (e.g. "Virtuoso/FuXi"), each needs its own labeled code block and its own RDF property — never one field, never one generic label ──

:step-dualEngineBlockSeparation a schema:HowToStep ;
    schema:position 203 ;
    schema:name "A slash-joined claim like 'Virtuoso/FuXi reasoning' is a promise both are independently demonstrated — burying the second engine as a comment inside a block labeled after the first engine breaks that promise even if the data is technically present"@en ;
    schema:text "2026-08-15: 3 of 12 correction cards had a FuXi N3 rule buried as a code comment inside a block labeled generically SPARQL, matching the user's complaint that only Virtuoso examples were visible."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration, onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/dual-reasoning-engine-block-separation.ttl> .

# ── Step 204: "needs to be more AND take less space" means denser rows, not more rows in the same style — raising a count while keeping per-row size makes a space complaint worse, not better ──

:step-synopsisPanelCompactRows a schema:HowToStep ;
    schema:position 204 ;
    schema:name "A count instruction paired with a space complaint describes ONE fix (compress row density), not two independent requests to satisfy separately by raising the count alone"@en ;
    schema:text "2026-08-15: raising a spotlight-panel cap from 4 to 14 while keeping the same bordered-card-with-description row style tripled panel height instead of reducing whitespace, requiring a user correction to switch to single-line ellipsis rows with hover tooltips."@en ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified ;
    rdfs:seeAlso <howto/synopsis-panel-compact-rows.ttl> .

# ── Step 205: a preview/jump-list row for content that also has a full on-page section must link to that section locally, not to the external resolver IRI used for ordinary first-mention entity links ──

