        <howto/credential-location-session-start.ttl>,
        <core.ttl> .

# ── Step 225: never probe/test against a production credential identifier ──

:step-neverProbeProductionCredentialNames a schema:HowToStep ;
    schema:position 225 ;
    schema:name "Any credential-store probe or precedence test MUST use a namespaced throwaway identifier — never the real service/account name, because -U overwrites a live secret and delete destroys it"@en ;
    schema:text "2026-08-18: agent ran add -U then delete against the real uriburner-p12 keychain service to demonstrate read precedence, which silently overwrites-then-destroys a live item; the user's newly created entry was subsequently missing." ;
    onto:hasTrigger onto:triggerBehaviorGapIdentified, onto:triggerSkillInvocation ;
    rdfs:seeAlso <howto/p12-passphrase-retrieval.ttl#step-neverProbeProductionCredentialNames>,
