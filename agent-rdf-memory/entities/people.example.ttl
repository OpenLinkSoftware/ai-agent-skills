# Live people.ttl is gitignored. Copy this file to people.ttl locally.
# Snapshot of the registry as of 2026-09-02 before Progress OpenEdge ISV contact additions.
@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dbr: <http://dbpedia.org/resource/> .

<> a schema:CreativeWork ;
    schema:name "Entity Registry: People"@en ;
    schema:description "Canonical schema:Person entity IRIs for individuals recurring across the agent RDF memory system. This is the authoritative single-source-of-truth — agents MUST consult this registry before resolving a person entity, and MUST register newly resolved person IRIs here rather than only in session files. Populated 2026-07-14 from a SPARQL census of schema:Person instances across all DAV named graphs (1,271 instances, 1,150 distinct IRIs, 499 owl:sameAs/name-merged clusters, 41 recurring in >= 3 documents)."@en ;
    rdfs:comment "The local names below (:kingsleyIdehen, :tonySeale, etc.) are registry-internal index labels for lookup within THIS file only — they are not entity IRIs and must never be copied into generated/delivered RDF documents. In any generated document (an infographic's companion entities.ttl, a KG collection, etc.), the canonical platform IRI itself (the owl:sameAs target, e.g. <https://linkedin.com/in/kidehen#this>) must be used as the sole subject directly — per howto/canonical-entity-iri-denotation.ttl Step 7 (:step-localIriProhibition), which explicitly prohibits document-local IRIs when a canonical platform IRI is available. Caught 2026-08-04: this registry's own local-name convention was mistakenly copied into hospital-os-rdf-harness/entities.ttl as :brianDeFrancesca/:kingsleyIdehen local IRIs with owl:sameAs to canonical — exactly the anti-pattern in that howto's own worked example."@en ;
    schema:dateCreated "2026-07-08T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-09-01T21:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :kingsleyIdehen, :tonySeale, :satyaNadella, :jayaGupta, :alexKarp,
        :aaronLevie, :jessicaTalisman, :robertScoble, :adedejiOlowe, :veronikaHeimsbakk,
        :abhiYadav, :irenaCronin, :scottBrinker, :richardMacManus, :ngoziDozie,
        :prukalpaSankar, :fransRiemersma, :robertSanderson, :timBernersLee, :jkRowling,
        :reidHoffman, :omMalik, :juanSequeda, :aakashGupta, :guyDebord, :mohamedSalah,
        :joostDeValk, :gauravMalhotra, :samAltman, :stuartMichaelEdelenbos, :saanyaOjha,
        :danielAtherton, :popeLeoXIV, :florianWirtz, :jonathanJaffe, :virgilVanDijk,
        :nickZervoudis, :vivianVoss, :dennisJuarez, :naomiXia, :tomaszTunguz,
        :andrejKarpathy, :henryYin, :carlosPerez, :peterSteinberger, :brianDeFrancesca,
        :stevenSinofsky, :seanBPalmer, :chimezieOgbuji, :moBitar,
        :patrickCollison, :osaretinVictorAsemota, :brijKishorePandey,
        :michaelTruell, :sualehAsif, :amanSanger, :arvidLunnemark, :elonMusk,
        :aliPartovi, :natFriedman, :arashFerdowsi, :jordanTopoleski, :davidPan,
        :leeRobinson, :sarahWang, :dwarkeshPatel, :melvinCarvalho, :danBrickley,
        :spencerMateega, :carlosGeorgescu, :dannyTang, :annaTong, :philippHerzig, :georgKniese, :walterSun, :karlFahrbach, :rayCase, :elizabethCuratolo, :irfanKhan ;
    rdfs:seeAlso <../preferences.ttl>, <../core.ttl>,
        <../howto/canonical-entity-iri-denotation.ttl>,
        <../howto/entity-iri-denotation-mechanics.ttl>,
        <../howto/external-iri-verification.ttl>,
        <../howto/cross-document-local-term-reuse.ttl> .

# ═══════════════════════════════════════════════════════════════════════════════
# ── Correction note (2026-07-14) ────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════════
#
# Three entries added earlier the same session (Jaya Gupta, Alex Karp, Aaron
# Levie) carried unverified/incorrect canonical IRIs, caught by cross-checking
# against corpus documents already read this session:
#   - :jayaGupta was <...linkedin.com/in/jayagupta#this> — WRONG. Verified form
#     (ai-value-capture-response-claude_sonnet_5-1.ttl) is jayagupta10.
#   - :aaronLevie was <...linkedin.com/in/aaron-levie#this> — WRONG. Verified
#     form (aaron-levie-enterprise-ai-agent-issues-...ttl) is boxaaron.
#   - :alexKarp was <...linkedin.com/in/alexkarp#this> — UNVERIFIED/fabricated.
#     No document in this corpus ever asserts a personal LinkedIn IRI for Karp;
#     only dbr:Alex_Karp (DBpedia) appears. Corrected to DBpedia canonical per
#     the no-fabricated-URLs rule.
# Lesson: a registry entry must be checked against already-read source
# documents, not asserted from model recall of a plausible-looking slug.

:kingsleyIdehen a schema:Person ;
    schema:name "Kingsley Uyi Idehen"@en ;
    schema:email "kidehen@openlinksw.com" ;
    schema:jobTitle "Founder & CEO"@en ;
    schema:worksFor <http://dbpedia.org/resource/OpenLink_Software> ;
    owl:sameAs <https://kingsley.idehen.net/DAV/home/kidehen/Public/YouID/link-in-bio-credentials-5/index.html#netid>,
               <https://id.myopenlink.net/dataspace/person/kidehen>,
               <https://my.openlinksw.com/dataspace/person/kidehen@openlinksw.com>,
               <http://my.openlinksw.com/dataspace/person/kidehen@openlinksw.com>,
               <https://linkedin.com/in/kidehen#this>,
               <https://www.linkedin.com/in/kidehen#this>,
               <https://x.com/kidehen#this>,
               <https://substack.com/@kidehen#this> ;
    rdfs:comment "Current YouID/NetID https://kingsley.idehen.net/DAV/home/kidehen/Public/YouID/link-in-bio-credentials-5/index.html#netid is the protocol credential (cert-modulus verified in this Grok Bot session). Older ODS WebID https://id.myopenlink.net/dataspace/person/kidehen 303s (2026-08-30) to /dataspace/raw/person/kidehen/sioc.jsonld (application/ld+json); graph id is the hashless person URI, type Person, foaf:name Kingsley Uyi Idehen, cert:key present. ODS shop WebID http://my.openlinksw.com/dataspace/person/kidehen@openlinksw.com 303s (2026-08-30) to /dataspace/raw/person/kidehen@openlinksw.com/sioc.jsonld; JSON-LD id is the https hashless person URI, type Person, cert:key present. Literal @ in the path is RFC 3986 pchar-legal; the percent-encoded %40 form 303s to empty JSON and was not added. A foaf:OnlineAccount in that graph also cites http://id.myopenlink.net/dataspace/person/kidehen#this as the webid account homepage; the content-negotiated person id is hashless. Linkedin.com (non-www) remains the registry canonical platform IRI per the person-IRI ladder. First resolved in agent-rdf-memory/core.ttl (:user entity). Census 2026-07-14: 37 documents."@en ;
    schema:dateCreated "2026-05-27T00:00:00Z"^^xsd:dateTime .

