@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:CreativeWork ;
    schema:name "HowTo: A generator or validator that contradicts the newest preference step is fixed at source, not worked around"@en ;
    schema:description "Caught 2026-10-20 on the Virtuoso SaaS Buyer Guide collection: the KG Explorer and SPARQL Workbench shipped always-visible because only the head of preferences.ttl was read and the generator template and validate-harness-contract.py still followed Step 194, which Step 307 had reversed on 2026-09-24. A green validator hid the gap. Companion to preferences.ttl Step 350."@en ;
    schema:dateCreated "2026-10-21T09:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-10-21T09:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :newestStepWins ;
    rdfs:seeAlso <../preferences.ttl#step-validatorSupersededByNewerStep>,
        <kg-explorer-sparql-workbench-collapse-by-default.ttl>,
        <generator-script-output-not-a-substitute-for-contract-check.ttl> .

:newestStepWins a schema:HowTo ;
    schema:name "Resolve a rule by its newest preference step, and fix a stale tool at source"@en ;
    schema:description "Five steps that stop a stale generator or validator from overriding a newer standing preference."@en ;
    schema:step :step-grepNewest, :step-validatorNotCompliance, :step-fixAtSource, :step-postProcessScope, :step-chainPublish .

:step-grepNewest a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Before building, grep preferences.ttl for the newest step on each topic the artifact touches"@en ;
    schema:text "preferences.ttl is far too large to read in full and its head holds the oldest steps. For every presentation or structural rule the artifact depends on (explorer and workbench containers, section order, tables, links, figures), grep the whole file for the topic keywords and read the highest-numbered matching step, then follow its rdfs:seeAlso howto. Several rules have flipped more than once (Step 185, 194, 307), so an older step is only history."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration .

:step-validatorNotCompliance a schema:HowToStep ;
    schema:position 2 ;
    schema:name "A passing validator is not proof of compliance: compare its require and forbid gates with the newest step"@en ;
    schema:text "Gates record the rule as it stood when they were written. Read the validator's require and forbid lines for the topic and check them against the newest step. If a gate contradicts the newest step, the validator is stale, and a pass or a fail from that gate means nothing."@en ;
    onto:hasTrigger onto:triggerArtifactGeneration .

:step-fixAtSource a schema:HowToStep ;
    schema:position 3 ;
    schema:name "When the generator template or validator is stale, fix it at source, regenerate, and record the change"@en ;
    schema:text "Edit the template and the validator so they follow the newest step, regenerate the artifact from them, and run the validator for a real pass. Do not leave a stale gate failing 'intentionally', and do not paper over the gap with a per-document patch. Verify behaviour in a browser, and regression-test the generator on one older collection."@en .

:step-postProcessScope a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Per-document post-processing is only for document-specific copy and design; anything that would recur belongs in the generator"@en ;
    schema:text "Moved into the generator on 2026-10-21 after being patched by hand on the Virtuoso SaaS Buyer Guide: comparison dimensions ordered by schema:position, a comparison title built from the compared subjects, no zero-count chips or hero tiles, schema:itemListOrder schema:ItemListUnordered for positioned card sets, ids on sample-query cards, hero link colours, and the desktop and mobile SVG variant CSS. Section order, eyebrow wording, a screenshot gallery, a listing-logo plate and typography stay per document."@en .

:step-chainPublish a schema:HowToStep ;
    schema:position 5 ;
    schema:name "Chain build, patch, copy and validate so a failed step stops publication, then cmp the published file with the build"@en ;
    schema:text "On 2026-10-20 a syntax error in a patch script did not stop a later copy and an unpatched page was published. Join the steps with && (or set -e), copy only after the patched output exists, run the validators on the published path, and cmp the published file against the build output."@en .
