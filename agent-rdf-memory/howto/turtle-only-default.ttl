@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:CreativeWork ;
    schema:name "Selected RDF Notation — No Implied Additional Serializations"@en ;
    schema:description "RDF output follows the user's selected notation; Turtle is the default when no preference is recorded. Additional serializations are not generated as an inferred side effect of an HTML companion's format-toggle footer."@en ;
    schema:dateCreated "2026-07-30"^^xsd:date ;
    schema:dateModified "2026-11-06"^^xsd:date .

:incident a schema:CreativeWork ;
    schema:name "CDOIQ 2026 Substack collection — unrequested JSON-LD"@en ;
    schema:description """Kingsley asked to generate an HTML and RDF collection for a Substack post. Nothing in the request named JSON-LD. The kg-generator skill's own governing rule states: 'Do NOT default to dual-format generation. Only produce both when explicitly requested or when the user asks for HTML/MD companions that require a format toggle in the footer.' That second clause was used circularly — the HTML page was designed with a Turtle/JSON-LD format-toggle footer, and the mere presence of that footer was then cited as the justification for generating JSON-LD. Nobody asked for the toggle either; it was carried over from a prior collection's template. Kingsley caught this and asked whether preferences needed updating."""@en ;
    schema:dateCreated "2026-07-30"^^xsd:date .

:rule a schema:CreativeWork ;
    schema:name "Standing rule going forward"@en ;
    schema:description """Use the user's recorded RDF notation preference for each RDF+HTML (or RDF+HTML+MD) generation; when none is recorded, use Turtle. Do not generate extra serializations or build a format-toggle footer speculatively — a footer control is not a reason to create the second format it controls. If the user asks for an additional serialization, produce it as requested. On first RDF use, follow the preference elicitation in rdf-serialization-default-clarification.ttl."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-turtleOnlyDefaultNoImpliedJsonld> .
