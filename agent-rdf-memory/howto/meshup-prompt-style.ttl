@prefix :       <#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<> a schema:CreativeWork ;
    schema:name "HowTo: Meshup Turtle+HTML Prompt Style"@en ;
    schema:description "Standing prompt shape for Turtle + HTML meshup collections: UI/UX expert framing, named source URL, Virtuoso angle on ascribed competitor technology, and load-bearing Linked Data thesis bullets."@en ;
    schema:dateCreated "2026-09-04T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-09-04T00:00:00Z"^^xsd:dateTime ;
    schema:about :HowToMeshupPromptStyle .

:HowToMeshupPromptStyle a schema:HowTo ;
    schema:name "Recognize and execute the meshup Turtle+HTML prompt style"@en ;
    schema:description "When Kingsley uses the meshup collection prompt shape, run kg-generator then rdf-infographic-skill with the Virtuoso angle and thesis bullets as first-class narrative."@en ;
    schema:step :step1, :step2, :step3, :step4 ;
    rdfs:seeAlso <../preferences.ttl#step-meshupPromptStyle> .

:step1 a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Activate UI/UX + visual-communications expert modality"@en ;
    schema:text "The opener Operating as a UI/UX expert well versed in visual communications is not flavor — it binds rdf-infographic-skill operating modality and preferences Step 44."@en .

:step2 a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Named-URL Turtle + HTML collection"@en ;
    schema:text "Produce RDF-Turtle (source of truth) then harness HTML (+ MD companion locally). Frame as notes about the named article when single-source. Shared stem under {LLM_ROOT}/{model}/rdf|webpages|md."@en .

:step3 a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Virtuoso angle on ascribed competitor tech"@en ;
    schema:text "Mesh the source claim about another stack (DuckDB, Neo4j, Excel-as-file, etc.) with a Virtuoso alternative that preserves the insight but upgrades the substrate — often SQL + RDF Views + Linked Data IRIs + SPARQL. Include sample SQL/DDL when relational demo is part of the meshup (prefs Step 277)."@en .

:step4 a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Thesis bullets are load-bearing"@en ;
    schema:text "Short bullets after the request crystallize the Virtuoso framing (cell-ref as IRI, cell-value as dereference, SPARQL as formula, inference as query augmentation). Model them as claims/DefinedTerms in RDF and surface them prominently in the HTML narrative — never treat as optional caption text."@en .
