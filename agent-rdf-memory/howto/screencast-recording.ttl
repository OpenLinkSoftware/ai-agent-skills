@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:HowTo ;
    schema:name "Screencast Recording and Voice-Over Conventions"@en ;
    schema:description "RDF companion procedure for screencast recording, including scene confirmation, model-specific routing, phonetic TTS spellings, recording validation, narration approval, and distribution handoff."@en ;
    schema:dateCreated "2026-08-10T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-22T00:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :screencastRecording ;
    schema:step :stepUseRecorderSkill, :stepConfirmScenes,
        :stepApplyPronunciations, :stepRecordAndVerify,
        :stepApproveNarration, :stepBuildDistributionBundle ;
    rdfs:seeAlso <../preferences.ttl#step-ttsPronunciations>,
        <artifact-routing.ttl>, <screencast-distribution-artifacts.ttl> .

:screencastRecording a schema:Thing ;
    schema:name "Screencast recording workflow"@en .

:stepUseRecorderSkill a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Use the screencast-recorder skill as the executable contract"@en ;
    schema:text "For any requested recording, walkthrough, session capture, or voice-over, follow screencast-recorder/SKILL.md and treat this RDF document as its standing memory companion rather than reimplementing the workflow ad hoc."@en .

:stepConfirmScenes a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Confirm recording scenes before the time-consuming capture"@en ;
    schema:text "Derive candidate URLs or a local report scene from the task, present the ordered scene list and timing controls, and obtain confirmation before recording; preserve only verified URLs."@en .

:stepApplyPronunciations a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Apply the canonical phonetic spellings to TTS input"@en ;
    schema:text "In narration and voice-over input, write URIBurner as 'U-R-I Burner', SPARQL as 'Sparkle', DaaS as 'DAAS' pronounced to rhyme with gas, and ABAC as 'A-BACK'; these spellings are for synthesized speech and need not replace visible technical labels."@en ;
    rdfs:seeAlso <../preferences.ttl#step-ttsPronunciations> .

:stepRecordAndVerify a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Record both delivery formats and verify the media"@en ;
    schema:text "Use the skill's shot-scraper workflow to produce MP4 and WebM, then verify the expected files and media streams before reporting success; route the bundle under the resolved model root's screencasts directory."@en ;
    rdfs:seeAlso <artifact-routing.ttl> .

:stepApproveNarration a schema:HowToStep ;
    schema:position 5 ;
    schema:name "Obtain voice-quality approval before muxing optional narration"@en ;
    schema:text "When narration is requested, generate and deliver the standalone voice track first, wait for explicit approval of voice quality, then mux it into a new narrated MP4 while retaining the original unless deletion was explicitly requested."@en .

:stepBuildDistributionBundle a schema:HowToStep ;
    schema:position 6 ;
    schema:name "Hand off to the screencast distribution contract"@en ;
    schema:text "Build and validate the named presentation HTML, embedded primary MP4, relative media links, JSON-LD, POSH metadata, captions, and attribution according to screencast-distribution-artifacts.ttl."@en ;
    rdfs:seeAlso <screencast-distribution-artifacts.ttl> .
