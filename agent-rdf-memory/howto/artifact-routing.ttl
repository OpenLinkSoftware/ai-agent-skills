@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:HowTo ;
    schema:name "Artifact Routing — Output Directories and Terminology"@en ;
    schema:description "Rules for routing generated artifacts (RDF, HTML, Markdown) to the correct model-specific output directories, preserving active model identity, and applying the meshup vs mashup terminology rule."@en ;
    schema:dateCreated "2026-06-05T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-24T14:45:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:step :step-outputDirs, :step-gpt5ChatCodexOutputDirs,
        :step-mashupVsMeshup, :step-defaultOutputRoot, :step-modelOverEnvironment,
        :step-noPromptModelOverride, :step-outputRootBlockingGate,
        :step-savedPromptsFolder, :step-vspsFolder,
        :step-screencastDistributionArtifacts,
        :step-screencastPresentationNaming,
        :step-scopeFilesystemSearchesToLlmRoot, :step-outputRootGateAppliesBeyondKgGenerator ;
    rdfs:seeAlso <../preferences.ttl#step-outputDirs>, <../preferences.ttl#step-defaultOutputRoot>, <../preferences.ttl#step-gpt5ChatCodexOutputDirs>, <../preferences.ttl#step-modelOverEnvironment>, <../preferences.ttl#step-modelIdentityPreflight>, <../preferences.ttl#step-noPromptModelOverride>, <../preferences.ttl#step-mashupVsMeshup>, <../preferences.ttl#step-savedPromptsFolder>, <../preferences.ttl#step-vspArtifactsFolder>, <../preferences.ttl#step-screencastDistributionArtifacts>, <../preferences.ttl#step-screencastPresentationNaming>, <../preferences.ttl#step-chatResponsePortableLinks>, <../preferences.ttl#step-remoteRemovalOrder>, <remote-resource-removal.ttl> .

# ── Step 1: Output Directory Routing ─────────────────────────────────────────

:step-outputDirs a schema:HowToStep ;
    schema:position "1"^^xsd:integer ;
    schema:name "Route artifacts to model-specific output directories under the canonical LLM root"@en ;
    schema:text """CANONICAL LLM ROOT: {LLM_ROOT}/ — all generated artifacts are written beneath this root, and all local RDF searches (step-kgQueryMode) scan beneath this same root. This symmetry is intentional: the write path and the read path share one root, so any artifact written in a generation workflow is automatically discoverable in a subsequent query workflow. Model-specific subdirectories: DeepSeek V4 Pro → {LLM_ROOT}/DeepSeek/{rdf,md,webpages}/. Claude Sonnet/Opus → {LLM_ROOT}/Claude Generated/{RDF,md,webpages}/. MiniMax → {LLM_ROOT}/MiniMax Generated/{rdf,md,webpages}/. GPT-5 Chat in Codex Desktop → {LLM_ROOT}/GPT5-Chat-Generated/{rdf,md,webpages}/. Kimi → {LLM_ROOT}/kimi/{rdf,md,webpages}/. Grok → {LLM_ROOT}/Grok/{rdf,md,webpages}/. GLM (GLM-5.1, GLM-5.2, and later GLM variants) → {LLM_ROOT}/glm/{rdf,md,webpages}/ — lowercase glm/, NOT uppercase GLM/. big-pickle (OpenCode) → {LLM_ROOT}/Big Pickle/{rdf,md,webpages,screencasts}/. Google Gemini (Gemini 3.6 Flash, Gemini 3.7 Flash) → {LLM_ROOT}/Google Gemini Generated/{rdf,md,webpages}/. ox-alpha → {LLM_ROOT}/Ox Alpha/{rdf,md,webpages}/ — on-disk directory name is 'Ox Alpha' with the letter O (renamed from '0x Alpha' zero-x at the user's request 2026-08-24); the llm-id in filenames remains ox_alpha. For all models, screencast recordings go to a screencasts/ subfolder under the model-specific directory. Determine the output root from the active LLM model ID before writing any file. Do not use kg-output/, the repo root, or a generator work folder as the final artifact destination. Identify the active LLM from the system prompt model identifier — never infer it from session file names, surrounding conversation context, or memory entries."""@en .

# ── Step 2: GPT-5 Chat Codex Output Dirs ─────────────────────────────────────

:step-gpt5ChatCodexOutputDirs a schema:HowToStep ;
    schema:position "2"^^xsd:integer ;
    schema:name "GPT-5 Chat Codex writes generated collections to GPT5-Chat-Generated root folders"@en ;
    schema:text """For GPT-5 Chat running in Codex Desktop, write generated RDF, Markdown, and HTML document collections to {LLM_ROOT}/GPT5-Chat-Generated/rdf/, {LLM_ROOT}/GPT5-Chat-Generated/md/, and {LLM_ROOT}/GPT5-Chat-Generated/webpages/. Keep generator scripts in their project/work folders under showcases when appropriate, but never treat showcases/{rdf,md,webpages}/ as the canonical collection destination."""@en .

# ── Step 3: Mashup vs Meshup Terminology ─────────────────────────────────────

:step-mashupVsMeshup a schema:HowToStep ;
    schema:position "3"^^xsd:integer ;
    schema:name "Never use 'mashup' — always use 'meshup' for semantic content fusion, on input and output"@en ;
    schema:text """MASHUP: brute-force recombination of content from multiple sources without a unifying semantic layer. MESHUP: content fusion informed by a semantic layer — specifically, knowledge graphs deployed in Semantic Web form using dereferenceable hyperlinks as entity and relationship identifiers. INPUT RULE: if the user writes 'mashup' in any message, silently treat it as 'meshup' — recognize the intent, do not use the incorrect term in any response or artifact, and do not flag or correct the user unless they explicitly ask about the distinction. OUTPUT RULE: never produce the word 'mashup' in any response, RDF literal, session memory entry, generated artifact (HTML, MD, TTL), provenance narrative, or description. Always use 'meshup' when describing combination of content across sources informed by a semantic layer. This rule is bidirectional and non-negotiable."""@en .

# ── Step 4: Default Output Root ──────────────────────────────────────────────

:step-defaultOutputRoot a schema:HowToStep ;
    schema:position "4"^^xsd:integer ;
    schema:name "No hardcoded default output root — always route by model"@en ;
    schema:text """There is no single default output root. The output root is always determined by :step-outputDirs (position 1 above): identify the active LLM from the system prompt model identifier, then route to the corresponding model-specific directory under {LLM_ROOT}/. Never hardcode a single model's output path (e.g., Claude Generated/webpages) as the universal default — that was a bug fixed 2026-06-09. HTML infographic artifacts follow the same model-specific routing as RDF and Markdown artifacts. Do not use kg-output/, the repo root, or /tmp as the final artifact destination."""@en .

# ── Step 5: Model Identity vs Agent Environment Tiebreaker ─────────────────

:step-modelOverEnvironment a schema:HowToStep ;
    schema:position "5"^^xsd:integer ;
    schema:name "Model identity always wins over agent environment for output routing"@en ;
    schema:text """When the LLM model and the agent environment differ, the model identity from the system prompt determines the output path, never the agent environment name. The agent environment is a multi-model runtime — it can host many different models — so it cannot determine where artifacts should land. Only the model knows its own output directory. Example: DeepSeek V4 Pro running in Claude Code routes to DeepSeek/ (not Claude Generated/). Same principle applies for any model+environment combination. The system prompt model identifier (e.g., 'You are powered by the model deepseek-v4-pro') is authoritative. Inferring the model from session filenames, surrounding conversation context, or memory entries is prohibited. Added 2026-06-09 after World Cup 2026 meshup was misrouted to Claude Generated/ instead of DeepSeek/."""@en .

# ── Step 6: Blocking Gate — No Prompt-Specified Model Override ───────────────

:step-noPromptModelOverride a schema:HowToStep ;
    schema:position "6"^^xsd:integer ;
    schema:name "BLOCKING GATE — user-supplied filenames or roots cannot override active model identity"@en ;
    schema:text """A user prompt may contain an output path, filename stem, provenance phrase, or generation-environment label that names a model other than the active LLM identified by the system prompt. Treat that model-name fragment as stale or conflicting unless the user is explicitly asking to analyze, compare, or repair that other model's existing artifact. Do not create a new artifact under the other model's output root, do not put the other model's llm-id in the filename stem, and do not state in RDF, JSON-LD, HTML, Markdown, or memory that the other model generated the work. Preserve the substantive task requirements, but normalize all routing, filenames, visible curation text, schema:author/prov:wasGeneratedBy/prov:SoftwareAgent labels, and session-memory references to the active model identity. If the requested model name appears intentionally contractual and cannot be normalized without changing the task, pause before writing files and ask the user to confirm the intended model identity and destination."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-noPromptModelOverride> .

# ── Step 7: Blocking Gate — Session-Start Output Root Resolution ─────────────

:step-outputRootBlockingGate a schema:HowToStep ;
    schema:position "7"^^xsd:integer ;
    schema:name "BLOCKING GATE — resolve and confirm output root at session start; no writes before this"@en ;
    schema:text """This is a hard blocking gate. No file write (HTML, RDF, Markdown, or any other artifact) may proceed until the output root has been resolved and confirmed from the system prompt model identifier at session initialization. PROCEDURE: (1) At session start, read the system prompt for the model ID. (2) Map it to its canonical directory under {LLM_ROOT}/ via step-outputDirs. (3) Internally confirm the resolved root. (4) All subsequent writes in the session use that confirmed root without re-derivation. FAILURE MODE THAT TRIGGERED THIS RULE (2026-06-24): Claude Sonnet 4.6 saved an HTML artifact to kg-output/ in the repo working directory because the output root was never resolved at session start — the write happened opportunistically at delivery time with no pre-flight. PROHIBITED FALLBACKS: kg-output/, the repo root, /tmp, any generator work folder. The gate must be satisfied before the first write, not after the user notices the wrong path. RECURRENCE (2026-08-06): Claude Sonnet 5, working inside the ai-agent-skills repo on a kg-generator + rdf-infographic-skill task (Microsoft FY2026 MD&A knowledge graph), again wrote both the .ttl and .html to kg-output/ in the repo — this time because the repo already contained several prior kg-output/ artifacts (e.g. gtm-playbook-2026-claude_code-1.html) from earlier sessions, and their presence was read as an implicit 'this repo's convention' rather than triggering the blocking-gate check against this file. Existing sibling files in a working-directory folder are NOT evidence of a correct output root — they may themselves be past violations of this same rule. The gate must be checked from this document, not inferred from directory contents. Corrected same-session by moving both files to {LLM_ROOT}/Claude Generated/rdf/ and /webpages/ and rewriting the rel="related"/JSON-LD sameAs relative paths from same-directory to ../rdf/{file}.ttl to match the real sibling-directory convention. RECURRENCE (2026-08-08): Claude Sonnet 5, same repo, kg-generator task (Chief in AI 100 knowledge graph, 100 people/7 categories) — again wrote the .ttl straight to kg-output/ during generation, again reasoning from sibling files already present there ('kg-output/ is the established convention in this repo') instead of consulting this document before the first write. No companion HTML this time, so no relative-link rewrite was needed; corrected by moving the single .ttl file to {LLM_ROOT}/Claude Generated/rdf/ only after the user directly asked whether the output location was correct — the gate should have been checked before generation started, not after delivery on user prompt. Two recurrences of the identical failure mode in the same repo strongly suggest the fix is procedural (check this file's step-outputDirs BEFORE the first Write/Edit call of any kg-generator or rdf-infographic-skill session, not opportunistically at delivery time), not just declarative. RECURRENCE (2026-08-08, third instance): Claude Sonnet 5, same repo, a combined kg-generator + rdf-infographic-skill task (Tony Seale 'Seale's Law' LinkedIn post meshed with four companion documents) — wrote both .ttl and .html to kg-output/ again, AND used the wrong llm-id in the filename stem ('claude_code' instead of 'claude_sonnet_5'), conflating the agent environment (Claude Code) with the model identity (Claude Sonnet 5) despite step-modelOverEnvironment stating the model always wins. Both errors went undetected through generation, validation, and even a live-browser KG Explorer check — the harness contract validator has no check for output-root correctness, only for the artifact's internal contract, so a fully-passing validator run gave false confidence that placement was also correct. User caught it post-delivery by asking 'why isn't this document properly located in LLM root?'. Corrected by copying both files to {LLM_ROOT}/Claude Generated/rdf/ and /webpages/ under the corrected slug, rewriting same-directory .ttl references to ../rdf/{file}.ttl, and deleting the kg-output/ copies. Three recurrences now confirm the harness-contract validator's PASS result must never be read as confirmation of output location — location is a separate, unchecked gate that has to be satisfied first, from this document, before generation begins. RECURRENCE (2026-08-08, fourth instance): Claude Sonnet 5, same repo, a kg-generator + rdf-infographic-skill task (Nimit Mehta ontology-taxonomy LinkedIn post, meshed with agent-rdf-memory's own ontology as a Category-5 'Ontology of Record' example) — wrote both .ttl and .html to kg-output/ again, AND again used 'claude_code' (the agent environment) instead of 'claude_sonnet_5' (the active model) in the filename stem, the same conflation as the third recurrence. This time the harness-contract validator was run TWICE (once after initial generation, once after a follow-up SPARQL-button fix) and passed both times, reinforcing exactly the false-confidence pattern already documented above. Also caught in the same session: the generated SPARQL footer button used the source document IRI instead of the DAV-uploaded graph IRI in its GRAPH clause — a separate, unrelated contract gap in generate_infographic.py, but discovered together with the routing violation because the user's question ('why isn't this document properly located in LLM root? why the constant deviation from prefs?') prompted a full artifact-routing re-check rather than a narrow fix. Corrected by copying both files to {LLM_ROOT}/Claude Generated/rdf/ and /webpages/ under the corrected slug, rewriting the same-directory .ttl link to ../rdf/{file}.ttl, rewriting the DAV graph IRI to match the corrected filename, and deleting the kg-output/ copies. Four recurrences of the identical routing failure (plus two recurrences of the model-vs-environment filename conflation) in the same repo confirm this is not a one-off: the fix must be procedural — check this file's step-outputDirs and step-modelOverEnvironment BEFORE the first Write/Edit call of any kg-generator or rdf-infographic-skill session in this repo, not opportunistically after the user asks why the file is in the wrong place. RECURRENCE (2026-08-10, fifth instance — model-vs-environment filename conflation only, directory itself was correct this time): Claude Sonnet 5, same repo, a kg-generator (Business & Market Analysis template) + rdf-infographic-skill task (Vivian Voss 'The Tool That Was Already There' blog post on DTrace vs eBPF) — the DIRECTORY was correctly resolved to {LLM_ROOT}/Claude Generated/rdf/ and /webpages/ from the first write, but the filename stem again used 'claude_code' (the agent environment) instead of 'claude_sonnet_5' (the active model per the system prompt: 'You are powered by the model named Sonnet 5. The exact model ID is claude-sonnet-5'), the same conflation as the third and fourth recurrences. User caught it with 'You haven't situated the output in the correct LLM root subfolders... Why?' — read broadly, filename identity is part of the same routing-correctness gate this document covers, not a separate concern from directory path. Corrected by renaming both files in place to the claude_sonnet_5 stem and updating every internal cross-reference (rel=related link, JSON-LD relatedLink @id, footer RDF link, SPARQL footer button's GRAPH filename variable). Five total recurrences of the model-vs-environment filename conflation confirm the fix cannot rely on remembering to check at delivery time — it must be a literal pre-write string check (does the chosen filename stem equal the model id derived from the system prompt, not the harness/agent product name) performed in the same pre-flight pass as step-outputDirs, before the first Write call."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-defaultOutputRoot> .

# ── Step 8: saved-prompts/ Sibling Folder for Reproduction Prompts ───────────

:step-savedPromptsFolder a schema:HowToStep ;
    schema:position "8"^^xsd:integer ;
    schema:name "Reusable reproduction prompts go in a saved-prompts/ sibling folder, never inside md/"@en ;
    schema:text """When a user asks for the prompt that would reproduce a generated collection (or any other standalone reusable prompt text) to be saved, write it to {model-root}/saved-prompts/{slug}-reproduction-prompt.md — a SIBLING of rdf/, md/, and webpages/ under the same model-specific output root, never a file placed inside md/. A reproduction prompt is a distinct artifact type from the collection's own Markdown companion document, even though both use the .md extension; conflating them in the same folder makes the companion doc and the meta-prompt indistinguishable at a glance. Found and corrected 2026-07-06: a reproduction prompt was first saved to Claude Generated/md/ alongside the actual MD companion; user corrected it to a new saved-prompts/ sibling directory. Create the directory if it does not yet exist — do not ask for a different location, since the model-specific root itself is already established by step-outputDirs."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-savedPromptsFolder>, <../core.ttl> .

# ── Step 9: vsps/ Sibling Folder for Virtuoso Server Page Artifacts ──────────

:step-vspsFolder a schema:HowToStep ;
    schema:position "9"^^xsd:integer ;
    schema:name "Generated VSP artifacts go in a vsps/ sibling folder under the model-specific output root"@en ;
    schema:text """When a task produces a Virtuoso Server Page (.vsp) — plus any deployment companions such as an isql deploy script or README — write them to {model-root}/vsps/, a SIBLING of rdf/, md/, webpages/, and saved-prompts/ under the output root resolved by step-outputDirs. Group multi-file VSP deliverables in a per-artifact subfolder (e.g. vsps/webpages-weblog/) when more than one VSP collection accumulates. Create the vsps/ directory if it does not yet exist. Established 2026-07-16 when a weblog index.vsp for /DAV/home/kidehen/webpages/ was first misplaced in a repo-root vsp-weblog/ folder and Kingsley routed it to the prefs-discerned destination."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-vspArtifactsFolder> .

# ── Step 10: Screencast Distribution Bundles ────────────────────────────────

:step-screencastDistributionArtifacts a schema:HowToStep ;
    schema:position "10"^^xsd:integer ;
    schema:name "HTML wrappers that embed screencasts are routed with screencast assets, not webpages/"@en ;
    schema:text """When an HTML document embeds, frames, or primarily distributes a screencast/video recording, classify it as part of the screencast distribution bundle. Route it to {model-root}/screencasts/ alongside the MP4/WebM, voiceover MP3, VTT/SRT captions, poster frames, logs, and storyboard files. Do not place such HTML wrappers in {model-root}/webpages/ unless the user explicitly requests a standalone web article/page separate from the screencast bundle.

Bundle rules:
1. Use relative media links inside the HTML for MP4, WebM, MP3, VTT, SRT, and poster assets that live in the same screencasts/ folder.
2. Avoid absolute local file: or /Users/... media URLs in distributable HTML.
3. Apply hero-meta attribution and footer attribution using the skills + AI agent on-behalf-of principal pattern from kg-curation-attribution.ttl.
4. Keep generator scripts and drafts in their work folder if needed, but mirror the final distribution bundle to {model-root}/screencasts/.
5. Remove or clearly supersede any accidental copy in webpages/ so there is only one canonical local distribution location."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-screencastDistributionArtifacts>, <screencast-distribution-artifacts.ttl>, <kg-curation-attribution.ttl>, <infographic-authoring.ttl> .

# ── Step 11: Screencast presentation HTML naming ────────────────────────────

:step-screencastPresentationNaming a schema:HowToStep ;
    schema:position "11"^^xsd:integer ;
    schema:name "Distributable screencast presentation HTML uses {model-display-id}-{topic-slug}-presentation.html"@en ;
    schema:text """Do not ship bare presentation.html as the public screencast page. Name the MP4-embedding distribution HTML:

  {model-display-id}-{topic-slug}-presentation.html

Examples: grok-4.5-context-from-pdf-presentation.html, grok-4.5-context-presentation.html.
Model id uses product-style lowercase with version dots (grok-4.5), not session underscores.
Keep the shot-scraper scene deck as a separate functional file (e.g. presentation-scenes-recording-deck.html).
User preference recorded 2026-07-24 for all future screencast operations."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-screencastPresentationNaming>, <screencast-distribution-artifacts.ttl> .

:step-scopeFilesystemSearchesToLlmRoot a schema:HowToStep ;
    schema:position "12"^^xsd:integer ;
    schema:name "Ad hoc filesystem searches for generated artifacts (duplicate/stale-copy checks, 'where did this file go') scope to {LLM_ROOT}, never a whole-disk find"@en ;
    schema:text """Caught 2026-08-04: while troubleshooting a user report that a live/DAV-hosted ontology.ttl 'hadn't been updated', ran `find / -iname ontology.ttl ...` across the entire filesystem to check for a stale duplicate copy — an unscoped, slow, permission-error-prone search (exit code 1 from `find /` hitting permission-denied system directories), when the artifact-routing write/read symmetry already established in :step-outputDirs makes {LLM_ROOT}/ the only place a generated artifact could legitimately live. A narrower `find "{LLM_ROOT}"` (or even just the specific model subdirectory once the active LLM is known) would have answered the same question faster and without the noise. This applies beyond the KG-ONLY query-mode case already covered by skill-invocation.ttl's LOCAL RDF ROOT rule — it generalizes to ANY ad hoc filesystem lookup for a generated artifact (duplicate checks, 'which copy is this', staleness debugging), not only structured KG retrieval."""@en ;
    rdfs:seeAlso <skill-invocation.ttl> .

# ── Step 13: the output-root blocking gate applies to ANY generated Markdown deliverable, not only kg-generator/rdf-infographic-skill artifacts ──

:step-outputRootGateAppliesBeyondKgGenerator a schema:HowToStep ;
    schema:position "13"^^xsd:integer ;
    schema:name "A drafted chat/forum-reply Markdown file is still a generated artifact subject to step-outputDirs/step-outputRootBlockingGate — scratchpad is never the final destination"@en ;
    schema:text """User correction (2026-08-24): asked to draft a reply for a community.openlinksw.com thread on Virtuoso GQL performance, the agent wrote the .md draft to the session scratchpad directory and left it there after delivering it. All prior recurrences logged under :step-outputRootBlockingGate involved kg-generator or rdf-infographic-skill workflows specifically, which may have narrowed the mental model of when the gate applies to 'KG/infographic generation tasks' rather than 'any generated Markdown/RDF/HTML artifact.' This instance had no kg-generator or rdf-infographic-skill framing at all — it was a plain drafted reply to a technical forum thread, produced by reasoning/research in-conversation, not a skill invocation — yet it is still a generated Markdown deliverable and belongs under {LLM_ROOT}/Claude Generated/md/ per :step-outputDirs, using the model-id filename convention (claude_sonnet_5, not the agent-environment name 'claude_code'), not the session scratchpad. Corrected same-session by moving the file to Claude Generated/md/virtuoso-gql-ingestion-array-optimization-claude_sonnet_5-reply.md and deleting the scratchpad copy. Generalization: the output-root blocking gate is scoped by artifact TYPE — any generated .md/.ttl/.html file meant to persist, be handed to the user as a deliverable, or be posted/sent externally — not by which skill or workflow produced it. A one-off drafted reply, a saved analysis, or a memory-adjacent write-up all qualify equally. Scratchpad remains valid only for genuinely disposable intermediate files that will not be delivered, referenced again, or handed to the user as the finished artifact."""@en ;
    rdfs:seeAlso <../preferences.ttl#step-outputRootGateAppliesBeyondKgGenerator>, <../preferences.ttl#step-outputRootBlockingGate>, <../preferences.ttl#step-outputDirs> .
