@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:CreativeWork ;
    schema:about :memoryShaclValidation ;
    schema:name "How to validate the agent-rdf-memory store with SHACL and the sync gate"@en ;
    schema:description "Shapes, validator, and graph-sync check for the memory store. Covers session document entities, index list items, and HowTo steps."@en ;
    schema:dateCreated "2026-10-08T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-10-08T00:00:00Z"^^xsd:dateTime .

:memoryShaclValidation a schema:HowTo ;
    schema:name "Validate the memory store with SHACL and check graph sync"@en ;
    schema:step :stepRunShapes, :stepReadBaseline, :stepGraphSyncContent ;
    schema:description "Procedural gates (check-memory-gate.py, validate-memory-protocol.py, session-graph-gate.py) remain. SHACL shapes now check the structure of each file."@en .

:stepRunShapes a schema:HowToStep ;
    schema:position "1"^^xsd:integer ;
    schema:name "Run the shapes validator"@en ;
    schema:text "Run python3 scripts/validate-memory-shapes.py from agent-rdf-memory/. It checks every session file, index.ttl and preferences.ttl against shapes/memory-shapes.ttl with pyshacl. Use --strict to exit non-zero on any violation, and --json PATH for the full report."@en .

:stepReadBaseline a schema:HowToStep ;
    schema:position "2"^^xsd:integer ;
    schema:name "Treat failures as a report until the baseline is clean"@en ;
    schema:text "Report-only is the default. Do not edit older files to pass the shapes unless the owner approves each file. New session files must pass before the Stop hook is switched to blocking."@en .

:stepGraphSyncContent a schema:HowToStep ;
    schema:position "3"^^xsd:integer ;
    schema:name "Check graph sync by content, not by counts"@en ;
    schema:text "session-graph-gate.py check compares normalized triple sets with the named graph in Virtuoso. Typed literals are compared by value, blank nodes by structure, and urn:dav:/ and urn:/ are treated as one prefix. Counts and dateModified alone miss value-only edits."@en .
