@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:CreativeWork ;
    schema:name "howto/first-mention-hyperlinks.ttl"@en ;
    schema:description "Companion for preferences.ttl Step 322. Standing rule from the user on 2026-10-06 while building the VOS 7 against QLever benchmark page: the first mention of a named project or product is hyperlinked once, in running prose, and headings never count."@en ;
    schema:dateCreated "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-10-06T00:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :howto .

:howto a schema:HowTo ;
    schema:name "First mention of a named project or product: link it once, in prose, never in a heading"@en ;
    schema:description "The first attempt linked the names inside the page's title heading. The user corrected it: first mention excludes headings. The remaining steps say what does count, where the link goes, and how to keep it right when the text is generated by script."@en ;
    schema:step :step-definition, :step-target, :step-once, :step-nameVariants, :step-generatedText, :step-linkBehaviour, :step-verify ;
    rdfs:seeAlso <../preferences.ttl#step-firstMentionHyperlinks>, <concept-entity-hyperlinking.ttl>,
        <benchmark-report-story-template.ttl#step-engineSubsetEdition> .

:step-definition a schema:HowToStep ;
    schema:position "1"^^xsd:integer ;
    schema:name "The first mention is the first occurrence in running prose, in document order; headings do not count"@en ;
    schema:text "Running prose means paragraphs, list items, captions and generated sentences. The page title, every heading (h1 to h6) and details summary, the navigation, the eyebrow and other labels, buttons, chips, legends, table cells and code are not prose: a name that appears there is neither the first mention nor a link target."@en .

:step-target a schema:HowToStep ;
    schema:position "2"^^xsd:integer ;
    schema:name "Link to the project's canonical repository or homepage, fetched and confirmed before use"@en ;
    schema:text "Fetch the URL, confirm HTTP 200 and that the page title names the right project, and never guess a URL. For software the repository is the default target: Virtuoso Open Source is https://github.com/openlink/virtuoso-opensource and QLever is https://github.com/ad-freiburg/qlever, both confirmed on 2026-10-06."@en ;
    rdfs:seeAlso <../preferences.ttl#step-noFabricatedUrls> .

:step-once a schema:HowToStep ;
    schema:position "3"^^xsd:integer ;
    schema:name "Each name is linked once per page, at its first prose mention; later mentions stay plain"@en ;
    schema:text "Repeated links add noise. Keep every later mention, including bold names in callouts and tables, unlinked."@en .

:step-nameVariants a schema:HowToStep ;
    schema:position "4"^^xsd:integer ;
    schema:name "If the full name appears only in headings, link the first prose mention of the product under its short name, and tell the user"@en ;
    schema:text "In the VOS 7 against QLever page the phrase Virtuoso Open Source occurs only in the title, so the link sits on the first prose mention, VOS 7 in the lede, and the report to the user says so. Do not rewrite the user's prose to manufacture a mention."@en .

:step-generatedText a schema:HowToStep ;
    schema:position "5"^^xsd:integer ;
    schema:name "In script-generated prose, decide first mention with a set of already linked names that is reset at the start of each render and filled in document order"@en ;
    schema:text "Render the hero before the callouts and call one helper, engLink, wherever a name is written into prose. The helper returns a link the first time and plain text afterwards. Resetting the set at the start of every render keeps the rule correct when the page is rescoped: if the lede leader changes to QLever, QLever is linked there and VOS 7 is linked at its first callout mention, with exactly one link per name."@en .

:step-linkBehaviour a schema:HowToStep ;
    schema:position "6"^^xsd:integer ;
    schema:name "Links open in a new tab, look like links, and do not trigger the click handlers around them"@en ;
    schema:text "Use target _blank with rel noopener noreferrer, the link colour with an underline, and make sure a click on the link does not also pin a tile, toggle a filter or run any other handler on its container."@en .

:step-verify a schema:HowToStep ;
    schema:position "7"^^xsd:integer ;
    schema:name "Verify by listing every link: none in a heading, exactly one per name, in the expected place, in the default view and after each control change"@en ;
    schema:text "Run a script that lists the anchors with their text, target and containing region, check that no heading contains one, then rescope the page, hide an engine and restore it, and repeat the list. Report which occurrence was linked."@en .
