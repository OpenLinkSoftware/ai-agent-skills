@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:HowTo ;
    schema:name "Session-Start Preferences Establishment"@en ;
    schema:description "One-time session-start confirmation that the RDF behavioral contract was loaded, including the standing-instruction count, recent additions, and reused memory-load path."@en ;
    schema:dateCreated "2026-07-23T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-22T00:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :preferencesEstablishment ;
    schema:step :stepConfirmParse, :stepCountInstructions,
        :stepIdentifyRecentRules, :stepConfirmLoadPath,
        :stepEmitConfirmation ;
    rdfs:seeAlso <../preferences.ttl#step-preferencesEstablishment>,
        <session-governance.ttl>, <sparql-memory-loading.ttl> .

:preferencesEstablishment a schema:Thing ;
    schema:name "Session-start preferences establishment gate"@en .

:stepConfirmParse a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Confirm the authoritative RDF contract is readable"@en ;
    schema:text "Confirm core.ttl, preferences.ttl, index.ttl, and the selected prior session document were loaded successfully; surface any parse or reference-integrity failure before claiming the contract is established."@en .

:stepCountInstructions a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Count standing instructions from RDF types"@en ;
    schema:text "Count distinct resources typed schema:HowToStep in preferences.ttl using an RDF parser or SPARQL, not line-count heuristics, and label the result as the standing-instruction count."@en .

:stepIdentifyRecentRules a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Identify the latest three to five applicable additions"@en ;
    schema:text "Use the tail of the current preferences manifest and its position or modification evidence to summarize three to five recent applicable rules; do not treat deprecated or superseded rules as active defaults."@en .

:stepConfirmLoadPath a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Confirm the reused memory-load path"@en ;
    schema:text "Report whether the session used file reads or a SPARQL endpoint, following sparql-memory-loading.ttl and the most recent session's onto:usedFileReads or onto:usedSparqlEndpoint declaration."@en ;
    rdfs:seeAlso <sparql-memory-loading.ttl> .

:stepEmitConfirmation a schema:HowToStep ;
    schema:position 5 ;
    schema:name "Emit the preferences confirmation once per session"@en ;
    schema:text "Emit a brief confirmation containing the instruction count, recent additions, and load path after identity establishment; do not repeat it unless the user explicitly requests an updated edition."@en ;
    onto:hasTrigger onto:triggerSessionStart .
