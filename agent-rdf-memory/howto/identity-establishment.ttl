@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix onto: <../ontology.ttl#> .

<> a schema:HowTo ;
    schema:name "Session-Start Identity Establishment"@en ;
    schema:description "Blocking session-start procedure for resolving the active model and credential locations, verifying the user and agent WebID-TLS identities, re-reading the canonical identity template, and reporting the verification outcome without changing identity mode."@en ;
    schema:dateCreated "2026-07-23T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-22T00:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :identityEstablishment ;
    schema:step :stepResolveModel, :stepResolveCredentials,
        :stepVerifyCredentials, :stepCheckDelegation,
        :stepRereadTemplate, :stepEmitIdentityReport ;
    rdfs:seeAlso <../preferences.ttl#step-identityEstablishment>,
        <model-identity-resolution.ttl>, <verified-identity.ttl>,
        <agent-identity.ttl> .

:identityEstablishment a schema:Thing ;
    schema:name "Session-start identity establishment gate"@en .

:stepResolveModel a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Resolve the active model before composing identity or routing output"@en ;
    schema:text "Apply model-identity-resolution.ttl before any identity report so the model name, harness, and artifact root reflect the current runtime rather than a prior session."@en ;
    rdfs:seeAlso <model-identity-resolution.ttl> .

:stepResolveCredentials a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Resolve the credentials root and both credential bundles"@en ;
    schema:text "Resolve the user and agent credential directories using the blocking filesystem procedure in verified-identity.ttl; if resolution fails, report the unresolved path and elicit rather than guessing."@en ;
    rdfs:seeAlso <verified-identity.ttl> .

:stepVerifyCredentials a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Verify both WebID-TLS identities without exposing secrets"@en ;
    schema:text "For the user and agent, verify certificate readability, SAN WebID, validity, fingerprint, and modulus parity with the local profile using verified-identity.ttl; never print, log, or persist a passphrase."@en ;
    rdfs:seeAlso <verified-identity.ttl>, <p12-passphrase-retrieval.ttl> .

:stepCheckDelegation a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Evaluate reciprocal delegation as an informational result"@en ;
    schema:text "Check the user hasIdentityDelegate and agent onBehalfOf assertions as specified by verified-identity.ttl, but do not infer delegation mode from corroboration; identity-mode.ttl controls operational mode separately."@en ;
    rdfs:seeAlso <verified-identity.ttl>, <identity-mode.ttl> .

:stepRereadTemplate a schema:HowToStep ;
    schema:position 5 ;
    schema:name "Re-read the canonical Trigger A response template immediately before reporting"@en ;
    schema:text "Read agent-identity.ttl#workExample-triggerAResponse after verification and use its current fields and badge semantics; do not reproduce a remembered or stale template."@en ;
    rdfs:seeAlso <agent-identity.ttl#workExample-triggerAResponse> .

:stepEmitIdentityReport a schema:HowToStep ;
    schema:position 6 ;
    schema:name "Emit a verified or explicitly unverified identity report"@en ;
    schema:text "Report the user and agent identity status, current model and environment, artifact root, and informational delegation result; if any verification step failed, retain the field and state the exact unverified reason rather than omitting it."@en ;
    onto:hasTrigger onto:triggerSessionStart .
