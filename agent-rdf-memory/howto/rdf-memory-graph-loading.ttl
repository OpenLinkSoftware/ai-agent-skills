@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:CreativeWork ;
    schema:name "RDF Memory Graph Loading and Learning-Evidence Gate"@en ;
    schema:description "HowTo for loading the agent-rdf-memory store into Virtuoso named graphs and running the SPARQL gate that proves session learning evidence."@en ;
    schema:dateCreated "2026-08-14T17:37:02Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-14T17:37:02Z"^^xsd:dateTime ;
    schema:about :rdfMemoryGraphHowto ;
    rdfs:seeAlso <memory-protocol-gate.ttl>, <../scripts/load-agent-rdf-memory.sql>, <../scripts/session-graph-gate.py> .

:rdfMemoryGraphHowto a schema:HowTo ;
    schema:name "Load the RDF memory graph and verify session learning evidence"@en ;
    schema:description "Graph-native companion to memory-protocol-gate.ttl: the store is loaded as named graphs into local Virtuoso and audited via SPARQL — no markdown, no jsonl transcripts."@en ;
    schema:step :stepLoad, :stepCheck, :stepSyncIsql, :stepSyncCurl .

:stepLoad a schema:HowToStep ;
    schema:position 1 ;
    schema:name "Load the store into Virtuoso named graphs"@en ;
    schema:text "Run isql 1111 dba <dba-password> -f agent-rdf-memory/scripts/load-agent-rdf-memory.sql — idempotent (CLEAR + reload), one named graph per Turtle document under urn:dav:/DAV/home/kidehen/agent-rdf-memory/<relpath>. A 28-prefix load-time preamble lets prefix-undeclared documents load cleanly."@en .

:stepCheck a schema:HowToStep ;
    schema:position 2 ;
    schema:name "Check session graph existence and state via SPARQL"@en ;
    schema:text "Run python3 agent-rdf-memory/scripts/session-graph-gate.py check --all — SPARQL ASK/COUNT/dateModified plus index-graph linkage per session. GATE: 0 GRAPH_MISSING, 0 STALE, 0 unindexed before a session counts as learned."@en .

:stepSyncIsql a schema:HowToStep ;
    schema:position 3 ;
    schema:name "Sync deltas via isql (SQL)"@en ;
    schema:text "For any delta: python3 agent-rdf-memory/scripts/session-graph-gate.py sync-sql --all, then run isql 1111 dba <dba-password> -f session-graph-sync.sql. The user supplies the password; it is never stored or displayed."@en .

:stepSyncCurl a schema:HowToStep ;
    schema:position 4 ;
    schema:name "Sync deltas via curl (SPARQL Graph Store PUT)"@en ;
    schema:text "Alternative: python3 agent-rdf-memory/scripts/session-graph-gate.py sync-curl --all — issues curl -u dba: -X PUT to the sparql-graph-crud-auth endpoint; the trailing-colon form makes curl prompt for the password, keeping credentials out of argv and logs."@en .
