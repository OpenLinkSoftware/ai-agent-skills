<> a schema:HowTo ;
    schema:name "Thesis & Framework / OpenLink Brand Template — Standing Preferred Default"@en ;
    schema:description "2026-08-19: the user asked for right-sizing-your-intelligence-spend-claude_sonnet_5-1.html's visual design and demo-data completeness to become the default going forward for kg-generator's Thesis & Framework Article template, not stay a one-off. Saved as rdf-infographic-skill/assets/templates/thesis-framework-openlink-brand-claude_opus_5.html and registered in references/template-options.md as the preferred default for that content shape."@en ;
    schema:dateCreated "2026-08-19T00:00:00Z"^^xsd:dateTime ;
    schema:dateModified "2026-08-19T00:00:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :step-whatItIs, :step-buildLineage, :step-nonNegotiables, :step-selectionRule ;
    schema:step :step-whatItIs, :step-buildLineage, :step-nonNegotiables, :step-selectionRule ;
    rdfs:seeAlso <../preferences.ttl#step-thesisFrameworkTemplatePreference>,
        <../preferences.ttl#step-tierMapDriftFromHandAuthoring>,
        <../references/template-options.md>,
        <openlink-brand-color-scheme.ttl>,
        <css-comment-star-slash-trap.ttl>,
