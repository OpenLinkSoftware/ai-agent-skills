@prefix : <#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a schema:CreativeWork ;
    schema:name "Agent RDF Memory Core"@en ;
    schema:description "Core ontology and user identity for the agent RDF memory system."@en ;
    schema:dateModified "2026-08-19T23:59:00Z"^^xsd:dateTime ;
    schema:author <https://linkedin.com/in/kidehen#this> ;
    schema:about :agentMemory .

:agentMemory a owl:Ontology ;
    schema:name "Agent RDF Memory"@en ;
    schema:description "Session memory store for AI agent tasks, tracking generated artifacts, skill usage, task provenance, and user preferences."@en ;
    schema:dateCreated "2026-05-27T00:00:00"^^xsd:dateTime ;
    rdfs:seeAlso <preferences.ttl> .

# ── Agent Identity (template — fill at runtime) ────────────────────────────────
#
# Template for agent self-identification. At session start, fill the
# placeholders below with the current model, environment, and output path.
#
# Example (filled for GLM-5.1 + OpenCode):
#   :agent a schema:SoftwareApplication ;
#       schema:name "OpenCode"@en ;
#       schema:version "GLM-5.1" ;
#       ...
#
# Example (filled for Claude Sonnet 4.6 + Claude Code):
#   :agent a schema:SoftwareApplication ;
#       schema:name "Claude Code CLI"@en ;
#       schema:version "claude-sonnet-4-6" ;
#       ...

:agent a schema:SoftwareApplication ;
    schema:name "{AGENT_ENV_NAME}"@en ;
    schema:description "AI agent environment running {LLM_MODEL} for task execution, operating under the ai-agent-skills repository contract and RDF memory preferences."@en ;
    schema:version "{LLM_MODEL}" ;
    schema:operatingSystem "macOS" ;
    schema:applicationCategory "AI Agent"@en ;
    schema:author <http://dbpedia.org/resource/OpenLink_Software> .

# ── Agent–User Connection (template — fill at runtime) ────────────────────────
#
# Describes the relationship between the running agent and its principal user.
# At session start, fill {LLM_MODEL}, {AGENT_ENV_NAME}, and {OUTPUT_PATH}.
#
# Example (filled):
#   :connection a schema:Relationship ;
#       schema:description "OpenCode agent (running GLM-5.1) connected to Kingsley Uyi Idehen ..."@en ;
#       schema:additionalType "operates-for"@en .

:connection a schema:Relationship ;
    schema:description "{AGENT_ENV_NAME} agent (running {LLM_MODEL}) connected to Kingsley Uyi Idehen (Founder & CEO, OpenLink Software) as its operator and principal user. The agent executes tasks per the behavioral contract in preferences.ttl, maintains session memory in agent-rdf-memory/, and routes artifacts to {OUTPUT_PATH}."@en ;
    schema:subject :agent ;
    schema:object :user ;
    schema:additionalType "operates-for"@en .

# ── User Identity ────────────────────────────────────────────────────────────

:user a schema:Person ;
    schema:name "Kingsley Uyi Idehen"@en ;
    schema:email "kidehen@openlinksw.com" ;
    schema:jobTitle "Founder & CEO"@en ;
    schema:worksFor <http://dbpedia.org/resource/OpenLink_Software> ;
    owl:sameAs <https://www.linkedin.com/in/kidehen#this> ,
               <https://x.com/kidehen#this> ,
               <https://substack.com/@kidehen#this> .

# ── User Credentials (resolved at session start — see preferences.ttl Step 209) ──

:credentialsRoot a schema:PropertyValue ;
    schema:name "CREDENTIALS_ROOT"@en ;
    schema:description "Root directory for all YouID/WebID PKCS#12 credential bundles referenced elsewhere in preferences.ttl as {CREDENTIALS_ROOT}."@en ;
    schema:value "/Users/kidehen/Documents/Management/Marketing/WebID" ;
    schema:dateCreated "2026-08-16"^^xsd:date .

:userPrincipalCredentials a schema:PropertyValue ;
    schema:name "User principal PKCS#12 bundle (link-in-bio-credentials-5)"@en ;
    schema:description "Kingsley's principal WebID-TLS credential bundle — cert.p12 (plus cert.pem, cert.crt, profile.ttl, certificate.ttl siblings). WebID SAN: https://kingsley.idehen.net/DAV/home/kidehen/Public/YouID/link-in-bio-credentials-5/index.html#netid, owl:sameAs the canonical identity https://www.linkedin.com/in/kidehen#this. Passphrase is never stored here — resolved at unlock time via the chain in howto/p12-passphrase-retrieval.ttl (macOS Keychain item uriburner-p12 first, /tmp/uyi KEY=VALUE file as fallback, user elicitation last), and never printed, logged, or persisted."@en ;
    schema:value "{CREDENTIALS_ROOT}/Templates/YouID/link-in-bio-credentials-5/cert.p12" ;
    schema:dateCreated "2026-08-16"^^xsd:date .

:p12PassphraseKeychainItem a schema:PropertyValue ;
    schema:name "Principal PKCS#12 passphrase — macOS Keychain item"@en ;
    schema:description "PRIMARY source for the link-in-bio-credentials-5 cert.p12 unlock passphrase, LIVE as of 2026-08-18. Generic-password item; read with: security find-generic-password -s uriburner-p12 -a \"$USER\" -w. Created with -T /usr/bin/security so reads are non-interactive. Verified end-to-end: unlocks cert.p12 via openssl and completed an authenticated call against linkeddata.uriburner.com. Replaces /tmp/uyi as primary because that file was mode -rw-r--r-- (world-readable plaintext) in a shared directory; /tmp/uyi remains present as fallback until the user removes it. Passphrase only — the CLIENT CERTIFICATE remains the .p12 FILE at :userPrincipalCredentials, since this environment's curl (LibreSSL-backed) cannot consume a Keychain identity directly for --cert (tested and rejected 2026-08-18, curl error 58). The value itself is never recorded here or anywhere in this repository."@en ;
    schema:value "security find-generic-password -s uriburner-p12 -a \"$USER\" -w" ;
    schema:dateCreated "2026-08-18"^^xsd:date .

:agentDelegateCredentials a schema:PropertyValue ;
    schema:name "Agent delegate PKCS#12 bundle (link-in-bio-agent-credentials)"@en ;
    schema:description "The agent's own delegated WebID-TLS credential bundle, used for on-behalf-of operations per oplcert:hasIdentityDelegate."@en ;
    schema:value "{CREDENTIALS_ROOT}/Templates/YouID/link-in-bio-agent-credentials/cert.p12" ;
    schema:dateCreated "2026-08-16"^^xsd:date .

:virtuosoLocalDbaPasswordKeychainItem a schema:PropertyValue ;
    schema:name "Local Virtuoso dba account password — macOS Keychain item"@en ;
    schema:description "PRIMARY source for the local Virtuoso instance's dba account password (port 1111), LIVE as of 2026-08-19. Generic-password item; read with: security find-generic-password -s virtuoso-local-dba -a \"$USER\" -w. Created with -T /usr/bin/security so reads are non-interactive. Migrated from /tmp/uyi (DBA_PWD=...) with the user's permission, same pattern as :p12PassphraseKeychainItem but a DISTINCT keychain item — the two secrets are never shared or overloaded onto one entry. VERIFIED end-to-end 2026-08-19: an initial migration surfaced a stale /tmp/uyi value (Bad login, VD CL034); the user corrected /tmp/uyi, the Keychain item was re-synced, and isql login now succeeds using the Keychain-sourced value. See howto/virtuoso-local-dba-passphrase-retrieval.ttl. The value itself is never recorded here or anywhere in this repository."@en ;
    schema:value "security find-generic-password -s virtuoso-local-dba -a \"$USER\" -w" ;
    schema:dateCreated "2026-08-19"^^xsd:date .

# ── Output Paths ─────────────────────────────────────────────────────────────

:deepseekOutputPath a schema:PropertyValue ;
    schema:name "DeepSeek V4 Pro output path"@en ;
    schema:description "Generated artifacts (RDF, MD, HTML) from DeepSeek V4 Pro sessions go to {LLM_ROOT}/DeepSeek/ with subfolders rdf/, md/, webpages/."@en ;
    schema:value "{LLM_ROOT}/DeepSeek/" ;
    schema:dateCreated "2026-05-28"^^xsd:date .

:minimaxOutputPath a schema:PropertyValue ;
    schema:name "MiniMax output path"@en ;
    schema:description "Generated artifacts from MiniMax sessions go to {LLM_ROOT}/MiniMax Generated/ with subfolders rdf/, md/, webpages/."@en ;
    schema:value "{LLM_ROOT}/MiniMax Generated/" ;
    schema:dateCreated "2026-05-28"^^xsd:date .

:claudeOutputPath a schema:PropertyValue ;
    schema:name "Claude output path"@en ;
    schema:description "Generated artifacts from Claude sessions go to {LLM_ROOT}/Claude Generated/ with subfolders rdf/, md/, webpages/, saved-prompts/. Lowercase rdf/ is the canonical on-disk directory name — not uppercase RDF/ (corrected 2026-08-13 after on-disk verification found the described casing didn't match the actual 166-file rdf/ directory). saved-prompts/ holds reusable reproduction-prompt .md files for a collection — a sibling of md/, not a file inside it, since a reproduction prompt is a distinct artifact type from the companion Markdown document."@en ;
    schema:value "{LLM_ROOT}/Claude Generated/" ;
    schema:dateCreated "2026-05-28"^^xsd:date ;
    schema:dateModified "2026-07-06"^^xsd:date .

:kimiOutputPath a schema:PropertyValue ;
    schema:name "kimi output path"@en ;
    schema:description "Generated artifacts from kimi sessions go to {LLM_ROOT}/kimi/ with subfolders rdf/, md/, webpages/. Default destination until further notice."@en ;
    schema:value "{LLM_ROOT}/kimi/" ;
    schema:dateCreated "2026-05-28"^^xsd:date .

:grokOutputPath a schema:PropertyValue ;
    schema:name "Grok 4.3 output path"@en ;
    schema:description "Generated artifacts (RDF, MD, HTML) from Grok 4.3 sessions operating in Full Contract Mode go to {LLM_ROOT}/Grok/ with subfolders rdf/, md/, webpages/."@en ;
    schema:value "{LLM_ROOT}/Grok/" ;
    schema:dateCreated "2026-05-30"^^xsd:date .

:glmOutputPath a schema:PropertyValue ;
    schema:name "GLM output path"@en ;
    schema:description "Generated artifacts (RDF, MD, HTML) from GLM sessions (GLM-5.1, GLM-5.2, and later GLM variants) go to {LLM_ROOT}/glm/ with subfolders rdf/, md/, webpages/. Lowercase glm/ is the canonical directory name — not uppercase GLM/."@en ;
    schema:value "{LLM_ROOT}/glm/" ;
    schema:dateCreated "2026-06-26"^^xsd:date .

:bigPickleOutputPath a schema:PropertyValue ;
    schema:name "Big Pickle output path"@en ;
    schema:description "Generated artifacts (RDF, MD, HTML, screencasts) from Big Pickle (OpenCode) sessions go to {LLM_ROOT}/Big Pickle/ with subfolders rdf/, md/, webpages/, screencasts/."@en ;
    schema:value "{LLM_ROOT}/Big Pickle/" ;
    schema:dateCreated "2026-07-02"^^xsd:date .

:googleGeminiOutputPath a schema:PropertyValue ;
    schema:name "Google Gemini output path"@en ;
    schema:description "Generated artifacts (RDF, MD, HTML) from Google Gemini sessions go to {LLM_ROOT}/Google Gemini Generated/ with subfolders rdf/, md/, webpages/."@en ;
    schema:value "{LLM_ROOT}/Google Gemini Generated/" ;
    schema:dateCreated "2026-08-13"^^xsd:date .
