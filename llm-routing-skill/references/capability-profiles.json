{
  "schema": "llm-routing-capability-profiles-v1",
  "description": "Curated seed profiles for LLM routing. Capability scores are 1-5 estimates per dimension, derived from model-family positioning and public knowledge. They are SEEDS — refine via the feedback loop (see SKILL.md 'Feedback Loop') as live quality data accrues. Cost data is never curated here: it comes from llm-prices.com live feeds at graph-build time.",
  "updated_at": "2026-08-19",
  "scale": {
    "1": "Routine — mechanical extraction, classification, formatting",
    "2": "Standard — summarization, simple QA, boilerplate code",
    "3": "Proficient — multi-step reasoning, structured output, real code",
    "4": "Expert — hard reasoning, nuanced writing, long-context synthesis",
    "5": "Frontier — novel research, hardest math/logic, high-stakes accuracy"
  },
  "dimensions": [
    "reasoning", "code", "creative", "long_context", "vision", "tools", "knowledge", "math"
  ],
  "cost_tier_thresholds": {
    "basis": "output price per million tokens (USD)",
    "low": { "max_output_price": 2.0, "label": "cheapest acceptable quality" },
    "medium": { "max_output_price": 15.0, "label": "balanced cost/quality" },
    "high": { "max_output_price": 75.0, "label": "quality-first" },
    "max": { "max_output_price": null, "label": "no cost constraint" }
  },
  "latency_classes": {
    "very-low": { "p50_seconds": 1.0, "label": "interactive, <2s typical" },
    "low": { "p50_seconds": 3.0, "label": "fast, 2-5s typical" },
    "medium": { "p50_seconds": 8.0, "label": "standard, 5-15s typical" },
    "high": { "p50_seconds": 25.0, "label": "slow, 15-60s typical (reasoning models)" },
    "very-high": { "p50_seconds": 90.0, "label": "research-grade, minutes (deep research)" }
  },
