llmrt:code-explanation llmr:dominantDimension "code"@en .

llmrt:sql-generation a llmr:TaskType ;
    rdfs:label "SQL & Query Generation"@en ;
    rdfs:comment "Translate natural language into SQL/SPARQL/GraphQL against known schemas."@en ;
    llmr:requiredCapabilityLevel llmrl:L3 ;
    llmr:tokenSensitivity "medium"@en ;
    llmr:overqualificationRisk "low"@en .
llmrt:sql-generation llmr:dominantDimension "code"@en .
llmrt:sql-generation llmr:dominantDimension "tools"@en .
llmrt:sql-generation llmr:dominantDimension "reasoning"@en .

llmrt:math-reasoning a llmr:TaskType ;
    rdfs:label "Math & Arithmetic"@en ;
    rdfs:comment "Arithmetic, algebra, calculus, word problems, quantitative reasoning."@en ;
    llmr:requiredCapabilityLevel llmrl:L3 ;
    llmr:tokenSensitivity "low"@en ;
    llmr:overqualificationRisk "low"@en .
llmrt:math-reasoning llmr:dominantDimension "math"@en .
