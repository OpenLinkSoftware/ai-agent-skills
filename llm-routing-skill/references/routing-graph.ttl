@prefix llmr: <https://www.openlinksw.com/ontology/llm-routing#> .
@prefix llmrm: <https://www.openlinksw.com/ontology/llm-routing/models/> .
@prefix llmrt: <https://www.openlinksw.com/ontology/llm-routing/tasks/> .
@prefix llmrv: <https://www.openlinksw.com/ontology/llm-routing/vendors/> .
@prefix llmrl: <https://www.openlinksw.com/ontology/llm-routing/levels/> .
@prefix schema: <http://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix intel: <https://linkeddata.uriburner.com/DAV/demos/daas/ontology/intelligence-allocation#> .
@prefix dbr: <http://dbpedia.org/resource/> .

# LLM Routing Graph — generated 2026-08-19T22:49:49Z from llm-prices (updated 2026-08-13)
# Capability/latency values are curated SEEDS (capability-profiles.json);
# cost values are live from llm-prices.com. Rebuild to refresh.
# Ontology TBox (llmr:) embedded verbatim from references/llm-routing-ontology.ttl.

# LLM Routing Ontology (llmr:) — TBox
# Authoritative term definitions for the llm-routing-skill graph.
# Contract: ontology-cross-reference-gate (preferences.ttl) — every term
# carries rdfs:label, rdfs:comment, rdfs:domain/range (properties),
# rdfs:isDefinedBy, and verified external cross-references. Terms marked
# 'no direct schema.org/DBpedia/Wikidata equivalent (checked 2026-08-19)'
# were checked and none exists; the absence is recorded per the
# superproperty-check rule rather than silently omitted.
# This file is embedded verbatim into references/routing-graph.ttl by
# scripts/build_routing_graph.py and is the single source of truth for the
# llmr: vocabulary. Registered in agent-rdf-memory/entities/ontology-terms.ttl.

llmr: a owl:Ontology ;
    rdfs:label "LLM Routing Ontology"@en ;
    rdfs:comment "Model registry + capability x cost x latency graph informing intelligent LLM routing decisions. Sets are repeated triples (llmr:paretoFrontierModel, llmr:dominantDimension); ordered sequences use schema:ItemList/schema:ListItem/schema:position (escalation ladders); capability attributes use schema:additionalProperty + schema:PropertyValue. No blank nodes: reification nodes carry named hash IRIs."@en ;
    schema:name "LLM Routing Ontology"@en ;
    schema:description "Ontology for the llm-routing-skill: model registry, task taxonomy, capability x cost x latency profiles, Pareto frontiers, escalation ladders, feedback records, and governance policy. Instance data lives in references/routing-graph.ttl."@en ;
    rdfs:seeAlso <https://linkeddata.uriburner.com/DAV/demos/daas/ontology/intelligence-allocation#> .

# ── Classes ─────────────────────────────────────────────────────────────────

llmr:Model a rdfs:Class ;
    rdfs:label "LLM Model"@en ;
    rdfs:comment "A large language model offered by a vendor at a per-token price, with a capability profile, latency class, context window, and cost tier. Instances are also typed schema:SoftwareApplication."@en ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:SoftwareApplication, dbr:Language_model .

llmr:TaskType a rdfs:Class ;
    rdfs:label "Task Type"@en ;
    rdfs:comment "A fine-grained category of LLM workload (e.g. code-generation, summarization, logical-reasoning) with a required capability level, dominant capability dimensions, token sensitivity, and overqualification risk. No direct schema.org equivalent (checked 2026-08-19); schema:Action is the closest sibling but denotes an executed action, not a workload category."@en ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso <http://dbpedia.org/resource/Software_agent> .

llmr:CapabilityLevel a rdfs:Class ;
    rdfs:label "Capability Level"@en ;
    rdfs:comment "An ordered proficiency level (L1 Routine .. L5 Frontier) used as the required-capability yardstick for tasks and the achieved-capability ceiling for models."@en ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:Enumeration .

llmr:GovernancePolicy a rdfs:Class ;
    rdfs:label "Governance Policy"@en ;
    rdfs:comment "Operator-controlled routing knobs: approved models, blocked models, residency constraints, and cost-tier caps. Routing intelligence is advisory; governance stays with the operator."@en ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:Policy .

llmr:FeedbackRecord a rdfs:Class ;
    rdfs:label "Feedback Record"@en ;
    rdfs:comment "An append-only record of a routed execution's outcome — model, task, quality score, cost tier, latency, pass/fail — that drives the seed-profile refinement loop."@en ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:Review .

llmr:RoutingTrace a rdfs:Class ;
    rdfs:label "Routing Trace"@en ;
    rdfs:comment "A session-scoped, outcome-level trace of a routed execution: task type, required level, cost tier, policy, chosen model, quality score, observed latency, cost, and escalation events. Produced per routed call by scripts/record_trace.py in line with preferences.ttl session-trace guidelines (secret redaction, opal:ChatSession linkage, intent-to-outcome traceability). Traces are PRIVATE — recorded locally, never uploaded to public surfaces. Harvested by scripts/harvest_traces.py to refine seed capability profiles and rebuild the graph."@en ;
    rdfs:subClassOf llmr:FeedbackRecord ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:Review .

# ── Model properties ────────────────────────────────────────────────────────

llmr:modelId a rdf:Property ;
    rdfs:label "model id"@en ;
    rdfs:comment "Vendor's model identifier (e.g. deepseek-v4-flash). Subproperty of schema:identifier (superproperty check: schema:identifier is the canonical identifier property, verified 2026-08-19)."@en ;
    rdfs:subPropertyOf schema:identifier ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:vendor a rdf:Property ;
    rdfs:label "vendor"@en ;
    rdfs:comment "The organization offering the model. No direct schema.org equivalent for 'vendor of an LLM model' (checked 2026-08-19); schema:provider is the closest sibling."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range schema:Organization ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:provider .

llmr:inputPricePerMTok a rdf:Property ;
    rdfs:label "input price per million tokens"@en ;
    rdfs:comment "USD price per million input tokens. No direct schema.org equivalent (checked 2026-08-19): schema:price is per-unit-of-offer, not per-token; the per-MTok unit is encoded in the property name."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:price .

llmr:outputPricePerMTok a rdf:Property ;
    rdfs:label "output price per million tokens"@en ;
    rdfs:comment "USD price per million output tokens. No direct schema.org equivalent (checked 2026-08-19): schema:price is per-unit-of-offer, not per-token."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:price .

llmr:cachedInputPricePerMTok a rdf:Property ;
    rdfs:label "cached input price per million tokens"@en ;
    rdfs:comment "USD price per million cached (prompt-cached) input tokens, or absent when the model offers no cached-token pricing. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:price .

llmr:costTier a rdf:Property ;
    rdfs:label "cost tier"@en ;
    rdfs:comment "Cost band (low|medium|high|max) derived from output price per MTok against the thresholds in capability-profiles.json; mirrors OpenRouter's cost_tier."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:latencyClass a rdf:Property ;
    rdfs:label "latency class"@en ;
    rdfs:comment "Qualitative latency band (very-low|low|medium|high|very-high) with P50 estimates in capability-profiles.json. Seed value; refined via feedback."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:contextWindowTokens a rdf:Property ;
    rdfs:label "context window tokens"@en ;
    rdfs:comment "Approximate context window size in tokens. Seed value; refine via feedback or vendor specs."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy llmr: .

llmr:profileNote a rdf:Property ;
    rdfs:label "profile note"@en ;
    rdfs:comment "Free-text note on a model's capability seed (e.g. which family rule matched, or a refinement rationale). Subproperty of rdfs:comment."@en ;
    rdfs:subPropertyOf rdfs:comment ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

# ── Task properties ─────────────────────────────────────────────────────────

llmr:requiredCapabilityLevel a rdf:Property ;
    rdfs:label "required capability level"@en ;
    rdfs:comment "The minimum capability level (llmrl:L1..L5) a model must reach to be routed this task type. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:TaskType ;
    rdfs:range llmr:CapabilityLevel ;
    rdfs:isDefinedBy llmr: .

llmr:dominantDimension a rdf:Property ;
    rdfs:label "dominant capability dimension"@en ;
    rdfs:comment "A capability dimension (reasoning, code, creative, long_context, vision, tools, knowledge, math) that dominates fitness for this task type. Repeated triples form a set — never an RDF list."@en ;
    rdfs:domain llmr:TaskType ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:paretoFrontierModel a rdf:Property ;
    rdfs:label "Pareto frontier model"@en ;
    rdfs:comment "A model on the cost-quality Pareto frontier for this task type: no other model has >= capability at <= price and <= latency (strict on at least one). Repeated triples form the frontier set."@en ;
    rdfs:domain llmr:TaskType ;
    rdfs:range llmr:Model ;
    rdfs:isDefinedBy llmr: .

llmr:tokenSensitivity a rdf:Property ;
    rdfs:label "token sensitivity"@en ;
    rdfs:comment "How strongly output quality depends on input length (low|medium|high|very-high). No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:TaskType ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:overqualificationRisk a rdf:Property ;
    rdfs:label "overqualification risk"@en ;
    rdfs:comment "Risk that a frontier model is overkill for this task (low|medium|high) — high for routine tasks where cheap models suffice. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:TaskType ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

# ── Governance properties ───────────────────────────────────────────────────

llmr:approvesModel a rdf:Property ;
    rdfs:label "approves model"@en ;
    rdfs:comment "Operator-approved model id for this governance policy. Range is xsd:string (model id), not llmr:Model, because approvals may name models absent from the price feed."@en ;
    rdfs:domain llmr:GovernancePolicy ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:blocksModel a rdf:Property ;
    rdfs:label "blocks model"@en ;
    rdfs:comment "Operator-blocked model id for this governance policy. Same range rationale as llmr:approvesModel."@en ;
    rdfs:domain llmr:GovernancePolicy ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:residencyConstraint a rdf:Property ;
    rdfs:label "residency constraint"@en ;
    rdfs:comment "Data-residency region constraint for this governance policy. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:GovernancePolicy ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

# ── Feedback properties ─────────────────────────────────────────────────────

llmr:feedbackModel a rdf:Property ;
    rdfs:label "feedback model"@en ;
    rdfs:comment "The model a feedback record scored. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range llmr:Model ;
    rdfs:isDefinedBy llmr: .

llmr:feedbackTask a rdf:Property ;
    rdfs:label "feedback task"@en ;
    rdfs:comment "The task type a feedback record scored. No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range llmr:TaskType ;
    rdfs:isDefinedBy llmr: .

llmr:qualityScore a rdf:Property ;
    rdfs:label "quality score"@en ;
    rdfs:comment "Output quality score 1-5 assigned after execution. No direct schema.org equivalent (checked 2026-08-19); schema:reviewRating is the closest sibling."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:reviewRating .

llmr:passedVerification a rdf:Property ;
    rdfs:label "passed verification"@en ;
    rdfs:comment "Whether the output passed the task's verification gate (boolean)."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy llmr: .

llmr:observedLatency a rdf:Property ;
    rdfs:label "observed latency"@en ;
    rdfs:comment "Observed latency class during execution (very-low|low|medium|high|very-high)."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:feedbackDate a rdf:Property ;
    rdfs:label "feedback date"@en ;
    rdfs:comment "ISO date the feedback was recorded."@en ;
    rdfs:domain llmr:FeedbackRecord ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy llmr: .

# ── Trace properties (llmr:RoutingTrace) ────────────────────────────────────

llmr:tracedTask a rdf:Property ;
    rdfs:label "traced task"@en ;
    rdfs:comment "The task type a routing trace routed. Domain llmr:RoutingTrace (inherits FeedbackRecord domain via subclass); kept as a distinct property so a trace can be authored without a manual feedback score."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range llmr:TaskType ;
    rdfs:isDefinedBy llmr: .

llmr:tracedModel a rdf:Property ;
    rdfs:label "traced model"@en ;
    rdfs:comment "The model a routing trace selected. Domain llmr:RoutingTrace."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range llmr:Model ;
    rdfs:isDefinedBy llmr: .

llmr:costTierUsed a rdf:Property ;
    rdfs:label "cost tier used"@en ;
    rdfs:comment "The operator's chosen cost tier (low|medium|high|max) for this routed execution. Distinct from llmr:costTier (a Model's derived band) — this records the policy choice, not the model's classification."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:policyUsed a rdf:Property ;
    rdfs:label "policy used"@en ;
    rdfs:comment "The routing policy applied (cost-first|balanced|quality-first|latency-first) for this routed execution."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

llmr:costIncurred a rdf:Property ;
    rdfs:label "cost incurred"@en ;
    rdfs:comment "Actual USD cost of the routed execution (output tokens x output price). No direct schema.org equivalent (checked 2026-08-19); schema:price is per-unit-of-offer."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy llmr: ;
    rdfs:seeAlso schema:price .

llmr:escalationEvent a rdf:Property ;
    rdfs:label "escalation event"@en ;
    rdfs:comment "One escalation event on the advisor ladder (model id or rung label) that occurred during this execution. Repeated triples form an ordered sequence when combined with schema:position on the event node; simple trace records repeat this property in escalation order."@en ;
    rdfs:domain llmr:RoutingTrace ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy llmr: .

# ── Graph-dataset property ──────────────────────────────────────────────────

llmr:priceUpdated a rdf:Property ;
    rdfs:label "price updated"@en ;
    rdfs:comment "Date the llm-prices.com pricing feed was last updated, attached to each llmr:Model (price provenance). No direct schema.org equivalent (checked 2026-08-19)."@en ;
    rdfs:domain llmr:Model ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy llmr: .

llmr:graphPriceUpdated a rdf:Property ;
    rdfs:label "graph price updated"@en ;
    rdfs:comment "Date the llm-prices.com pricing feed was last updated, attached to the routing-graph schema:Dataset (feed date for the whole graph). Separate from llmr:priceUpdated so each property keeps a single concrete domain (Step 37: no blank-node union expressions)."@en ;
    rdfs:domain schema:Dataset ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy llmr: .

llmr: schema:dateModified "2026-08-19T22:49:49Z"^^xsd:dateTime .

llmrl:L1 a llmr:CapabilityLevel ;
    rdfs:label "Capability Level 1"@en ;
    rdfs:comment "Routine — mechanical extraction, classification, formatting"@en .

llmrl:L2 a llmr:CapabilityLevel ;
    rdfs:label "Capability Level 2"@en ;
    rdfs:comment "Standard — summarization, simple QA, boilerplate code"@en .

llmrl:L3 a llmr:CapabilityLevel ;
    rdfs:label "Capability Level 3"@en ;
    rdfs:comment "Proficient — multi-step reasoning, structured output, real code"@en .

llmrl:L4 a llmr:CapabilityLevel ;
    rdfs:label "Capability Level 4"@en ;
    rdfs:comment "Expert — hard reasoning, nuanced writing, long-context synthesis"@en .

llmrl:L5 a llmr:CapabilityLevel ;
    rdfs:label "Capability Level 5"@en ;
    rdfs:comment "Frontier — novel research, hardest math/logic, high-stakes accuracy"@en .

llmrv:amazon a schema:Organization ;
    schema:name "amazon"@en .

llmrv:anthropic a schema:Organization ;
    schema:name "anthropic"@en .

llmrv:deepseek a schema:Organization ;
    schema:name "deepseek"@en .

llmrv:google a schema:Organization ;
    schema:name "google"@en .

llmrv:meta_ai a schema:Organization ;
    schema:name "meta-ai"@en .

llmrv:minimax a schema:Organization ;
    schema:name "minimax"@en .

llmrv:mistral a schema:Organization ;
    schema:name "mistral"@en .

llmrv:moonshot_ai a schema:Organization ;
    schema:name "moonshot-ai"@en .

llmrv:openai a schema:Organization ;
    schema:name "openai"@en .

llmrv:qwen a schema:Organization ;
    schema:name "qwen"@en .

llmrv:xai a schema:Organization ;
    schema:name "xai"@en .

llmrt:chat-conversation a llmr:TaskType ;
    rdfs:label "General Conversation"@en ;
    rdfs:comment "Open-ended chat, small talk, persona dialogue, ideation banter."@en ;
    llmr:requiredCapabilityLevel llmrl:L1 ;
    llmr:tokenSensitivity "low"@en ;
    llmr:overqualificationRisk "high"@en .
llmrt:chat-conversation llmr:dominantDimension "knowledge"@en .
llmrt:chat-conversation llmr:dominantDimension "creative"@en .

llmrt:summarization a llmr:TaskType ;
    rdfs:label "Summarization"@en ;
    rdfs:comment "Condense documents, transcripts, or threads into concise faithful summaries."@en ;
    llmr:requiredCapabilityLevel llmrl:L2 ;
    llmr:tokenSensitivity "high"@en ;
    llmr:overqualificationRisk "medium"@en .
llmrt:summarization llmr:dominantDimension "long_context"@en .
llmrt:summarization llmr:dominantDimension "knowledge"@en .

llmrt:information-extraction a llmr:TaskType ;
    rdfs:label "Information Extraction"@en ;
    rdfs:comment "Extract entities, facts, fields, and relations into structured form."@en ;
    llmr:requiredCapabilityLevel llmrl:L1 ;
    llmr:tokenSensitivity "medium"@en ;
    llmr:overqualificationRisk "high"@en .
llmrt:information-extraction llmr:dominantDimension "knowledge"@en .
llmrt:information-extraction llmr:dominantDimension "tools"@en .

llmrt:classification-tagging a llmr:TaskType ;
    rdfs:label "Classification & Tagging"@en ;
    rdfs:comment "Assign labels, categories, intents, or severity to text."@en ;
    llmr:requiredCapabilityLevel llmrl:L1 ;
    llmr:tokenSensitivity "low"@en ;
    llmr:overqualificationRisk "high"@en .
llmrt:classification-tagging llmr:dominantDimension "knowledge"@en .

llmrt:sentiment-analysis a llmr:TaskType ;
    rdfs:label "Sentiment Analysis"@en ;
    rdfs:comment "Detect sentiment, emotion, tone, or stance in text."@en ;
    llmr:requiredCapabilityLevel llmrl:L1 ;
    llmr:tokenSensitivity "low"@en ;
    llmr:overqualificationRisk "high"@en .
llmrt:sentiment-analysis llmr:dominantDimension "knowledge"@en .

llmrt:question-answering-open a llmr:TaskType ;
    rdfs:label "Open-Book Question Answering"@en ;
    rdfs:comment "Answer questions grounded in provided context (RAG, documents, tool results)."@en ;
    llmr:requiredCapabilityLevel llmrl:L2 ;
    llmr:tokenSensitivity "high"@en ;
    llmr:overqualificationRisk "medium"@en .
llmrt:question-answering-open llmr:dominantDimension "reasoning"@en .
llmrt:question-answering-open llmr:dominantDimension "long_context"@en .

llmrt:question-answering-closed a llmr:TaskType ;
    rdfs:label "Closed-Book Question Answering"@en ;
    rdfs:comment "Answer from parametric knowledge without external context."@en ;
    llmr:requiredCapabilityLevel llmrl:L3 ;
    llmr:tokenSensitivity "medium"@en ;
    llmr:overqualificationRisk "low"@en .
llmrt:question-answering-closed llmr:dominantDimension "knowledge"@en .
llmrt:question-answering-closed llmr:dominantDimension "reasoning"@en .

llmrt:code-generation a llmr:TaskType ;
    rdfs:label "Code Generation"@en ;
    rdfs:comment "Write code from a specification or natural-language requirement."@en ;
    llmr:requiredCapabilityLevel llmrl:L3 ;
    llmr:tokenSensitivity "high"@en ;
    llmr:overqualificationRisk "low"@en .
llmrt:code-generation llmr:dominantDimension "code"@en .
llmrt:code-generation llmr:dominantDimension "reasoning"@en .

llmrt:code-completion a llmr:TaskType ;
    rdfs:label "Code Completion"@en ;
    rdfs:comment "Complete or infill code at a cursor or stub point."@en ;
    llmr:requiredCapabilityLevel llmrl:L2 ;
    llmr:tokenSensitivity "medium"@en ;
    llmr:overqualificationRisk "medium"@en .
llmrt:code-completion llmr:dominantDimension "code"@en .

llmrt:code-review-debug a llmr:TaskType ;
    rdfs:label "Code Review & Debugging"@en ;
    rdfs:comment "Find bugs, security issues, and improvements; explain failures."@en ;
    llmr:requiredCapabilityLevel llmrl:L3 ;
    llmr:tokenSensitivity "medium"@en ;
    llmr:overqualificationRisk "low"@en .
llmrt:code-review-debug llmr:dominantDimension "code"@en .
llmrt:code-review-debug llmr:dominantDimension "reasoning"@en .

llmrt:code-explanation a llmr:TaskType ;
