uthority-table th,.authority-table td{border-bottom:1px solid var(--line);padding:9px 10px;text-align:left;vertical-align:top}.authority-table th{background:var(--bg);font-size:.78rem;text-transform:uppercase;color:var(--muted)}.table-wrap{overflow:auto;border-radius:8px}.missing{color:var(--muted);font-style:italic}.unresolved-list{columns:2;list-style:none;padding:0}.unresolved-list li{break-inside:avoid;margin:0 0 5px}.unresolved-list span{color:var(--muted);font-weight:800}.bracket-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;align-items:stretch}.bracket-card{position:relative;display:grid;gap:8px;border-top:4px solid var(--primary)}.round-index{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--primary);color:#06221e;font-weight:900}.round-meta{display:flex;gap:8px;flex-wrap:wrap}.round-meta span{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:5px 8px;color:var(--muted);font-size:.82rem;font-weight:800}.bracket-note{color:var(--muted);max-width:820px}.nav-panel{position:fixed;z-index:900;top:16px;left:16px;background:var(--panel);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);max-width:min(330px,calc(100vw - 32px))}.nav-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px}.nav-body{display:none;padding:0 12px 12px}.nav-panel.open .nav-body{display:grid;gap:8px}.nav-body a{display:block;text-decoration:none;font-weight:800}.theme-toggle,.nav-toggle,button{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:6px;padding:8px 10px;font-weight:800;cursor:pointer}button.active,#kgSettings[aria-expanded='true']{background:var(--primary);border-color:var(--primary);color:#06221e}#kg-explorer{position:relative}.kg-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.kg-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.badge{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:7px 11px;color:var(--muted);font-weight:750}#kgToolbar[hidden],[hidden]{display:none!important}#kgToolbar{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px;margin:14px 0;display:flex;gap:12px;flex-wrap:wrap;align-items:end}.tb-group{display:grid;gap:5px}.tb-label{font-size:.64rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);font-weight:850}.tb-sep{width:1px;align-self:stretch;background:var(--line)}input,select,textarea{border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--text);padding:8px;width:100%}#pred-filters{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;min-width:280px}.predicate-box{font-size:.86rem;color:var(--muted)}#settingsPanel{position:fixed;inset:7vh 10vw;z-index:950;background:var(--panel);border:1px solid var(--line);border-radius:8px;box-shadow:0 28px 80px rgba(0,0,0,.4);padding:18px;overflow:auto}.settings-actions{display:flex;justify-content:space-between;align-items:center}.settings-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}.slider-field{border:1px solid var(--line);border-radius:8px;padding:12px;background:var(--bg)}.slider-head{display:flex;justify-content:space-between;gap:10px}.slider-label{font-weight:800}.slider-val{color:var(--accent2);font-weight:850}#kg-svg{width:100%;height:600px;border:1px solid var(--line);border-radius:8px;background:var(--panel)}#kg-explorer.kg-active #kg-svg{box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 35%,transparent)}.node text{font-size:11px;paint-order:stroke;stroke:var(--panel);stroke-width:3px}.link-label{font-size:10px;fill:var(--muted);paint-order:stroke;stroke:var(--panel);stroke-width:3px}.sparql-box{display:grid;gap:10px}.sparql-box textarea{min-height:180px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}.small{font-size:.9rem;color:var(--muted)}code{white-space:normal}
