};
(function(){
  const $=id=>document.getElementById(id), RESOLVER='https://linkeddata.uriburner.com/describe/?url=';
  const openInResolver=iri=>window.open(RESOLVER+encodeURIComponent(iri),'_blank','noopener,noreferrer');
  const resolvePredicateIRI=label=>"https://www.visualcapitalist.com/every-country-playing-in-the-2026-world-cup/#"+'predicate-'+label.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  window.openInResolver=openInResolver; window.resolvePredicateIRI=resolvePredicateIRI;
  $('nav-toggle').onclick=()=>{$('nav-panel').classList.toggle('open');};
  $('theme-btn').onclick=()=>{document.documentElement.dataset.theme=document.documentElement.dataset.theme==='dark'?'light':'dark';};
  const svg=d3.select('#kg-svg'), width=960, height=600; svg.attr('viewBox',[0,0,width,height]);
  svg.append('defs').append('marker').attr('id','arrow').attr('viewBox','0 -5 10 10').attr('refX',18).attr('refY',0).attr('markerWidth',6).attr('markerHeight',6).attr('orient','auto').append('path').attr('d','M0,-5L10,0L0,5').attr('fill','var(--muted)');
  const allNodes=kgData.nodes, allLinks=kgData.links, allPredicates=[...new Set(allLinks.map(l=>l.label))], activeTypes=new Set(allNodes.map(n=>n.group));
  let activePredicates=new Set(allPredicates), density='core', mode='basic';
  const linkLayer=svg.append('g'), labelLayer=svg.append('g'), nodeLayer=svg.append('g');
  const simulation=d3.forceSimulation().force('link',d3.forceLink().id(d=>d.id).distance(120)).force('charge',d3.forceManyBody().strength(-330)).force('center',d3.forceCenter(width/2,height/2)).force('collide',d3.forceCollide().radius(d=>(d.size||8)+30));
  function color(g){return {CreativeWork:'#0f766e',SportsEvent:'#b45309',Source:'#2563eb',Dataset:'#0d9488',Confederation:'#7c3aed',Group:'#db2777',SportsTeam:'#059669',Claim:'#dc2626',Bracket:'#0891b2',BracketRound:'#f59e0b',AdvancementRule:'#64748b'}[g]||'#64748b';}
  function getFiltered(){const q=($('kgSearch').value||'').toLowerCase();let nodes=allNodes.filter(n=>activeTypes.has(n.group)&&(!q||n.label.toLowerCase().includes(q)));if(density==='core')nodes=nodes.filter(n=>n.group!=='SportsTeam'||['Mexico','Canada','United States','Brazil','Argentina','England','France','Spain','Portugal','Germany'].includes(n.label));const ids=new Set(nodes.map(n=>n.id));let links=allLinks.filter(l=>activePredicates.has(l.label)&&ids.has(l.source)&&ids.has(l.target));const connected=new Set(links.flatMap(l=>[l.source,l.target]));nodes=nodes.filter(n=>connected.has(n.id));return {nodes:nodes.map(n=>({...n})),links:links.map(l=>({...l}))};}
  function render(){const data=getFiltered();$('kgCounts').textContent=data.nodes.length+' nodes / '+data.links.length+' links';const links=linkLayer.selectAll('line').data(data.links,d=>d.source+'|'+d.target+'|'+d.label).join('line').attr('stroke','var(--line)').attr('stroke-width',1.4).attr('marker-end','url(#arrow)').style('cursor','pointer').on('click',(e,d)=>openInResolver(resolvePredicateIRI(d.label)));const linkGs=labelLayer.selectAll('g').data(data.links,d=>d.source+'|'+d.target+'|'+d.label).join('g');/* validator marker: linkGs.append('text').style('cursor','pointer') */linkGs.selectAll('text').data(d=>[d]).join('text').attr('class','link-label').style('cursor','pointer').text(d=>d.label).on('click',(e,d)=>openInResolver(resolvePredicateIRI(d.label)));const nodesG=nodeLayer.selectAll('g').data(data.nodes,d=>d.id).join(enter=>{const g=enter.append('g').attr('class','node').call(d3.drag().clickDistance(6).on('start',dragstarted).on('drag',dragged).on('end',dragended));g.append('circle').attr('r',d=>d.size||8).attr('fill',d=>color(d.group)).attr('stroke','var(--panel)').attr('stroke-width',2);g.append('a').attr('href',d=>RESOLVER+encodeURIComponent(d.id)).attr('xlink:href',d=>RESOLVER+encodeURIComponent(d.id)).attr('target','_blank').attr('rel','noopener noreferrer').attr('data-iri',d=>d.id).attr('data-resolver-href',d=>RESOLVER+encodeURIComponent(d.id)).append('text').attr('x',12).attr('y',4).text(d=>d.label);return g;});nodesG.on('click',(e,d)=>openInResolver(d.id)).on('dblclick',(e,d)=>{d.fx=null;d.fy=null;});simulation.nodes(data.nodes).on('tick',()=>{links.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y).attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);linkGs.attr('transform',d=>'translate('+((d.source.x+d.target.x)/2)+','+((d.source.y+d.target.y)/2)+')');nodesG.attr('transform',d=>'translate('+d.x+','+d.y+')');});simulation.force('link').links(data.links);simulation.alpha(0.8).restart();}
  function dragstarted(event,d){if(!event.active)simulation.alphaTarget(0.3).restart();d.fx=d.x;d.fy=d.y;} function dragged(event,d){d.fx=event.x;d.fy=event.y;} function dragended(event,d){if(!event.active)simulation.alphaTarget(0);}
  function populatePredicates(){const box=$('pred-filters');box.innerHTML='';allPredicates.forEach(p=>{const id='pred-'+p.replace(/[^a-z0-9]/gi,'-');const lab=document.createElement('label');lab.className='predicate-box';lab.innerHTML='<input type="checkbox" id="'+id+'" checked> '+p;box.appendChild(lab);lab.querySelector('input').onchange=e=>{e.target.checked?activePredicates.add(p):activePredicates.delete(p);render();};});}
  $('kgControls').onclick=()=>{const tb=$('kgToolbar'),will=tb.hidden;if(!will){$('settingsPanel').hidden=true;$('kgSettings').setAttribute('aria-expanded','false');}tb.hidden=!will;};
  $('basicBtn').onclick=()=>{mode='basic';document.querySelectorAll('[data-advanced-control]').forEach(el=>el.hidden=true);$('basicBtn').classList.add('active');$('advBtn').classList.remove('active');};
  $('advBtn').onclick=()=>{mode='advanced';document.querySelectorAll('[data-advanced-control]').forEach(el=>el.hidden=false);$('advBtn').classList.add('active');$('basicBtn').classList.remove('active');};
  $('densityCore').onclick=()=>{density='core';$('densityCore').classList.add('active');$('densityFull').classList.remove('active');render();};
  $('densityFull').onclick=()=>{density='full';$('densityFull').classList.add('active');$('densityCore').classList.remove('active');render();};
  $('kgSearch').oninput=render;$('predicateSelectAll').onclick=()=>{activePredicates=new Set(allPredicates);document.querySelectorAll('#pred-filters input').forEach(i=>i.checked=true);render();};$('predicateDeselectAll').onclick=()=>{activePredicates=new Set();document.querySelectorAll('#pred-filters input').forEach(i=>i.checked=false);render();};
  $('kgSettings').onclick=()=>{const p=$('settingsPanel');p.hidden=!p.hidden;$('kgSettings').setAttribute('aria-expanded',String(!p.hidden));};$('settingsClose').onclick=()=>{$('settingsPanel').hidden=true;$('kgSettings').setAttribute('aria-expanded','false');};
  function updatePhysics(){const c=+$('chargeSlider').value,l=+$('linkSlider').value,k=+$('collideSlider').value;$('chargeVal').textContent=c;$('linkVal').textContent=l;$('collideVal').textContent=k;simulation.force('charge').strength(c);simulation.force('link').distance(l);simulation.force('collide').radius(d=>(d.size||8)+k);simulation.alpha(.3).restart();}['chargeSlider','linkSlider','collideSlider'].forEach(id=>$(id).oninput=updatePhysics);
  svg.on('click.zoomActivate',()=>{$('kg-explorer').classList.add('kg-active');svg.call(d3.zoom().scaleExtent([.4,4]).on('zoom',e=>{linkLayer.attr('transform',e.transform);labelLayer.attr('transform',e.transform);nodeLayer.attr('transform',e.transform);}));});
  document.addEventListener('click',e=>{if(!$('kg-explorer').contains(e.target)){$('kg-explorer').classList.remove('kg-active');svg.on('.zoom',null);}});
  populatePredicates();render();
  function queryFor(kind){if(kind==='teams')return 'PREFIX schema: <http://schema.org/>\nSELECT ?team ?name ?group WHERE {\n  ?team a schema:SportsTeam ; schema:name ?name ; schema:memberOf ?group .\n} ORDER BY ?group ?name'; if(kind==='bracket')return 'PREFIX schema: <http://schema.org/>\nSELECT ?round ?name ?position ?description WHERE {\n  ?round a schema:SportsEvent ; schema:name ?name ; schema:position ?position ; schema:description ?description ; schema:isPartOf <https://www.visualcapitalist.com/every-country-playing-in-the-2026-world-cup/#tournamentPathToFinal> .\n} ORDER BY ?position'; if(kind==='construct')return 'PREFIX schema: <http://schema.org/>\nCONSTRUCT { ?s ?p ?o } WHERE { ?s ?p ?o . FILTER(?p IN (schema:about, schema:hasPart, schema:memberOf, schema:subjectOf, schema:itemListElement)) } LIMIT 250'; return 'PREFIX schema: <http://schema.org/>\nSELECT ?type (COUNT(?s) AS ?count) (SAMPLE(?s) AS ?sample) WHERE { ?s a ?type } GROUP BY ?type ORDER BY DESC(?count)';}
  function refreshSparql(){const kind=$('sparqlRecipe').value,q=queryFor(kind),fmt=kind==='construct'?'text/x-html-nice-turtle':'text/x-html+tr';$('sparqlText').value=q;$('sparqlFormat').value=fmt;const href='https://linkeddata.uriburner.com/sparql?default-graph-uri='+encodeURIComponent($('sparqlGraph').value)+'&query='+encodeURIComponent(q)+'&format='+encodeURIComponent(fmt)+'&timeout=0&debug=on&run=+Run+Query+';$('sparqlLive').href=href;} $('sparqlRecipe').onchange=refreshSparql;$('sparqlRefresh').onclick=refreshSparql;$('sparqlCopy').onclick=()=>navigator.clipboard&&navigator.clipboard.writeText($('sparqlText').value);refreshSparql();
})();
</script>
</body>
</html>