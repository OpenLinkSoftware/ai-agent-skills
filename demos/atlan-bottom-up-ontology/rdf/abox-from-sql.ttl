<http://localhost:8890/atlan-cc/source/1#this> a a:Source ;
  a:preferredLabel "Cloud Warehouse" ;
  a:systemType "warehouse" .
<http://localhost:8890/atlan-cc/source/1#this> rdfs:comment "Analyst SQL in the cloud warehouse" .
