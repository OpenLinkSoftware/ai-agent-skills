  a:preferredLabel "Metadata Catalog" ;
  a:systemType "catalog" .
<http://localhost:8890/atlan-cc/source/4#this> rdfs:comment "Catalogued metric definitions" .
<http://localhost:8890/atlan-cc/entity/1#this> a a:Entity ;
  a:preferredLabel "Opportunity" ;
  skos:prefLabel "Opportunity" .
<http://localhost:8890/atlan-cc/entity/1#this> rdfs:comment "A sales opportunity / deal" .
<http://localhost:8890/atlan-cc/entity/2#this> a a:Entity ;
