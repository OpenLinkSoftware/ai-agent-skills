  skos:prefLabel "Account" .
<http://localhost:8890/atlan-cc/entity/2#this> rdfs:comment "A customer or prospect account" .
<http://localhost:8890/atlan-cc/entity/1#this> a:altLabel "Deal" ; skos:altLabel "Deal" .
<http://localhost:8890/atlan-cc/entity/1#this> a:altLabel "Opp" ; skos:altLabel "Opp" .
<http://localhost:8890/atlan-cc/entity/2#this> a:altLabel "Company" ; skos:altLabel "Company" .
<http://localhost:8890/atlan-cc/entity/2#this> a:altLabel "Customer" ; skos:altLabel "Customer" .
<http://localhost:8890/atlan-cc/metric/1#this> a a:Metric ;
  a:preferredLabel "Win Rate" ;
  a:forEntity <http://localhost:8890/atlan-cc/entity/1#this> .
<http://localhost:8890/atlan-cc/metric/1#this> rdfs:comment "Share of opportunities that closed won — contested definition" .
<http://localhost:8890/atlan-cc/claim/1#this> a a:Claim ;
  a:claimKind "definition" ;
  a:subjectRef "metric:1" ;
  a:definitionText "closed_won / all closed opportunities" ;
  a:confidence "0.82"^^xsd:decimal ;
  a:validFrom "2024-01-01"^^xsd:date ;
  a:validTo "2025-06-30"^^xsd:date ;
  a:status "superseded" ;
  a:derivedFrom <http://localhost:8890/atlan-cc/source/1#this> .
<http://localhost:8890/atlan-cc/claim/2#this> a a:Claim ;
  a:claimKind "definition" ;
  a:subjectRef "metric:1" ;
  a:definitionText "closed_won / closed opportunities that reached qualification (exclude never-qualified)" ;
  a:confidence "0.91"^^xsd:decimal ;
  a:validFrom "2025-07-01"^^xsd:date ;
  a:status "approved" ;
  a:derivedFrom <http://localhost:8890/atlan-cc/source/2#this> .
