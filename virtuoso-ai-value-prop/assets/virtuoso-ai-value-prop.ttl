<#ex-nw-sql-alfki-lines> a schema:SoftwareSourceCode ;
    schema:identifier "nw-sql-alfki-lines"@en ;
    schema:name "One customer's order lines (three-table join)"@en ;
    schema:description "The join an RDF View turns into links: customer → order → order line."@en ;
    schema:programmingLanguage "SQL"@en ;
    schema:text "SELECT TOP 5 c.CompanyName, o.OrderID, od.ProductID, od.Quantity, od.UnitPrice FROM Demo.demo.Customers c JOIN Demo.demo.Orders o ON c.CustomerID = o.CustomerID JOIN Demo.demo.\"Order_Details\" od ON o.OrderID = od.OrderID WHERE c.CustomerID = 'ALFKI'"@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-sql-alfki-lines> ;
    schema:exampleOfWork <#cap-sql-xmla> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-nw-spasql-category-sales> a schema:SoftwareSourceCode ;
    schema:identifier "nw-spasql-category-sales"@en ;
    schema:name "Sales by category, SPARQL inside SQL"@en ;
    schema:description "SPASQL: the RDF View is queried in SPARQL and the result is used as a SQL derived table, so SQL tools see ordinary rows."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT categoryName, totalSales, units
FROM (
  SPARQL
  PREFIX nw: <http://demo.openlinksw.com/schemas/Northwind/>
  SELECT ?categoryName
         (ROUND(SUM(?q * ?p * (1 - ?d))) AS ?totalSales)
         (SUM(?q) AS ?units)
  FROM <http://demo.openlinksw.com/Northwind#>
  WHERE {
    ?od a nw:Order_Details ;
        nw:quantity ?q ; nw:unitprice ?p ; nw:discount ?d ;
        nw:has_products ?product .
    ?product nw:has_categories ?cat .
    ?cat nw:categoryname ?categoryName .
  }
  GROUP BY ?categoryName
  ORDER BY DESC(?totalSales)
) AS x"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-spasql-category-sales> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-nw-spasql-stock> a schema:SoftwareSourceCode ;
    schema:identifier "nw-spasql-stock"@en ;
    schema:name "Products in stock, through the RDF View"@en ;
    schema:description "The outer WHERE product IS NOT NULL drops an empty row an RDF View can return under LIMIT."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT product, name, unitsInStock, unitPrice
FROM (
  SPARQL
  PREFIX nw: <http://demo.openlinksw.com/schemas/Northwind/>
  SELECT ?product ?name ?unitsInStock ?unitPrice
  FROM <http://demo.openlinksw.com/Northwind#>
  WHERE {
    ?product a nw:Products ;
             nw:productname ?name ;
             nw:unitsinstock ?unitsInStock ;
             nw:unitprice ?unitPrice .
  }
  ORDER BY DESC(?unitsInStock)
  LIMIT 10
) AS x
WHERE product IS NOT NULL"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-spasql-stock> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-nw-spasql-salesperformance> a schema:SoftwareSourceCode ;
    schema:identifier "nw-spasql-salesperformance"@en ;
    schema:name "The dashboard post's SalesPerformance query"@en ;
    schema:description "The original SPASQL from the dashboard post (abridged here), opened from the post's own short link. That link predates the presets, so the Query Builder may also ask for the user and password: use demo / demo."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT orderDetail, product, productId, categoryId, orderId,
       categoryName, totalSales, numberOfOrders, totalUnits, avgPrice
FROM (
  SPARQL
  SELECT ?orderDetail ?product ?category ?categoryId ?productId ?orderId ?categoryName
         (ROUND(SUM(?quantity * ?unitPrice * (1 - ?discount))) AS ?totalSales)
         (COUNT(DISTINCT ?orderId) AS ?numberOfOrders)
         (SUM(?quantity) AS ?totalUnits)
         (ROUND(AVG(?unitPrice)) AS ?avgPrice)
  FROM <http://demo.openlinksw.com/Northwind#>
  WHERE { … Order_Details, Products and Categories … }
  GROUP BY ?categoryName ?orderDetail ?product ?category ?categoryId ?productId ?orderId
  ORDER BY DESC(?totalSales)
) AS SalesPerformance"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-spasql-salesperformance> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en ;
    schema:subjectOf <https://tinyurl.com/25k2y9pr> .

<#ex-nw-sparql-stock> a schema:SoftwareSourceCode ;
