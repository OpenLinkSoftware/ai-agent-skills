<#ex-nw-sql-customers> a schema:SoftwareSourceCode ;
    schema:identifier "nw-sql-customers"@en ;
    schema:name "Customers, straight from the table"@en ;
    schema:description "Plain SQL against the Northwind customers table, sent to Virtuoso over XMLA by the Query Builder."@en ;
    schema:programmingLanguage "SQL"@en ;
