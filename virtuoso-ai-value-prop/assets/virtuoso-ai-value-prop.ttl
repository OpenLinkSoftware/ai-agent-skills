<#ex-ss-spasql-top-customers> a schema:SoftwareSourceCode ;
    schema:identifier "ss-spasql-top-customers"@en ;
    schema:name "Top customers by sales, SPARQL inside SQL"@en ;
    schema:description "The SQL Server RDF View, aggregated in SPARQL and handed back to SQL as rows."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT company_name, total_quantity, total_sales
FROM (
  SPARQL
  PREFIX ns: <http://demo.openlinksw.com/schemas/northwind-sqlserver/>
  SELECT ?company_name
         (SUM(?quantity) AS ?total_quantity)
         (ROUND(SUM(?quantity * ?unit_price)) AS ?total_sales)
  FROM <http://demo.openlinksw.com/northwind-sqlserver#>
  WHERE {
    ?customer a ns:customers ; ns:companyname ?company_name .
    ?order a ns:orders ; ns:has_customers ?customer ; ns:orderid ?order_id .
    ?order_detail a ns:order_details ; ns:orderid ?order_id ;
                  ns:unitprice ?unit_price ; ns:quantity ?quantity .
  }
  GROUP BY ?company_name
  ORDER BY DESC(?total_sales)
  LIMIT 10
) AS x"""@en ;
    schema:about <#dataset-sqlserver> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=ss-spasql-top-customers> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-ss-sparql-customers> a schema:SoftwareSourceCode ;
    schema:identifier "ss-sparql-customers"@en ;
    schema:name "Customers as entities"@en ;
    schema:description "Each SQL Server customer row, named by a hyperlink such as …/customers/CustomerID/ALFKI#this, the same kind of super-key that rows in native Virtuoso SQL tables and PostgreSQL get."@en ;
