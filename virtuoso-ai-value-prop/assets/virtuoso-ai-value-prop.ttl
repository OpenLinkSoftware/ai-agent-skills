<#capabilities> a schema:DefinedTermSet ;
    schema:name "Capabilities the app demonstrates"@en ;
    schema:hasDefinedTerm <#cap-rdf-views> ,
        <#cap-super-key> ,
        <#cap-sql-xmla> ,
        <#cap-spasql> ,
