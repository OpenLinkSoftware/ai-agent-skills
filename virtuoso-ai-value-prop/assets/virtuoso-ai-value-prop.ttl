<#profile-www> a schema:CreativeWork ;
    schema:name "Instance profile: www.openlinksw.com"@en ;
    schema:identifier "www"@en ;
    schema:hasPart <#profile-www-rdfviews-sparql> ,
        <#profile-www-rdfviews-describe> ,
        <#profile-www-rdfviews-spasqlqb> ,
        <#profile-www-rdfviews-xmla> ,
        <#profile-www-linkeddata-sparql> ,
        <#profile-www-linkeddata-sparqlauth> ,
        <#profile-www-linkeddata-describe> ,
        <#profile-www-opal-agentcard> ,
        <#profile-www-opal-chatui> ,
        <#profile-www-opal-widgetbase> ,
        <#profile-www-facetedbrowser> ;
    schema:isPartOf <#cap-instance-profiles> ;
    rdfs:comment "Selected with ?profile=www on the app URL, or made the default in the app's vap-config block when deploying."@en ;
    schema:creativeWorkStatus "Not deployed yet: no app URL."@en .

<#cap-instance-profiles> a schema:DefinedTerm ;
    schema:hasPart <#profile-uriburner> ,
        <#profile-www> .
