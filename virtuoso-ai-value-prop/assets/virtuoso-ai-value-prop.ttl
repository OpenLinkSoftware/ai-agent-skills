<#ex-db-sql-revenue-by-city> a schema:SoftwareSourceCode ;
    schema:identifier "db-sql-revenue-by-city"@en ;
    schema:name "Revenue by city, in SQL"@en ;
    schema:description "A join and an aggregate over two attached Databricks tables. The SPARQL card \"Revenue by city\" below returns the same numbers through the RDF View."@en ;
    schema:programmingLanguage "SQL"@en ;
    schema:text """SELECT TOP 10 f.city, COUNT(*) AS orders, SUM(t.totalPrice) AS revenue
FROM databricks.bakehouse.sales_transactions t
JOIN databricks.bakehouse.sales_franchises f ON t.franchiseID = f.franchiseID
GROUP BY f.city
ORDER BY 3 DESC"""@en ;
    schema:about <#dataset-databricks> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=db-sql-revenue-by-city> ;
    schema:exampleOfWork <#cap-sql-xmla> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-db-spasql-revenue-by-city> a schema:SoftwareSourceCode ;
    schema:identifier "db-spasql-revenue-by-city"@en ;
    schema:name "Revenue by city, SPARQL inside SQL"@en ;
    schema:description "The Databricks RDF View, aggregated in SPARQL and handed back to SQL as rows."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT city, orders, revenue
FROM (
  SPARQL
  PREFIX : <http://www.databricks.com/bakehouse#>
  SELECT ?city
         (COUNT(DISTINCT ?transaction) AS ?orders)
         (SUM(?totalPrice) AS ?revenue)
  FROM <http://demo.openlinksw.com/databricks-bakehouse-r2rml#>
  WHERE {
    ?transaction a :Transaction ;
                 :franchise ?franchise ;
                 :totalPrice ?totalPrice .
    ?franchise :city ?city .
  }
  GROUP BY ?city
  ORDER BY DESC(?revenue)
  LIMIT 10
) AS x"""@en ;
    schema:about <#dataset-databricks> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=db-spasql-revenue-by-city> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

