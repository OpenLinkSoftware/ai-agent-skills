<#ex-nw-sql-by-country> a schema:SoftwareSourceCode ;
    schema:identifier "nw-sql-by-country"@en ;
    schema:name "Customers by country"@en ;
    schema:description "An aggregate in SQL. The SPARQL examples below reach the same tables through the RDF View."@en ;
    schema:programmingLanguage "SQL"@en ;
    schema:text "SELECT Country, COUNT(*) AS n FROM Demo.demo.Customers GROUP BY Country ORDER BY 2 DESC"@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-sql-by-country> ;
