<#cap-rdf-views> a schema:DefinedTerm ;
    schema:name "RDF Views"@en ;
    schema:description "Quad maps that present the tables of any ODBC- or JDBC-accessible DBMS as RDF without copying them; SPARQL is translated to SQL against the source tables at query time."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-super-key> a schema:DefinedTerm ;
    schema:name "Row hyperlinks as cross-platform super-keys"@en ;
    schema:description "Every row gets its own hyperlink, which works as a cross-platform super-key: a key that keeps its meaning outside its own database and resolves to a description of the row."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-sql-xmla> a schema:DefinedTerm ;
    schema:name "SQL over XMLA"@en ;
    schema:description "SQL sent to Virtuoso over the XML for Analysis SOAP protocol, from a browser, through the SPASQL Query Builder."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-spasql> a schema:DefinedTerm ;
    schema:name "SPASQL"@en ;
    schema:description "SPARQL inside a SQL FROM clause, so the result of a SPARQL query behaves like a derived table in SQL."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-sparql> a schema:DefinedTerm ;
    schema:name "SPARQL over RDF Views"@en ;
    schema:description "SPARQL queries over the same rows that SQL reads, following links instead of foreign-key columns."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-sponger> a schema:DefinedTerm ;
    schema:name "Sponger"@en ;
    schema:description "Virtuoso Linked Data middleware: cartridges read a web resource and store RDF in a named graph whose IRI is the source URL."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-faceted-browse> a schema:DefinedTerm ;
    schema:name "Faceted browsing"@en ;
    schema:description "The explore query lists every type in a named graph with a sample and a count; each type opens in a faceted browser."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-opal-agents> a schema:DefinedTerm ;
    schema:name "OPAL agents loosely coupled with Data Spaces"@en ;
    schema:description "Agents hold instructions and a list of query functions, not a copy of the data; answers come from predefined SQL, SPARQL or SPASQL queries that can be inspected."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-access-control> a schema:DefinedTerm ;
    schema:name "Access control with the data"@en ;
    schema:description "ABAC ACLs on the server decide who may run what: anonymous SPARQL, signed-in SQL and SPASQL, signed-in sponging and query-backed agent answers."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-deep-links> a schema:DefinedTerm ;
    schema:name "Conversation deep links"@en ;
    schema:description "Every example, dataset, agent question and section has a link that opens the app on that exact view, so a conversation can hand over to the app."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-ontology-generation> a schema:DefinedTerm ;
    schema:name "Ontology generation from SQL schemas"@en ;
    schema:description "Generating an RDF View also generates its ontology: a class per table, a typed datatype property per column, an object property per foreign key, each with its own IRI and a label naming the SQL source; the classes are then aligned with shared ontologies (rdfs:subClassOf, owl:equivalentClass) so one query in a shared vocabulary reaches every source."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#cap-instance-profiles> a schema:DefinedTerm ;
    schema:name "Instance profiles"@en ;
    schema:description "The hosts that serve each role (RDF Views data, linked data and Sponger, OPAL, widget, faceted browser, app) are configuration, with URIBurner as the default profile."@en ;
    schema:inDefinedTermSet <#capabilities> .

<#claim-1> a schema:Claim ;
    schema:name "Every row gets a hyperlink"@en ;
    schema:text "Each customer, order and product gets a hyperlink that opens a page describing it, and the link keeps its meaning outside its own database."@en ;
    schema:position "1"^^xsd:integer ;
    schema:about <#cap-super-key> ;
    schema:isBasedOn <#ex-nw-sparql-stock> ,
        <#ex-ss-sparql-customers> .

<#claim-2> a schema:Claim ;
    schema:name "Any ODBC or JDBC database"@en ;
    schema:text "Attach a DBMS over ODBC or JDBC and its tables appear inside Virtuoso, queryable in place."@en ;
    schema:position "2"^^xsd:integer ;
    schema:about <#cap-rdf-views> ;
    schema:isBasedOn <#ex-ss-sql-customers> ,
        <#ex-ss-sql-federated-join> .

<#claim-3> a schema:Claim ;
    schema:name "Nothing is copied"@en ;
    schema:text "SPARQL over an RDF View is translated to SQL and run against the source tables at that moment, so a change in the source shows in the next answer."@en ;
    schema:position "3"^^xsd:integer ;
    schema:about <#cap-rdf-views> ;
    schema:isBasedOn <#ex-ss-sparql-top-customers> ,
        <#ex-csv-sparql-quad-maps> .

<#claim-4> a schema:Claim ;
    schema:name "Three languages, one set of tables"@en ;
    schema:text "The same rows answer SQL over XMLA, SPASQL (SPARQL inside a SQL `FROM`) and SPARQL."@en ;
    schema:position "4"^^xsd:integer ;
    schema:about <#cap-spasql> ;
    schema:isBasedOn <#ex-nw-sql-customers> ,
        <#ex-nw-spasql-category-sales> ,
        <#ex-nw-sparql-category-sales> .

<#claim-5> a schema:Claim ;
    schema:name "Joins by reference across systems"@en ;
    schema:text "One SQL statement joins customers in SQL Server, orders in MySQL and employees in Virtuoso."@en ;
    schema:position "5"^^xsd:integer ;
    schema:about <#cap-sql-xmla> ;
    schema:isBasedOn <#ex-ss-sql-federated-join> .

<#claim-6> a schema:Claim ;
    schema:name "Web pages become graphs"@en ;
    schema:text "The Sponger reads a page or feed and stores a graph named by its URL, with entities linked to DBpedia."@en ;
    schema:position "6"^^xsd:integer ;
    schema:about <#cap-sponger> ;
    schema:isBasedOn <#ex-tm-headlines> ,
        <#ex-tm-entities> ,
        <#ex-gh-ai-agent-skills-types> .

<#claim-7> a schema:Claim ;
    schema:name "See before you query"@en ;
    schema:text "The explore query lists every type in a dataset with a sample and a count, and each type opens in a faceted browser."@en ;
    schema:position "7"^^xsd:integer ;
    schema:about <#cap-faceted-browse> ;
    schema:isBasedOn <#explore-northwind> ,
        <#explore-csv> .

<#claim-8> a schema:Claim ;
    schema:name "Agents answer from queries"@en ;
    schema:text "An OPAL agent answers by running a predefined SQL, SPARQL or SPASQL query you can inspect, so a number can be traced to its source."@en ;
    schema:position "8"^^xsd:integer ;
    schema:about <#cap-opal-agents> ;
    schema:isBasedOn <#agent-virtuoso-support> ,
        <#agent-data-twingler> .

<#claim-9> a schema:Claim ;
    schema:name "Loose coupling"@en ;
    schema:text "Agents hold instructions and a list of query functions, not a copy of the data, so the model, the agent or the Data Space can change independently."@en ;
    schema:position "9"^^xsd:integer ;
    schema:about <#cap-opal-agents> ;
    schema:isBasedOn <#section-how-opal-answers> .

<#claim-10> a schema:Claim ;
    schema:name "Access stays with the data"@en ;
    schema:text "ABAC ACLs on the server decide who may run what: anonymous SPARQL, signed-in SQL and SPASQL, signed-in sponging."@en ;
    schema:position "10"^^xsd:integer ;
    schema:about <#cap-access-control> ;
    schema:isBasedOn <#section-access-control> .

<#claim-11> a schema:Claim ;
    schema:name "Ontologies are generated, then shared"@en ;
    schema:text "Generating an RDF View also generates its ontology (a class per table, a typed property per column, a link per foreign key); aligned with FOAF, schema.org or DBpedia, it lets one question reach every source."@en ;
    schema:position "11"^^xsd:integer ;
    schema:about <#cap-ontology-generation> ;
    schema:isBasedOn <#ex-onto-nw-classes> ,
        <#ex-onto-shared-alignments> ,
        <#ex-onto-cross-source-people> .

