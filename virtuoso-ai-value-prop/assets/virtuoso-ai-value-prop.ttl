<#profile-uriburner-rdfviews-sparql> a schema:EntryPoint ;
    schema:name "RDF Views SPARQL endpoint"@en ;
    schema:urlTemplate "https://demo.openlinksw.com/sparql"@en .

<#profile-uriburner-rdfviews-describe> a schema:EntryPoint ;
    schema:name "RDF View entity description (uri and graph)"@en ;
    schema:urlTemplate "https://demo.openlinksw.com/describe/?uri={iri}&graph={graph}"@en .

<#profile-uriburner-rdfviews-spasqlqb> a schema:EntryPoint ;
    schema:name "SPASQL Query Builder (SQL over XMLA and SPASQL)"@en ;
    schema:urlTemplate "https://demo.openlinksw.com/spasqlqb/?permlink_e="@en .

<#profile-uriburner-rdfviews-xmla> a schema:EntryPoint ;
    schema:name "XMLA endpoint"@en ;
    schema:urlTemplate "https://demo.openlinksw.com/XMLA"@en .

<#profile-uriburner-linkeddata-sparql> a schema:EntryPoint ;
    schema:name "Linked-data and Sponger SPARQL endpoint"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/sparql"@en .

<#profile-uriburner-linkeddata-sparqlauth> a schema:EntryPoint ;
    schema:name "Signed-in SPARQL endpoint (sponging)"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/sparql-auth/"@en .

<#profile-uriburner-linkeddata-describe> a schema:EntryPoint ;
    schema:name "Linked-data entity description"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/describe/?url={iri}"@en .

<#profile-uriburner-opal-agentcard> a schema:EntryPoint ;
    schema:name "OPAL A2A Agent Card"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/.well-known/agent.json"@en .

<#profile-uriburner-opal-chatui> a schema:EntryPoint ;
    schema:name "OPAL chat UI"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/chat/"@en .

<#profile-uriburner-opal-widgetbase> a schema:EntryPoint ;
    schema:name "OPAL widget scripts"@en ;
    schema:urlTemplate "https://virtuoso.openlinksw.com/opal-widget"@en .

<#profile-uriburner-facetedbrowser> a schema:EntryPoint ;
    schema:name "SPARQL Faceted Browser app"@en ;
    schema:urlTemplate "https://linkeddata.uriburner.com/DAV/demos/daas/sparql-faceted-browser-claude_opus_5_5.html#s={state}"@en .

<#profile-uriburner> a schema:CreativeWork ;
    schema:name "Instance profile: URIBurner (default)"@en ;
    schema:identifier "uriburner"@en ;
    schema:url <https://linkeddata.uriburner.com/DAV/demos/daas/virtuoso-ai-value-prop.html> ;
    schema:hasPart <#profile-uriburner-rdfviews-sparql> ,
        <#profile-uriburner-rdfviews-describe> ,
        <#profile-uriburner-rdfviews-spasqlqb> ,
        <#profile-uriburner-rdfviews-xmla> ,
        <#profile-uriburner-linkeddata-sparql> ,
        <#profile-uriburner-linkeddata-sparqlauth> ,
        <#profile-uriburner-linkeddata-describe> ,
        <#profile-uriburner-opal-agentcard> ,
        <#profile-uriburner-opal-chatui> ,
        <#profile-uriburner-opal-widgetbase> ,
        <#profile-uriburner-facetedbrowser> ;
    schema:isPartOf <#cap-instance-profiles> ;
    rdfs:comment "Default profile."@en .

