ORDER BY DESC(?n)"""@en ;
    schema:about <#dataset-databricks> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=db-sparql-entity-types&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-db-sparql-revenue-by-city> a schema:SoftwareSourceCode ;
    schema:identifier "db-sparql-revenue-by-city"@en ;
    schema:name "Revenue by city"@en ;
    schema:description "The post's query, scoped to the RDF View's graph on demo.openlinksw.com. Transactions reach their city by following the franchise link, not a foreign-key column."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX : <http://www.databricks.com/bakehouse#>
SELECT ?city
       (COUNT(DISTINCT ?transaction) AS ?orders)
       (SUM(?totalPrice) AS ?revenue)
FROM <http://demo.openlinksw.com/databricks-bakehouse-r2rml#>
WHERE {
  ?transaction a :Transaction ;
               :franchise ?franchise ;
               :totalPrice ?totalPrice .
  ?franchise :city ?city .
}
GROUP BY ?city
ORDER BY DESC(?revenue)
LIMIT 10"""@en ;
    schema:about <#dataset-databricks> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=db-sparql-revenue-by-city&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-db-sparql-top-customers> a schema:SoftwareSourceCode ;
    schema:identifier "db-sparql-top-customers"@en ;
    schema:name "Top customers by lifetime value"@en ;
    schema:description "Each Databricks customer row is named by a hyperlink such as …/bakehouse/customer-2000112#this, a super-key you can click."@en ;
