    schema:text """PREFIX ns: <http://demo.openlinksw.com/schemas/northwind-sqlserver/>
SELECT ?customer ?customer_id ?company_name
FROM <http://demo.openlinksw.com/northwind-sqlserver#>
WHERE {
  ?customer a ns:customers ;
            ns:customerid ?customer_id ;
            ns:companyname ?company_name .
}
ORDER BY ?customer_id
LIMIT 10"""@en ;
