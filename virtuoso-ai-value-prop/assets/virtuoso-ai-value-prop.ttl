<#ex-ss-sql-federated-join> a schema:SoftwareSourceCode ;
    schema:identifier "ss-sql-federated-join"@en ;
    schema:name "Federated join: SQL Server + MySQL + Virtuoso"@en ;
    schema:description "From the Decisive Knowledge post: customers in SQL Server, orders in MySQL and employees in Virtuoso, joined in one SQL statement. The button opens it with the demo account preset; the post's original link is beside it."@en ;
    schema:programmingLanguage "SQL"@en ;
    schema:text """SELECT 
    A.CustomerID, 
    A.CompanyName,
    B.OrderID, 
    C.EmployeeID, 
    C.LastName, 
    C.FirstName 
FROM 
    "sqlserver"."northwind"."customers" A 
NATURAL JOIN 
    "mysql5"."northwind"."orders" B 
NATURAL JOIN    
    "Demo"."demo"."employees" C"""@en ;
    schema:about <#dataset-sqlserver> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=ss-sql-federated-join> ;
    schema:exampleOfWork <#cap-sql-xmla> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

