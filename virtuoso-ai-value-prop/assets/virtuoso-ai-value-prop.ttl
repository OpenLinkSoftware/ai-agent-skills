<#ex-sk-sql-snowflake-tables> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sql-snowflake-tables"@en ;
    schema:name "Warehouse tables from the Snowflake source"@en ;
    schema:description "Plain SQL over two of the estate's tables: the warehouse tables whose source is Snowflake, largest first."@en ;
    schema:programmingLanguage "SQL"@en ;
    schema:text """SELECT ws.src_name, wt.table_name, wt.row_count
FROM ScaleKG.kidehen.warehouse_table wt
JOIN ScaleKG.kidehen.warehouse_source ws ON ws.src_id = wt.src_id
WHERE ws.src_name = 'Snowflake'
ORDER BY wt.row_count DESC"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sql-snowflake-tables> ;
    schema:exampleOfWork <#cap-sql-xmla> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-sk-spasql-db-limit> a schema:SoftwareSourceCode ;
    schema:identifier "sk-spasql-db-limit"@en ;
    schema:name "The article's databases-per-GB rule, as SQL over SPARQL"@en ;
    schema:description "From the post: SPARQL counts databases per cluster and passes each cluster's hyperlink through as a column; SQL then applies the article's rule of 5 databases per GB of RAM, capped at 100 in preview and 250 at general availability."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT c, cluster_name, ram_gb, dbs,
       ram_gb * 5 AS by_ram,
       CASE WHEN ram_gb * 5 > 100 THEN 100 ELSE ram_gb * 5 END - dbs AS headroom_preview,
       CASE WHEN ram_gb * 5 > 250 THEN 250 ELSE ram_gb * 5 END - dbs AS headroom_ga
FROM (SPARQL
  PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
  PREFIX schema: <http://schema.org/>
  SELECT ?c ?cluster_name ?ram_gb (COUNT(?db) AS ?dbs)
  FROM <http://demo.openlinksw.com/ScaleKG#>
  WHERE {
    ?c a skg:Cluster ; schema:name ?cluster_name ; skg:ramGb ?ram_gb .
    OPTIONAL { ?db skg:hostedOn ?c }
  }
  GROUP BY ?c ?cluster_name ?ram_gb
) AS x
ORDER BY dbs DESC"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-spasql-db-limit> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-sk-spasql-billed-seconds> a schema:SoftwareSourceCode ;
    schema:identifier "sk-spasql-billed-seconds"@en ;
    schema:name "Graph walk joined to a native SQL table"@en ;
    schema:description "From the post: SPARQL walks tenant → owned database in the RDF View, and SQL joins those rows to the analytics_job table to sum billed seconds per tenant, keeping each tenant's hyperlink beside its name."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT t.tenant_iri, t.tenant, COUNT(*) AS jobs, SUM(j.billed_seconds) AS billed_seconds
FROM (SPARQL
  PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
  PREFIX schema: <http://schema.org/>
  SELECT ?tenant_iri ?tenant ?db_name
  FROM <http://demo.openlinksw.com/ScaleKG#>
  WHERE {
    ?tenant_iri a skg:Tenant ; schema:name ?tenant .
    ?db skg:ownedBy ?tenant_iri ; schema:name ?db_name .
  }
) AS t
JOIN ScaleKG.kidehen.graph_database d ON d.db_name = t.db_name
JOIN ScaleKG.kidehen.analytics_job j ON j.db_id = d.db_id
GROUP BY t.tenant_iri, t.tenant
ORDER BY billed_seconds DESC"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-spasql-billed-seconds> ;
    schema:exampleOfWork <#cap-spasql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Runs in the SPASQL Query Builder on demo.openlinksw.com after sign-in: user name demo, password demo (or vdb / vdb); the instance is protected by ABAC ACLs."@en .

<#ex-sk-sparql-three-hops> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sparql-three-hops"@en ;
    schema:name "Three hops from tenant to warehouse table"@en ;
    schema:description "Tenant → workload → warehouse table → source, followed as links. The Snowflake tables show up with the workloads that read them."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
PREFIX schema: <http://schema.org/>
SELECT ?tenantIri ?tenant ?workloadIri ?workload ?tableIri ?tableName ?source
FROM <http://demo.openlinksw.com/ScaleKG#>
WHERE {
  ?tenantIri a skg:Tenant ; schema:name ?tenant .
  ?workloadIri skg:forTenant ?tenantIri ; schema:name ?workload ; skg:readsFrom ?tableIri .
  ?tableIri schema:name ?tableName ; skg:inSource ?sourceIri .
  ?sourceIri schema:name ?source .
}
ORDER BY ?tenant ?workload ?tableName"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sparql-three-hops&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-sk-sparql-dbs-per-cluster> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sparql-dbs-per-cluster"@en ;
    schema:name "Databases per cluster"@en ;
    schema:description "The graph side of the per-GB rule: each cluster, its RAM and how many databases it hosts."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
PREFIX schema: <http://schema.org/>
SELECT ?clusterIri ?cluster ?ramGb (COUNT(?db) AS ?databases)
FROM <http://demo.openlinksw.com/ScaleKG#>
WHERE {
  ?clusterIri a skg:Cluster ; schema:name ?cluster ; skg:ramGb ?ramGb .
  OPTIONAL { ?db skg:hostedOn ?clusterIri }
}
GROUP BY ?clusterIri ?cluster ?ramGb
ORDER BY DESC(?databases)"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sparql-dbs-per-cluster&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-sk-sparql-replication> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sparql-replication"@en ;
    schema:name "Replication topology and the access-control gap"@en ;
    schema:description "Each replication link with its source and target regions, sync mode and whether access-control settings travel with the data."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
PREFIX schema: <http://schema.org/>
SELECT ?linkIri ?sourceDb ?fromRegion ?targetDb ?toRegion ?syncMode ?rbacReplicated
FROM <http://demo.openlinksw.com/ScaleKG#>
WHERE {
  ?linkIri a skg:ReplicationLink ;
           skg:replicatesFrom ?sourceIri ; skg:replicatesTo ?targetIri ;
           skg:syncMode ?syncMode ; skg:rbacReplicated ?rbacReplicated .
  ?sourceIri schema:name ?sourceDb ; skg:hostedOn/skg:inRegion/schema:name ?fromRegion .
  ?targetIri schema:name ?targetDb ; skg:hostedOn/skg:inRegion/schema:name ?toRegion .
}
ORDER BY ?sourceDb"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sparql-replication&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-sk-sparql-entailment> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sparql-entailment"@en ;
    schema:name "Entailment: what is a data asset?"@en ;
    schema:description "With the ScaleKG inference rules on, graph databases and warehouse tables both answer as skg:DataAsset, a class no table declares."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """DEFINE input:inference "urn:scalekg:inference"
PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?kindIri ?kind (COUNT(DISTINCT ?assetIri) AS ?assets)
FROM <http://demo.openlinksw.com/ScaleKG#>
FROM <http://demo.openlinksw.com/schemas/ScaleKG/>
WHERE {
  ?assetIri a skg:DataAsset ; a ?kindIri .
  ?kindIri rdfs:label ?kind .
  FILTER(?kindIri IN (skg:DataAsset, skg:GraphDatabase, skg:WarehouseTable))
}
GROUP BY ?kindIri ?kind
ORDER BY DESC(?assets)"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sparql-entailment&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-sk-sparql-property-hierarchy> a schema:SoftwareSourceCode ;
    schema:identifier "sk-sparql-property-hierarchy"@en ;
    schema:name "The property hierarchy, read from the TBox"@en ;
    schema:description "Joins the ontology graph to find every property declared a sub-property of skg:dependsOn and follows it from each workload."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX skg: <http://demo.openlinksw.com/schemas/ScaleKG/>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?workloadIri ?workload ?relation ?dependencyIri ?dependency
FROM <http://demo.openlinksw.com/ScaleKG#>
FROM <http://demo.openlinksw.com/schemas/ScaleKG/>
WHERE {
  ?workloadIri a skg:Workload ; schema:name ?workload ; ?relationIri ?dependencyIri .
  ?relationIri rdfs:subPropertyOf skg:dependsOn ; rdfs:label ?relation .
  ?dependencyIri schema:name ?dependency .
}"""@en ;
    schema:about <#dataset-snowflake> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=sk-sparql-property-hierarchy&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-csv-sparql-customers> a schema:SoftwareSourceCode ;
    schema:identifier "csv-sparql-customers"@en ;
    schema:name "Customers from CSV files"@en ;
    schema:description "The same RDF View technique over flat files."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX nw: <http://demo.openlinksw.com/schemas/csv_northwind/>
SELECT ?org ?id ?name ?city ?country
FROM <urn:demo.csv:northwind:data>
WHERE {
  ?org a nw:customers ;
       nw:customerid ?id ;
       nw:companyname ?name ;
       nw:city ?city ;
       nw:country ?country .
}
LIMIT 10"""@en ;
    schema:about <#dataset-csv> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=csv-sparql-customers&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-csv-sparql-quad-maps> a schema:SoftwareSourceCode ;
    schema:identifier "csv-sparql-quad-maps"@en ;
    schema:name "Which SQL table feeds which predicate"@en ;
    schema:description "RDF Views describe themselves: the quad maps are queryable, so you can see the SQL table behind each predicate."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX virtrdf: <http://www.openlinksw.com/schemas/virtrdf#>
SELECT DISTINCT ?s1 AS ?quadMap ?s3 AS ?rdfPredicate ?s2 AS ?sqlTable
WHERE {
  ?s1 a virtrdf:QuadMap .
  ?s1 virtrdf:qmTableName ?s2 .
  ?s1 virtrdf:qmPredicateRange-rvrFixedValue ?s3 .
  FILTER (! contains(str(?s2), "/csv"))
  FILTER (! contains(str(?s2), 'csv.'))
  FILTER (contains(str(?s2), "supplier"))
}
LIMIT 200"""@en ;
    schema:about <#dataset-csv> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=csv-sparql-quad-maps&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-nw-classes> a schema:SoftwareSourceCode ;
    schema:identifier "onto-nw-classes"@en ;
    schema:name "Classes generated from the Northwind tables"@en ;
    schema:description "Every table became a class, labelled with the table it came from, with a property for each column."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT ?class ?sqlTable (COUNT(DISTINCT ?property) AS ?properties)
WHERE {
  ?class a ?kind ;
         rdfs:label ?sqlTable .
  FILTER(?kind IN (owl:Class, rdfs:Class))
  OPTIONAL { ?property rdfs:domain ?class }
  FILTER(STRSTARTS(STR(?class), "http://demo.openlinksw.com/schemas/Northwind/"))
}
GROUP BY ?class ?sqlTable
ORDER BY ?class"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-nw-classes&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-nw-products-properties> a schema:SoftwareSourceCode ;
    schema:identifier "onto-nw-products-properties"@en ;
    schema:name "Columns become typed properties, foreign keys become links"@en ;
    schema:description "The generated Products class: datatype properties typed from the SQL columns, and object properties for its foreign keys to Categories and Suppliers."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT ?property ?column ?kind ?range
WHERE {
  ?property rdfs:domain <http://demo.openlinksw.com/schemas/Northwind/Products> ;
            a ?kind .
  FILTER(?kind IN (owl:DatatypeProperty, owl:ObjectProperty))
  OPTIONAL { ?property rdfs:label ?column }
  OPTIONAL { ?property rdfs:range ?range }
}
ORDER BY ?kind ?property"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-nw-products-properties&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-ss-classes> a schema:SoftwareSourceCode ;
    schema:identifier "onto-ss-classes"@en ;
    schema:name "The same, generated from SQL Server"@en ;
    schema:description "The SQL Server Northwind tables, attached over ODBC, generated their own classes, labelled sqlserver.northwind.*."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT DISTINCT ?class ?sqlTable
WHERE {
  ?class a ?kind ;
         rdfs:label ?sqlTable .
  FILTER(?kind IN (owl:Class, rdfs:Class))
  FILTER(STRSTARTS(STR(?class), "http://demo.openlinksw.com/schemas/northwind-sqlserver/"))
  FILTER(CONTAINS(?sqlTable, "."))
}
ORDER BY ?class"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-ss-classes&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-shared-alignments> a schema:SoftwareSourceCode ;
    schema:identifier "onto-shared-alignments"@en ;
    schema:name "Generated classes aligned with shared ontologies"@en ;
    schema:description "Across the ontologies on the server, locally minted classes are declared subclasses of shared ones from DBpedia, schema.org, FOAF and others."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT DISTINCT ?generatedClass ?sharedClass
WHERE {
  ?generatedClass rdfs:subClassOf ?sharedClass .
  FILTER(STRSTARTS(STR(?generatedClass), "http://demo.openlinksw.com/schemas/"))
  FILTER(!STRSTARTS(STR(?sharedClass), "http://demo.openlinksw.com/"))
}
ORDER BY ?sharedClass ?generatedClass
LIMIT 25"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-shared-alignments&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-foaf-employees> a schema:SoftwareSourceCode ;
    schema:identifier "onto-foaf-employees"@en ;
    schema:name "Ask in a shared vocabulary"@en ;
    schema:description "A question in FOAF terms (foaf:Person) answered by the Northwind employees table, with names from the generated properties."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX nw: <http://demo.openlinksw.com/schemas/Northwind/>
SELECT ?person ?firstName ?lastName ?title
FROM <http://demo.openlinksw.com/Northwind#>
WHERE {
  ?person a foaf:Person ;
          nw:firstname ?firstName ;
          nw:lastname ?lastName ;
          nw:title ?title .
}
ORDER BY ?lastName"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-foaf-employees&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-onto-cross-source-people> a schema:SoftwareSourceCode ;
    schema:identifier "onto-cross-source-people"@en ;
    schema:name "One shared class, two different sources"@en ;
    schema:description "People from CSV files and from Virtuoso SQL tables in one answer: the query follows each generated class up to foaf:Person."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT ?source ?generatedClass (COUNT(DISTINCT ?person) AS ?people) (SAMPLE(?person) AS ?example)
WHERE {
  ?generatedClass rdfs:subClassOf foaf:Person .
  { GRAPH <urn:demo.csv:northwind:data> { ?person a ?generatedClass } BIND("CSV files" AS ?source) }
  UNION
  { GRAPH <http://demo.openlinksw.com/Northwind#> { ?person a ?generatedClass } BIND("Virtuoso SQL tables (Demo.demo)" AS ?source) }
}
GROUP BY ?source ?generatedClass
ORDER BY ?source"""@en ;
    schema:about <#dataset-ontology> ;
    schema:url <virtuoso-ai-value-prop.html#/ontologies?ex=onto-cross-source-people&run=1> ;
    schema:exampleOfWork <#cap-ontology-generation> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-tm-headlines> a schema:SoftwareSourceCode ;
    schema:identifier "tm-headlines"@en ;
    schema:name "Latest Techmeme headlines"@en ;
    schema:description "The Sponger reads the RSS feed and turns each story into a schema:DataFeedItem with a title, publication time and links. This is the pattern the opml-rss-reader skill and the OPML and RSS News Reader agent query."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX schema: <http://schema.org/>
SELECT ?published ?title ?link
FROM <https://www.techmeme.com/feed.xml>
WHERE {
  ?item a schema:DataFeedItem ;
        schema:title ?title ;
        schema:datePublished ?published ;
        schema:seeAlso ?link .
}
ORDER BY DESC(?published)
LIMIT 15"""@en ;
    schema:about <#dataset-techmeme> ;
    schema:url <virtuoso-ai-value-prop.html#/sponger?ex=tm-headlines&run=1> ;
    schema:exampleOfWork <#cap-sponger> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Reads the graph the Sponger already holds anonymously; refreshing it (DEFINE get:soft \"replace\") needs a signed-in session on the linked-data host."@en .

<#ex-tm-entities> a schema:SoftwareSourceCode ;
    schema:identifier "tm-entities"@en ;
    schema:name "Entities in the news, linked to DBpedia"@en ;
    schema:description "Its entity extraction finds the companies, products and publications the headlines mention, links each to DBpedia with owl:sameAs, and scores how relevant it is. Click an entity to see its description."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX attr: <http://www.openlinksw.com/schema/attribution#>
PREFIX oplbase: <http://www.openlinksw.com/schemas/oplbase#>
SELECT ?label (SAMPLE(?dbpedia) AS ?entity) (MAX(?score) AS ?relevance)
FROM <https://www.techmeme.com/feed.xml>
WHERE {
  ?e a attr:NamedEntity ;
     rdfs:label ?label ;
     owl:sameAs ?dbpedia ;
     oplbase:hasRelevanceScore ?score .
  FILTER(STRSTARTS(STR(?dbpedia), "http://dbpedia.org/resource/"))
}
GROUP BY ?label
ORDER BY DESC(?relevance)
LIMIT 15"""@en ;
    schema:about <#dataset-techmeme> ;
    schema:url <virtuoso-ai-value-prop.html#/sponger?ex=tm-entities&run=1> ;
    schema:exampleOfWork <#cap-sponger> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Reads the graph the Sponger already holds anonymously; refreshing it (DEFINE get:soft \"replace\") needs a signed-in session on the linked-data host."@en .

<#ex-tm-companies-people> a schema:SoftwareSourceCode ;
    schema:identifier "tm-companies-people"@en ;
    schema:name "Companies and people, with background"@en ;
    schema:description "The extracted entities carry DBpedia types and abstracts, so the feed can be filtered by kind of thing. Here: companies and people."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX bibo: <http://purl.org/ontology/bibo/>
SELECT ?type ?label (SAMPLE(?dbpedia) AS ?entity) (SAMPLE(?abstract) AS ?about)
FROM <https://www.techmeme.com/feed.xml>
WHERE {
  VALUES ?type { dbo:Company dbo:Person }
  ?e a ?type ;
     rdfs:label ?label ;
     owl:sameAs ?dbpedia .
  OPTIONAL { ?e bibo:abstract ?abstract }
  FILTER(STRSTARTS(STR(?dbpedia), "http://dbpedia.org/resource/"))
}
GROUP BY ?type ?label
ORDER BY ?type ?label"""@en ;
    schema:about <#dataset-techmeme> ;
    schema:url <virtuoso-ai-value-prop.html#/sponger?ex=tm-companies-people&run=1> ;
    schema:exampleOfWork <#cap-sponger> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Reads the graph the Sponger already holds anonymously; refreshing it (DEFINE get:soft \"replace\") needs a signed-in session on the linked-data host."@en .

<#ex-tm-type-profile> a schema:SoftwareSourceCode ;
    schema:identifier "tm-type-profile"@en ;
    schema:name "The whole graph, profiled by type"@en ;
    schema:description "Data Twingler template T2: a sample entity and a count for every type in the graph. A good first query for anything the Sponger has read."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT (SAMPLE(?s) AS ?EntityID) (COUNT(*) AS ?count) (?o AS ?EntityTypeID)
WHERE { GRAPH <https://www.techmeme.com/feed.xml> { ?s a ?o } }
GROUP BY ?o
ORDER BY DESC(?count)
LIMIT 15"""@en ;
    schema:about <#dataset-techmeme> ;
    schema:url <virtuoso-ai-value-prop.html#/sponger?ex=tm-type-profile&run=1> ;
    schema:exampleOfWork <#cap-sponger> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Reads the graph the Sponger already holds anonymously; refreshing it (DEFINE get:soft \"replace\") needs a signed-in session on the linked-data host."@en .

<#ex-gh-ai-agent-skills-types> a schema:SoftwareSourceCode ;
    schema:identifier "gh-ai-agent-skills-types"@en ;
    schema:name "GitHub: the ai-agent-skills repository"@en ;
    schema:description "The Sponger reads a GitHub repository page into a graph named by the repository URL: page metadata, extracted entities and annotations, and provenance for the load. The query below reads what is already there; Re-sponge sends the full query, which starts with DEFINE get:soft \"replace\" so the repository page is fetched again first."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT DISTINCT (?o AS ?EntityType) (SAMPLE(?s) AS ?sampleEntity) (COUNT (*) AS ?EntityCount)
FROM <https://github.com/OpenLinkSoftware/ai-agent-skills>
WHERE {
        ?s a ?o.
}
GROUP BY ?o
ORDER BY DESC (?EntityCount)"""@en ;
    schema:about <#dataset-github> ;
    schema:url <virtuoso-ai-value-prop.html#/sponger?ex=gh-ai-agent-skills-types&run=1> ;
    schema:exampleOfWork <#cap-sponger> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> ;
    schema:conditionsOfAccess "Reads the graph the Sponger already holds anonymously; refreshing it (DEFINE get:soft \"replace\") needs a signed-in session on the linked-data host."@en .

<#explore-northwind> a schema:SoftwareSourceCode ;
    schema:identifier "explore-northwind"@en ;
    schema:name "Explore: Virtuoso Northwind (RDF View over Demo.demo)"@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT ?type (SAMPLE(?s) AS ?sampleEntity) (SAMPLE(?label) AS ?sampleLabel) (COUNT(?s) AS ?entityCount)
WHERE {
  GRAPH <http://demo.openlinksw.com/Northwind#> {
    ?s rdf:type ?type .
    OPTIONAL { ?s rdfs:label ?label }
  }
}
GROUP BY ?type
ORDER BY DESC(?entityCount)"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/explore?ds=northwind> ;
    schema:exampleOfWork <#cap-faceted-browse> .

