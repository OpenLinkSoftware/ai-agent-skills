<#ex-nw-sparql-category-sales> a schema:SoftwareSourceCode ;
    schema:identifier "nw-sparql-category-sales"@en ;
    schema:name "Sales by category"@en ;
    schema:description "Joins order lines to products to categories by following links, not foreign-key columns."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """PREFIX nw: <http://demo.openlinksw.com/schemas/Northwind/>
SELECT ?categoryName
       (ROUND(SUM(?q * ?p * (1 - ?d))) AS ?totalSales)
       (SUM(?q) AS ?units)
FROM <http://demo.openlinksw.com/Northwind#>
WHERE {
  ?od a nw:Order_Details ;
      nw:quantity ?q ; nw:unitprice ?p ; nw:discount ?d ;
      nw:has_products ?product .
  ?product nw:has_categories ?cat .
  ?cat nw:categoryname ?categoryName .
}
GROUP BY ?categoryName
ORDER BY DESC(?totalSales)"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-sparql-category-sales&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

<#ex-nw-sparql-entity-types> a schema:SoftwareSourceCode ;
    schema:identifier "nw-sparql-entity-types"@en ;
    schema:name "Entity types in the Demo.demo RDF View"@en ;
    schema:description "From the Entity Type & Sample Entities post: 8 types, with a sample of each. This is the shape of the Data Twingler T2 exploration template."@en ;
    schema:programmingLanguage "SPARQL"@en ;
    schema:text """SELECT ?entityType (SAMPLE(?entity) AS ?sampleEntity) (COUNT(DISTINCT ?entity) AS ?entityCount)
WHERE { GRAPH <http://demo.openlinksw.com/demo#> { ?entity rdf:type ?entityType ; ?predicate ?obj . } }
GROUP BY ?entityType ORDER BY DESC(?entityCount)"""@en ;
    schema:about <#dataset-northwind> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=nw-sparql-entity-types&run=1> ;
    schema:exampleOfWork <#cap-sparql> ;
    schema:targetProduct <http://dbpedia.org/resource/Virtuoso_Universal_Server> .

