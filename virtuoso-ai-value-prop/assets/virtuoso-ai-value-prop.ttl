<#ex-pg-spasql-entity-types> a schema:SoftwareSourceCode ;
    schema:identifier "pg-spasql-entity-types"@en ;
    schema:name "Entity types, SPARQL inside SQL"@en ;
    schema:description "The PostgreSQL RDF View profiled by type and returned to SQL as rows."@en ;
    schema:programmingLanguage "SPASQL"@en ;
    schema:text """SELECT type, n
FROM (
  SPARQL
  SELECT ?type (COUNT(?s) AS ?n)
  FROM <http://demo.openlinksw.com/postgres_postgres_jdbc_mt_codex_20260403#>
  WHERE { ?s a ?type }
  GROUP BY ?type
  ORDER BY DESC(?n)
) AS x"""@en ;
    schema:about <#dataset-postgres> ;
    schema:url <virtuoso-ai-value-prop.html#/rdf-views?ex=pg-spasql-entity-types> ;
