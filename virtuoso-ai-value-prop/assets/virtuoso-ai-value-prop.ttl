               :customer ?customer ;
               :totalPrice ?totalPrice .
  ?customer :firstName ?firstName ;
            :lastName ?lastName .
}
GROUP BY ?customer ?firstName ?lastName
ORDER BY DESC(?lifetimeValue)
LIMIT 10"""@en ;
    schema:about <#dataset-databricks> ;
